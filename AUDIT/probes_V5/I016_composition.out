   130	class PaperLoop:
   131	    """The CP-7 composition root: everything bound to ONE event loop."""
   132
   133	    def __init__(self, store, tmp_path: Path, *, drift: float = 0.0,
   134	                 fill_mode: str = "immediate", lose_ack: int = 0,
   135	                 with_adapter: bool = True) -> None:
   136	        self.store = store
   137	        self.tmp_path = tmp_path
   138	        self.drift = drift
   139	        self.fill_mode = fill_mode
   140	        self.lose_ack = lose_ack
   141	        self.with_adapter = with_adapter
   142	        self.clock = C.FixtureClock(START)
   143	        self.events: List[Any] = []
   144	        self.alerts: List[Dict[str, Any]] = []
   145	        self.telegram = FakeTelegram()
   146	        self.calls: List[Dict[str, Any]] = []
   147	        self.executed: List[Dict[str, Any]] = []
   148	        self.refusals: List[Dict[str, Any]] = []
   149	        self.bus: Optional[EventBus] = None
   150	        self.ledger: Optional[LS.LedgerWriter] = None
   151	        self.adapter: Optional[ToobitAdapter] = None
   152	        self.responder = None
   153	        self.signaling: Optional[SG.SignalingPlane] = None
   154	        self.control: Optional[CP.ControlPlane] = None
   155	        self.scheduler: Optional[C.Scheduler] = None
   156	        self.boot_verdict: Dict[str, Any] = {}
   157	        self.paused = False
   158
   159	    # -- wiring -------------------------------------------------------------
   160	    async def start(self) -> "PaperLoop":
   161	        from fake_toobit_responder import FakeToobitResponder
   162
   163	        self.ledger = LS.LedgerWriter(self.store, clock=_LedgerClock(START))
   164	        await self.ledger.initialize()
   165	        await self.ledger.start()
   166
   167	        if self.with_adapter:
   168	            self.responder = FakeToobitResponder(
   169	                api_key=TEST_KEY, api_secret=TEST_SECRET,
   170	                server_time_ms=self.clock.now_ms(), balance="10000",
   171	                clock=self.clock.monotonic)
   172	            if self.fill_mode != "none":
   173	                self.responder.set_fill_mode(self.fill_mode)
   174	            if self.lose_ack:
   175	                self.responder.lose_next_ack(self.lose_ack)
   176	            self.adapter = ToobitAdapter(config=Config(),
   177	                                         transport=self.responder,
   178	                                         utc_now=self.clock.utc_now,
   179	                                         clock=self.clock.monotonic)
   180
   181	        self.bus = EventBus()
   182	        self.bus.subscribe("execution.fsm.transition", self._on_event)
   183	        self.bus.subscribe("execution.boot", self._on_event)
   184	        self.bus.subscribe("scheduler.cell", self._on_event)
   185	        self.bus.subscribe("telegram.message", self._on_event)
   186	        self._bus_task = self.bus.start()
   187
   188	        self.signaling = SG.SignalingPlane(transport=self.telegram,
   189	                                           clock=self.clock.monotonic,
   190	                                           utc_now=self.clock.utc_now,
   191	                                           ledger=self.ledger, bus=self.bus,
   192	                                           owner_chat_id=OWNER,
   193	                                           watchdog_chat_id=WATCHDOG)
   194	        self.control = CP.ControlPlane(
   195	            signaling=self.signaling,
   196	            access=CP.AccessControl(owner_chat_ids=[OWNER],
   197	                                    user_chat_ids=[USER, WATCHDOG]),
   198	            clock=self.clock.monotonic, utc_now=self.clock.utc_now,
   199	            handlers=self._control_handlers(), bus=self.bus,
   200	            environment="PAPER", paper_balance="10000")
   201	        self.scheduler = C.Scheduler(clock=self.clock, bus=self.bus,
   202	                                     handlers=self._stage_handlers(),
   203	                                     drift_seconds=self.drift)
   204	        return self
