   284	    # -- venue state --------------------------------------------------------
   285	    def _accept_order(self, params: Dict[str, str], note: str = "") -> Dict[str, Any]:
   286	        client_order_id = params.get("clientOrderId", "")
   287	        existing = self.orders.get(client_order_id)
   288	        if existing is not None:
   289	            existing["duplicate_submission"] = True
   290	            return existing
   291	        self._order_seq += 1
   292	        order_id = f"{900000 + self._order_seq}"
   293	        quantity = params.get("quantity", "0")
   294	        price = params.get("price") or self.fill_price or "100.0"
   295	        status = "NEW"
   296	        executed = "0"
   297	        order = {"orderId": order_id, "clientOrderId": client_order_id,
   298	                 "symbol": params.get("symbol"), "side": params.get("side"),
   299	                 "positionSide": params.get("positionSide", "BOTH"),
   300	                 "type": params.get("type"), "timeInForce":
   301	                 params.get("timeInForce"), "price": price,
   302	                 "origQty": quantity, "executedQty": executed,
   303	                 "status": status, "reduceOnly":
   304	                 params.get("reduceOnly") in ("true", "True"),
   305	                 "updateTime": self.server_time_ms, "note": note}
   306	        self.orders[client_order_id] = order
   307	        self.orders_by_id[order_id] = order
   308	        if self.fill_mode == "immediate":
   309	            self._fill(order, quantity, self.fill_price or price)
   310	        elif self.fill_mode == "partial":
   311	            partial = _half(quantity)
   312	            self._fill(order, partial, self.fill_price or price)
   313	        return order
   314
   315	    def _fill(self, order: Dict[str, Any], quantity: str, price: str) -> None:
   316	        self._fill_seq += 1
   317	        executed = _decimal_add(order["executedQty"], quantity)
   318	        order["executedQty"] = executed
   319	        from decimal import Decimal
   320	        order["status"] = "FILLED" if Decimal(executed) == Decimal(
   321	            str(order["origQty"])) else "PARTIALLY_FILLED"
   322	        fill = {"id": str(700000 + self._fill_seq), "symbol": order["symbol"],
   323	                "orderId": order["orderId"], "clientOrderId":
   324	                order["clientOrderId"], "side": order["side"],
   325	                "price": price, "qty": quantity, "quoteQty":
   326	                _decimal_mul(price, quantity), "commission": "0.01000000",
   327	                "commissionAsset": "USDT", "time": self.server_time_ms,
   328	                "maker": False, "realizedPnl": "0.00000000"}
   329	        self.fills.append(fill)
   330	        self._update_position(order, quantity, price)
   331
   332	    def _update_position(self, order: Dict[str, Any], quantity: str,
   333	                         price: str) -> None:
   334	        symbol = order["symbol"]
   335	        side = str(order.get("side", "")).upper()
   336	        signed = quantity if side.startswith("BUY") else f"-{quantity}"
   337	        current = self.positions.get(symbol)
   338	        if current is None:
   339	            self.positions[symbol] = {"symbol": symbol,
   340	                                      "positionSide": order.get("positionSide",
   341	                                                                "BOTH"),
   342	                                      "positionAmt": signed,
   343	                                      "entryPrice": price,
   344	                                      "unRealizedProfit": "0.00000000",
   345	                                      "leverage": self.leverage.get(symbol, "5")}
   346	        else:
   347	            current["positionAmt"] = _decimal_add(current["positionAmt"], signed)
   348
