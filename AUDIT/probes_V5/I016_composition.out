   257	    async def _execution_stage(self, payload: Dict[str, Any]) -> Dict[str, Any]:
   258	        """The ninth stage: the projection from CP-6 to the venue and back."""
   259	        if self.paused or self.control.safe_mode:
   260	            refusal = {"cell_id": payload["cell_id"], "refused": "SYSTEM_PAUSED"}
   261	            self.refusals.append(refusal)
   262	            return {"stage": "execution", "cell_id": payload["cell_id"],
   263	                    "refused": "SYSTEM_PAUSED",
   264	                    "detail": "SYSTEM_PAUSED — Emergency pause is active; no "
   265	                              "new order was sent"}
   266	        cell = C.BundleCell(payload["symbol"], payload["timeframe"])
   267	        record = await self.trade_cell(cell, price="100")
   268	        self.executed.append(record)
   269	        return {"stage": "execution", "cell_id": payload["cell_id"],
   270	                "detail": f"{record['final_state']} intent={record['intent_id']}",
   271	                **{k: record[k] for k in ("outcome", "filled", "protected",
   272	                                          "closed", "reconciled", "leverage")}}
   273
   274	    # -- boot ---------------------------------------------------------------
   275	    async def boot(self, **kwargs) -> Dict[str, Any]:
   276	        machine = F.StartupReconciliation(ledger=self.ledger,
   277	                                          adapter=self.adapter,
   278	                                          bus=self.bus,
   279	                                          clock=self.clock.monotonic,
   280	                                          utc_now=self.clock.utc_now,
   281	                                          environment="PAPER",
   282	                                          drift_seconds=self.drift, **kwargs)
   283	        self.boot_verdict = await machine.run()
   284	        self.boot_state = machine.state
   285	        return self.boot_verdict
   286
   287	    # -- one cell, end to end ----------------------------------------------
   288	    async def trade_cell(self, cell: C.BundleCell, *, price: str = "100",
   289	                         intent_id: Optional[str] = None,
   290	                         exit_price: str = "103") -> Dict[str, Any]:
   291	        proposal = LoopProposal(proposal_id=f"pr-{cell.cell_id}",
   292	                                setup_id=f"su-{cell.cell_id}")
   293	        plan = F.build_trade_plan(
   294	            proposal=proposal, adjudication=loop_adjudication(),
   295	            symbol=cell.symbol, timeframe=cell.timeframe, environment="PAPER",
   296	            as_of=self.clock.utc_now(), capital=10000.0,
   297	            contract_multiplier=1.0, risk_state="LowRisk",
   298	            package_version="4.0.0", created_utc=self.clock.utc_now(),
   299	            lineage=f"loop:{cell.cell_id}")
   300	        await self._seed_setup(proposal.setup_id, cell)
   301	        # the intent_id becomes the wire clientOrderId: venue-legal characters
   302	        # only (no colon), and short enough for the 36-character limit.
   303	        machine = F.ExecutionFSM(
   304	            intent_id=intent_id or f"i-{cell.symbol}-{cell.timeframe}",
   305	                                 ledger=self.ledger, adapter=self.adapter,
   306	                                 bus=self.bus, clock=self.clock.monotonic,
   307	                                 utc_now=self.clock.utc_now,
   308	                                 environment="PAPER")
   309	        submitted = await machine.submit(plan, price=price)
   310	        record: Dict[str, Any] = {"cell_id": cell.cell_id,
   311	                                  "intent_id": machine.intent_id,
   312	                                  "outcome": submitted["outcome"],
   313	                                  "state": machine.state,
   314	                                  "leverage": plan.leverage,
   315	                                  "quantity": plan.sized_quantity,
   316	                                  "filled": False, "protected": False,
   317	                                  "closed": False, "reconciled": False}
   318	        if machine.state in ("ACKNOWLEDGED", "PARTIAL"):
   319	            await machine.record_fill(fill_id=f"f-{cell.cell_id}", price=price,
   320	                                      quantity=plan.sized_quantity)
   321	            await machine.advance("FULL_FILL")
   322	        record["filled"] = machine.state in ("FILLED", "PROTECTED", "MANAGED")
   323	        if record["filled"]:
   324	            protection = await machine.place_protection(
   325	                stop_price=plan.stop_price, target_price=plan.target_price)
   326	            record["protected"] = bool(protection["protected"])
   327	            if record["protected"]:
   328	                await machine.activate_management()
   329	                # the target leg fills: the exit is a FILL of its own, so the
   330	                # position recomputed from the ledger returns to flat (T_MATCH).
   331	                await machine.record_fill(fill_id=f"x-{cell.cell_id}",
   332	                                          price=exit_price,
   333	                                          quantity=plan.sized_quantity,
   334	                                          side="SELL_CLOSE")
   335	                closed = await machine.close_position(
   336	                    exit_price=exit_price, quantity=plan.sized_quantity,
   337	                    exit_reason="TARGET_1", setup_id=proposal.setup_id,
   338	                    pnl=str(Decimal(exit_price) - Decimal(price)))
   339	                record["closed"] = machine.state == "CLOSED"
   340	                record["stop_gap"] = closed["stop_gap"]
   341	                reconciled = await machine.reconcile()
   342	                record["reconciled"] = machine.state == "RECONCILED"
   343	                record["reconcile"] = {k: reconciled[k]
   344	                                       for k in ("agree", "delta")}
   345	        record["final_state"] = machine.state
   346	        return record
   405	async def loop_body(store, tmp_path, body, **kwargs):
   406	    """Run ``body(loop)`` inside one event loop with one writer."""
   407	    paper = PaperLoop(store, tmp_path, **kwargs)
   408	    await paper.start()
   409	    try:
   410	        return await body(paper)
   411	    finally:
   412	        await paper.stop()
   413
   414
   415	def scenario(store, tmp_path, body, **kwargs):
   416	    return run(loop_body(store, tmp_path, body, **kwargs))
   417
   423	class TestCleanLoop:
   424	    def test_boot_reaches_ready_before_any_order_is_sent(self, store, tmp_path):
   425	        async def body(p):
   426	            verdict = await p.boot()
   427	            return verdict, p.boot_state, len(p.order_posts())
   428
   429	        verdict, state, posts = scenario(store, tmp_path, body)
   430	        assert verdict["boot_state"] == "READY"
   431	        assert verdict["new_trades_allowed"] is True
   432	        assert state == "READY"
   433	        assert [c["name"] for c in verdict["checks"]][:4] == \
   434	            ["dependencies", "schema_version", "clock_sync", "ladder_state"]
   435	        assert all(c["status"] == "PASS" for c in verdict["checks"])
   436	        assert posts == 0                      # reconcile-first, nothing traded
   437
   438	    def test_one_cell_runs_the_full_fsm_lifecycle_to_reconciled(self, store,
   439	                                                                tmp_path):
   440	        async def body(p):
   441	            await p.boot()
   442	            record = await p.trade_cell(C.BundleCell("BTCUSDT", "1h"))
   443	            await p.drain()
   444	            return record
   445
   446	        record = scenario(store, tmp_path, body, fill_mode="none")
   447	        assert record["outcome"] == "ACKNOWLEDGED"
   448	        assert record["filled"] is True
   449	        assert record["protected"] is True
   450	        assert record["closed"] is True
   451	        assert record["reconciled"] is True
   452	        assert record["final_state"] == "RECONCILED"
   453	        assert record["stop_gap"] is None      # a target exit has no stop gap
   454
   455	    def test_the_ledger_carries_the_whole_lifecycle_and_verifies(self, store,
   456	                                                                 tmp_path):
   457	        async def body(p):
   458	            await p.boot()
   459	            await p.trade_cell(C.BundleCell("ETHUSDT", "15m"))
   460	            rows = await p.ledger_rows()
   461	            chain = await p.ledger.verify_chain()
   462	            closing = [r for r in rows if r.event_type == "FSM_TRANSITION"][-1]
   463	            return [r.event_type for r in rows], chain, closing
   464
   465	        types, chain, closing = scenario(store, tmp_path, body, fill_mode="none")
   466	        assert chain["intact"] is True
   467	        assert chain["breaks"] == []
   468	        assert chain["records"] == len(types)
   469	        assert types.count("FSM_TRANSITION") == 7      # the seven lifecycle edges
   470	        assert types.count("FILL") == 2                # entry leg + exit leg
   471	        assert types.count("TRADE_PLAN") == 1          # materialized pre-submit
   472	        assert "OUTCOME" in types
   473	        assert types[0] == "TRADE_PLAN"                # the plan comes first
   474	        # the reconcile evidence lives on the closing transition (T_MATCH)
   475	        assert closing.raw["payload"]["to_state"] == "RECONCILED"
   476	        assert Decimal(closing.raw["payload"]["evidence"]["delta"]) == 0
   477	        assert "T_MATCH" in closing.raw["payload"]["reason"]
