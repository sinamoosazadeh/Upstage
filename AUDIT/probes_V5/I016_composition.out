   280	def fill_from_result(result: Any, plan: F.TradePlan,
   281	                     *, suffix: str = "") -> Optional[Dict[str, str]]:
   282	    """Extract the EXECUTED price/quantity from a venue result.
   283
   284	    Returns ``None`` when the venue did not report both numbers — a fill is
   285	    never inferred (fail-closed; the order then stays working and the next
   286	    reconciliation owns it).
   287	    """
   288	    if getattr(result, "outcome", None) not in ("FILLED", "PARTIAL"):
   289	        return None
   290	    data = dict(getattr(result, "data", None) or {})
   291	    inner = data.get("data")
   292	    inner = dict(inner) if isinstance(inner, Mapping) else data
   293	    price = inner.get("avgPrice") or inner.get("price") or inner.get("fillPrice")
   294	    quantity = (inner.get("executedQty") or inner.get("quantity")
   295	                or inner.get("filledQty"))
   296	    if price is None or quantity is None:
   297	        return None
   298	    fill_id = str(inner.get("tradeId") or inner.get("fillId")
   299	                  or getattr(result, "order_id", "") or plan.proposal_id)
   300	    return {"fill_id": f"{fill_id}{suffix}", "price": str(price),
   301	            "quantity": str(quantity), "order_id": str(getattr(result, "order_id",
   302	                                                              "") or "")}
   303
   304
   305	async def last_closed_price(store: Any, symbol: str, timeframe: str,
   306	                            as_of: str) -> Optional[str]:
   307	    """The PIT-safe reference price: the CLOSE of the last closed bar at
   308	    ``as_of``. Never a live tick, never a fabricated number."""
   309	    window = await store.get_window(symbol, timeframe, as_of, 1)
   310	    if not window:
   311	        return None
   312	    close = window[-1].close
   313	    return str(close) if close is not None else None
