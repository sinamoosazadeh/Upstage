   100	    def test_main_exits_zero_on_a_green_run(self, runner, monkeypatch, capsys):
   101	        monkeypatch.setattr(runner, "run_harness",
   102	                            lambda **kwargs: {"fixture_seal": {"ok": True},
   103	                                              "fixture": "x", "cases": [],
   104	                                              "t_ad_001": {"passed": True},
   105	                                              "t_ad_002": {"passed": True},
   106	                                              "status": "PASS", "passed": True,
   107	                                              "cases_passed": 0,
   108	                                              "cases_total": 0})
   109	        assert runner.main([]) == 0
   110	        assert "status: PASS" in capsys.readouterr().out
