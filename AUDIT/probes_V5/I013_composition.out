   161	    def test_a_corrupt_export_record_is_reported_not_hidden(self, tmp_path):
   162	        import json
   163	        path = tmp_path / "legacy_export.json"
   164	        path.write_text(json.dumps([
   165	            {"engine_id": "E05", "version": "v3", "ftype": "NOPE"},
   166	            {"engine_id": "E99", "version": "v2", "ftype": "BULLISH_FVG"}]))
   167	        gate = ac.t_ad_001(export_path=str(path))["real_data_gate"]
   168	        assert gate["translated"] == 0
   169	        assert len(gate["failures"]) == 2
   170	        assert gate["status"] == "OPEN/UNVERIFIED"
   171
   172	    def test_absent_export_path_is_refused(self, tmp_path):
   173	        with pytest.raises(ac.AdapterConformanceError) as err:
   174	            ac.t_ad_001(export_path=str(tmp_path / "missing.json"))
   175	        assert err.value.reason == "EXPORT_PATH_ABSENT"
