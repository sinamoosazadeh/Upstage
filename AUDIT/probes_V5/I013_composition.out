=== Baseline adapter verdict functions ===
   124	def t_ad_001(*, export_path: Optional[str] = None) -> Dict[str, Any]:
   125	    """T-AD-001 — v2/v3 → v4.0.0 translation correct; semantics preserved.
   126
   127	    Without a user-provided legacy export the harness runs the synthetic
   128	    v4-derived self-checks and reports the real-data leg as OPEN/UNVERIFIED
   129	    (ADR-P2-009 — never fabricated).
   130	    """
   131	    results: List[Dict[str, Any]] = []
   132	    failures: List[str] = []
   133	    for case in synthetic_legacy_cases():
   134	        translated = translate_legacy(engine_id=case["engine_id"],
   135	                                      payload=case["payload"],
   136	                                      version=case["version"])
   137	        obj = _load_adapter(case["engine_id"])(dict(case["payload"]))
   138	        expect = case["expect"]
   139	        checks: Dict[str, Any] = {"translated": True}
   140	        if "ftype" in expect:
   141	            checks["ftype"] = getattr(obj, "ftype", None) == expect["ftype"]
   142	            marker = getattr(obj, "extra", {}).get("v3_doji_penalty")
   143	            checks["penalty_applied"] = ((marker == 0.7)
   144	                                        == bool(expect["penalty_applied"]))
   145	        if "derived_from" in expect:
   146	            checks["zone_bounds"] = (float(obj.zone_lo) == 99.0
   147	                                     and float(obj.zone_hi) == 101.0)
   148	            checks["v4_snapshot_minted"] = bool(getattr(obj, "snapshot_id", ""))
   149	        ok = all(bool(v) for v in checks.values())
   150	        if not ok:
   151	            failures.append(f"{case['engine_id']}:{json.dumps(checks, sort_keys=True)}")
   152	        results.append({"engine_id": case["engine_id"], "version": case["version"],
   153	                        "checks": checks, "ok": ok,
   154	                        "v4_hash": translated["v4_hash"],
   155	                        "read_only": translated["read_only"]})
   156	    export_summary: Dict[str, Any] = {
   157	        "gate": "G-ADAPTER-001", "status": "OPEN/UNVERIFIED",
   158	        "reason": "ADR-P2-009 — no v2/v3 data set exists in this repository; "
   159	                  "100 legacy samples cannot be sourced without fabrication",
   160	        "required_samples": G_ADAPTER_SAMPLE_REQUIREMENT,
   161	        "samples_supplied": 0, "owner_procedure": True}
   162	    if export_path:
   163	        path = Path(export_path)
   164	        if not path.exists():
   165	            raise AdapterConformanceError("EXPORT_PATH_ABSENT", export_path)
   166	        records = json.loads(path.read_text(encoding="utf-8"))
   167	        if not isinstance(records, list):
   168	            raise AdapterConformanceError("EXPORT_SHAPE_QX", export_path)
   169	        export_summary = run_legacy_export(records)
   170	    return {"test": "T-AD-001", "synthetic_cases": len(results),
   171	            "results": results, "failures": failures,
   172	            "passed": not failures,
   173	            "real_data_gate": export_summary,
   174	            "contract_version": CONTRACT_VERSION}
   175
   176
   177	def run_legacy_export(records: Sequence[Mapping[str, Any]]) -> Dict[str, Any]:
   178	    """Run a *user-provided* legacy export through the read-only adapters."""
   179	    translated = 0
   180	    failed: List[Dict[str, Any]] = []
   181	    for record in records:
   182	        try:
   183	            engine_id = str(record.get("engine_id", ""))
   184	            version = str(record.get("version", "v3"))
   185	            if isinstance(record.get("payload"), Mapping):
   186	                # harness synthetic case: engine_id/version + nested payload
   187	                payload = dict(record["payload"])
   188	            else:
   189	                payload = {k: v for k, v in record.items()
   190	                           if k not in ("engine_id", "version", "expect")}
   191	            translate_legacy(engine_id=engine_id, payload=payload,
   192	                             version=version)
   193	            translated += 1
   194	        except Exception as exc:               # noqa: BLE001 - reported, not hidden
   195	            failed.append({"record": str(record)[:120],
   196	                           "reason": f"{type(exc).__name__}:{exc}"})
   197	    status = ("CLOSED" if translated >= G_ADAPTER_SAMPLE_REQUIREMENT
   198	              and not failed else "OPEN/UNVERIFIED")
   199	    return {"gate": "G-ADAPTER-001", "status": status,
   200	            "samples_supplied": len(records), "translated": translated,
   201	            "failures": failed,
   202	            "required_samples": G_ADAPTER_SAMPLE_REQUIREMENT,
   203	            "data_loss": 0 if translated == len(records) else
   204	                         len(records) - translated}
   205
=== Baseline runner composition and main exit mapping ===
    88	def run_case(case: Dict[str, Any]) -> Dict[str, Any]:
    89	    """One fixture case against the real adapter + the fake responder."""
    90	    import asyncio
    91
    92	    from apex.config import Config
    93	    from apex.execution.toobit_adapter import ToobitAdapter
    94	    from fake_toobit_responder import FakeToobitResponder
    95
    96	    operations = {
    97	        "submit_order": lambda adapter, call: adapter.submit_order(**call),
    98	        "cancel_order": lambda adapter, call: adapter.cancel_order(**call),
    99	        "query_order_state": lambda adapter, call:
   100	            adapter.query_order_state(**call),
   101	        "query_open_positions": lambda adapter, call:
   102	            adapter.query_open_positions(**call),
   103	        "query_account_margin_health": lambda adapter, call:
   104	            adapter.query_account_margin_health(**call),
   105	    }
   106	    responder = FakeToobitResponder(api_key=HARNESS_ENV["TOOBIT_API_KEY"],
   107	                                    api_secret=HARNESS_ENV["TOOBIT_API_SECRET"])
   108	    adapter = ToobitAdapter(config=Config(), transport=responder,
   109	                            utc_now=lambda: "2026-01-01T00:00:00.000Z",
   110	                            clock=lambda: 1000.0)
   111	    _apply_scenario(responder, case.get("scenario", {}))
   112	    calls = case.get("calls") or [case["call"]]
   113	    posts_before = len(responder.calls_to("/api/v1/futures/order", "POST"))
   114	    result = None
   115	    for call in calls:
   116	        result = asyncio.run(operations[case["operation"]](adapter, call))
   117	    observed = result.to_dict()
   118	    failures: List[str] = []
   119	    for key, expected in case.get("expect", {}).items():
   120	        if key == "attempts":
   121	            if len(result.attempts) != expected:
   122	                failures.append(f"{key}: {len(result.attempts)} != {expected}")
   123	        elif key == "attempt_sources":
   124	            sources = [a.result_source for a in result.attempts]
   125	            if sources != expected:
   126	                failures.append(f"{key}: {sources} != {expected}")
   127	        elif key == "unique_idempotency_keys":
   128	            keys = [a.idempotency_key for a in result.attempts]
   129	            unique = len(set(keys)) == len(keys)
   130	            if unique is not expected:
   131	                failures.append(f"{key}: unique={unique} != {expected}")
   132	        elif key == "interval_disabled":
   133	            if dict(result.interval_disabled or {}) != expected:
   134	                failures.append(f"{key}: {result.interval_disabled} != {expected}")
   135	        elif observed.get(key) != expected:
   136	            failures.append(f"{key}: {observed.get(key)!r} != {expected!r}")
   137	    venue = case.get("expect_venue") or {}
   138	    if "posts_to_order_endpoint" in venue:
   139	        posts = len(responder.calls_to("/api/v1/futures/order", "POST")) - \
   140	            posts_before
   141	        if posts != venue["posts_to_order_endpoint"]:
   142	            failures.append(f"posts_to_order_endpoint: {posts} != "
   143	                            f"{venue['posts_to_order_endpoint']}")
   144	    if "signature_violations" in venue:
   145	        violations = len(responder.signature_violations())
   146	        if violations != venue["signature_violations"]:
   147	            failures.append(f"signature_violations: {violations} != "
   148	                            f"{venue['signature_violations']}")
   149	    if "request_params" in venue:
   150	        sent = responder.calls_to("/api/v1/futures/order", "POST")[-1].params
   151	        for key, value in venue["request_params"].items():
   152	            if sent.get(key) != value:
   153	                failures.append(f"request_params.{key}: {sent.get(key)!r} != "
   154	                                f"{value!r}")
   155	    if "venue_recorded_client_order_id" in venue:
   156	        if venue["venue_recorded_client_order_id"] not in responder.orders:
   157	            failures.append("venue_recorded_client_order_id: absent")
   158	    if "leverage_sent_for_BTCUSDT" in venue:
   159	        if responder.leverage.get("BTC-SWAP-USDT") != \
   160	                venue["leverage_sent_for_BTCUSDT"]:
   161	            failures.append("leverage_sent_for_BTCUSDT: mismatch")
   162	    state = case.get("expect_state") or {}
   163	    if "disabled_intervals" in state:
   164	        observed_state = {k: list(v) for k, v in
   165	                          adapter.disabled_intervals().items()}
   166	        if observed_state != state["disabled_intervals"]:
   167	            failures.append(f"disabled_intervals: {observed_state} != "
   168	                            f"{state['disabled_intervals']}")
   169	    return {"id": case["id"], "operation": case["operation"],
   170	            "ok": not failures, "failures": failures}
   171
