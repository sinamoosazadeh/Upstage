  1351	def run_engine(bars: Sequence[Dict[str, Any]],
  1352	               params: Optional[Dict[str, Any]] = None,
  1353	               symbol: str = "UNKNOWN", interval: str = "1h",
  1354	               as_of_ms: Optional[int] = None,
  1355	               trend_context: Optional[Dict[str, Any]] = None,
  1356	               volatility_context: Optional[Dict[str, Any]] = None
  1357	               ) -> Dict[str, Any]:
  1358	    """Batch driver over closed-candle dicts → the MomentumState payload for
  1359	    the last accepted candle + the §5.3 catalog events fired on it."""
  1360	    p = params if isinstance(params, EngineParams) else get_params(params)
  1361	    eng = MomentumEngine(p)
  1362	    eng.set_trend_context(trend_context)
  1363	    eng.set_volatility_context(volatility_context)
  1364	    state: Dict[str, Any] = {"quality": "QX",
  1365	                             "reason": "INSUFFICIENT_HISTORY_Q1",
  1366	                             "as_of": int(as_of_ms or 0)}
  1367	    for bar in bars:
  1368	        cand = candle_from_bar(bar, symbol=symbol, interval=interval)
  1369	        out = eng.update(cand)
  1370	        if "snapshot_id" in out:
  1371	            state = out
  1372	        elif out.get("quality") == "Q0":
  1373	            state = out
  1374	    if as_of_ms is not None and "as_of" in state:
  1375	        state = dict(state)
  1376	        state["as_of"] = int(as_of_ms)
  1377	    return {"state": state, "events": catalog_events(state),
  1378	            "engine": ENGINE, "contract_version": CONTRACT_VERSION,
  1379	            "n_bars": int(eng.bar_index)}
