  2344	        venue = await read_public_venue_facts(self.store, symbol, as_of)
  2345	        return {**governance, "environment": "PAPER", "commission_rate": venue["commission_rate"],
  2346	                "funding_rate": venue["funding_rate"], "venue_provenance": venue,
