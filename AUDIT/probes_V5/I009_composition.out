  1382	def catalog_events(state: Dict[str, Any]) -> List[Dict[str, Any]]:
  1383	    """§5.3 EV_MOM_xxx list fired by a state (empty for refusal states)."""
  1384	    events: List[Dict[str, Any]] = []
  1385	    if "events" not in state:
  1386	        return events
  1387	    ev = state["events"]
  1388	    as_of = int(state.get("as_of", 0))
  1389	    if ev.get("impulse_bull"):
  1390	        events.append({"code": "EV_MOM_001", "as_of": as_of, "state": state})
  1391	    if ev.get("impulse_bear"):
  1392	        events.append({"code": "EV_MOM_001b", "as_of": as_of, "state": state})
  1393	    if ev.get("exhaustion_bull"):
  1394	        events.append({"code": "EV_MOM_002", "as_of": as_of, "state": state})
  1395	    if ev.get("exhaustion_bear"):
  1396	        events.append({"code": "EV_MOM_002b", "as_of": as_of, "state": state})
  1397	    div = ev.get("divergence", {})
  1398	    code = KIND_TO_EVENT.get(str(div.get("kind", "NONE")))
  1399	    if code and (div.get("present") or div.get("kind") == "CONVERGENCE"):
  1400	        events.append({"code": code, "as_of": as_of, "state": state,
  1401	                       "divergence": div})
  1402	    if ev.get("momentum_neutral"):
  1403	        events.append({"code": "EV_MOM_008", "as_of": as_of, "state": state})
  1404	    return events
  1405
