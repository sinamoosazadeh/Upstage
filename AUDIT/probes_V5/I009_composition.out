   123	def po3_confirmations(t0=AS_OF_MS):
   124	    return [{"cid": cid, "t_confirm_ms": t0 + 900000 * (i + 1),
   125	             "p_confirm": 604.0 + i}
   126	            for i, cid in enumerate(["sweep", "choch", "bos", "fvg",
   127	                                     "vol_confirm"])]
