  1143	def run_engine(bars: Sequence[Dict[str, Any]],
  1144	               events: Optional[Sequence[Dict[str, Any]]] = None,
  1145	               framework_id: str = "RTM.PO3.v1",
  1146	               direction: str = "UP",
  1147	               as_of_ms: Optional[int] = None,
  1148	               avg_q: float = 0.9,
  1149	               mtf_align: float = 1.0,
  1150	               econ_events: Optional[Sequence[Dict[str, Any]]] = None,
  1151	               temporal_provider: Any = None,
  1152	               params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
  1153	    """Batch driver over a closed-candle window.
  1154
  1155	    ``events`` are upstream confirmations ``{cid, t_confirm_ms, p_confirm}``.
  1156	    Returns ``{engine, range, kz, bundle, events, integrity, weight_coverage}``.
  1157	    The degraded (E12-absent) branch is the CP-4 default — see
  1158	    ``utc_activity_window_check``.
  1159	    """
  1160	    p = get_params(params)
  1161	    bars = list(bars)
  1162	    if not bars:
  1163	        raise ValueError("EMPTY_WINDOW_QX: E07 requires a closed-candle window")
  1164	    as_of = int(as_of_ms if as_of_ms is not None else bars[-1]["ts"])
  1165	    range_info = atr_ratio_detect(bars, p.atr_short_period, p.atr_long_period, p)
  1166	    kz_info = utc_activity_window_check(as_of, econ_events,
  1167	                                        temporal_provider=temporal_provider,
  1168	                                        params=p)
  1169	    expected = expected_components(framework_id, p)
  1170	    confs = [dict(e) for e in (events or [])
  1171	             if int(e["t_confirm_ms"]) <= as_of]          # PIT filter (§3.1)
  1172	    order_map = build_order_map(expected, confs)
  1173	    present = sorted({c["cid"] for c in confs})
  1174	    evaluate_order_ok(expected, present, order_map)
  1175	    integrity, weight_cov, missing = sequence_integrity_v4(expected, present,
  1176	                                                           order_map)
  1177	    ev_names: List[str] = []
  1178	    if range_info["is_range"]:
  1179	        ev_names.append("EV_RTM_001")
  1180	    bundle = build_bundle_pipeline(
  1181	        expected, present, order_map, avg_q, mtf_align, kz_info, framework_id,
  1182	        direction, as_of, params=p.__dict__)
  1183	    if bundle is not None:
  1184	        ev_names.append("EV_RTM_011" if framework_id == "RTM.CHAIN.v1"
  1185	                        else "EV_RTM_004")
  1186	        if kz_info.get("in_kz"):
  1187	            ev_names.append("EV_RTM_007")
  1188	    else:
  1189	        ev_names.append("EV_RTM_005")
  1190	    return {"engine": ENGINE, "contract_version": CONTRACT_VERSION,
  1191	            "range": range_info, "kz": kz_info, "bundle": bundle,
  1192	            "events": ev_names, "integrity": integrity,
  1193	            "weight_coverage": weight_cov, "missing": missing,
  1194	            "as_of_ms": as_of,
  1195	            "degraded": bool(kz_info.get("degraded")),
  1196	            "degraded_reason": kz_info.get("degraded_reason")}
  1197
