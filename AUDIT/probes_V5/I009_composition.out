   145	# ---------------------------------------------------------------------------
   146	# E07 — the E12-unavailable degraded branch (and its authoritative counterpart)
   147	# ---------------------------------------------------------------------------
   148	class TestE07TemporalBranches:
   149	    def test_e12_absent_is_degraded_and_never_canonical(self):
   150	        info = utc_activity_window_check(AS_OF_MS)
   151	        assert info["degraded"] is True
   152	        assert info["degraded_reason"] == E12_UNAVAILABLE_REASON
   153	        assert info["source"] == "E07_LOCAL_NON_AUTHORITATIVE"
   154	        assert info["source"] != E12_CONTRACT
   155
   156	    def test_stub_e12_clears_the_degradation(self):
   157	        stub = StubE12(is_overlap=True)
   158	        info = utc_activity_window_check(AS_OF_MS, temporal_provider=stub)
   159	        assert info["degraded"] is False and info["degraded_reason"] is None
   160	        assert info["source"] == E12_CONTRACT
   161	        assert info["config_version"] == stub.config_version
   162	        assert info["is_overlap"] is True
   163	        assert stub.calls == [AS_OF_MS]          # E12 is the one consulted
   164
   165	    def test_a_failing_provider_fails_closed(self):
   166	        info = utc_activity_window_check(AS_OF_MS,
   167	                                        temporal_provider=StubE12(raise_=True))
   168	        assert info["degraded"] is True
   169	        assert info["degraded_reason"] == E12_UNAVAILABLE_REASON
   170
   171	    def test_degradation_caps_the_quality_class_at_q4(self):
   172	        """§3.7's Q5 gate needs the overlap flag; at CP-4 (E12 absent, a
   173	        non-overlap timestamp) the cascade is capped and Q5 is unreachable."""
   174	        conf = po3_confirmations(t0=1768485600000 + 9 * 3600000)   # 09:00Z
   175	        degraded_bundle = bundle_from(conf)
   176	        assert degraded_bundle is not None
   177	        assert degraded_bundle.resolution_class == "Q4"
   178	        # Same evidence, authoritative overlap window ⇒ Q5 is reachable.
   179	        overlap = bundle_from(conf, temporal_provider=StubE12(is_overlap=True))
   180	        assert overlap.resolution_class == "Q5"
   181	        assert Q_CLASSES.index(overlap.resolution_class) == \
   182	            Q_CLASSES.index("Q5")
   183
   184	    def test_both_branches_agree_on_integrity(self):
   185	        """The degradation changes provenance and the Q gate, never the
   186	        §3.1 sequence arithmetic."""
   187	        conf = po3_confirmations()
   188	        a = bundle_from(conf)
   189	        b = bundle_from(conf, temporal_provider=StubE12(is_overlap=True))
   190	        from apex.engines.e07_rtm import evaluate_order_ok
   191	        exp = expected_components("RTM.PO3.v1")
   192	        order = [c["cid"] for c in conf]
   193	        om_a = build_order_map(exp, conf)
   194	        evaluate_order_ok(exp, order, om_a)      # same pipeline as bundle_from
   195	        integrity, coverage, _missing = sequence_integrity_v4(exp, order, om_a)
   196	        assert a.integrity == pytest.approx(integrity)
   197	        assert b.integrity == pytest.approx(integrity)
   198	        assert a.weight_coverage == pytest.approx(coverage)
   199	        # Only the provenance differs between the two branches.
   200	        assert a.degraded is True and b.degraded is False
   201	        assert a.temporal_authority != b.temporal_authority
   202	        assert b.temporal_authority == E12_CONTRACT
