  1310	def catalog_events(state: Optional[Dict[str, Any]]) -> List[Dict[str, Any]]:
  1311	    """§5.4 catalog rows fired by a temporal state (empty for refusals)."""
  1312	    events: List[Dict[str, Any]] = []
  1313	    if not state or "snapshot_id" not in state or \
  1314	            state.get("quality") not in ("Q1", "Q2", "Q3", "Q4"):
  1315	        return events
  1316	    as_of = int(state.get("as_of", 0))
  1317	    events.append({"code": "EV_TMP_001", "as_of": as_of, "state": state,
  1318	                   "window": state["temporal_window"]})
  1319	    if state.get("is_overlap"):
  1320	        events.append({"code": "EV_TMP_003", "as_of": as_of, "state": state})
  1321	    return events
