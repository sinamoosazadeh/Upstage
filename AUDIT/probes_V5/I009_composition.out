  1433	    analyst_version = ANALYST_VERSION
  1434	    code_revision = "0" * 40
  1435
  1436	    def compute(self, symbol: str, timeframe: str, as_of: str,
  1437	                context: Optional[Dict[str, Any]] = None
  1438	                ) -> List[EvidenceEvent]:
  1439	        context = context or {}
  1440	        window_obs = self._resolve_window(symbol, timeframe, as_of, context)
  1441	        if not window_obs:
  1442	            return []
  1443	        bars = [observation_to_bar(o, timeframe) for o in window_obs]
  1444	        result = run_engine(
