    60	AS_OF = "2026-01-15T14:00:00Z"          # inside the 12:30–16:00 overlap
    61	AS_OF_MS = 1768485600000 + 14 * 3600000
    62	RANGE_LO, RANGE_HI, ATR = 608.2, 628.4, 4.2
