   315	    def test_e01_swings_drive_the_sequence_term_under_pit(self):
   316	        bars = lcg_window(40)
   317	        # The swings sit inside the MICRO window (last 5 bars of 40).
   318	        swings = [{"type": "HH", "idx": 35, "confirmed_at_idx": 36},
   319	                  {"type": "HL", "idx": 36, "confirmed_at_idx": 37},
   320	                  {"type": "HH", "idx": 37, "confirmed_at_idx": 38}]
   321	        with_swings = run_e09(bars, atr=ATR, swings=swings)
   322	        without = run_e09(bars, atr=ATR, swings=None)
   323	        assert with_swings["scales"]["MICRO"]["seq_score"] == pytest.approx(1.0)
   324	        assert without["scales"]["MICRO"]["seq_score"] == pytest.approx(0.0)
   325	        assert without["degraded"] is True
   326	        # A look-ahead swing is refused, not silently ignored.
   327	        leak = [{"type": "HH", "idx": 35, "confirmed_at_idx": 999}]
   328	        with pytest.raises(ValueError, match="PIT_SWING_VIOLATION_QX"):
   329	            run_e09(bars, atr=ATR, swings=leak)
