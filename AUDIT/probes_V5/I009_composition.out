  1400	def catalog_events(
  1401	    state: Dict[str, Any], params: Optional[EngineParams] = None
  1402	) -> List[Dict[str, Any]]:
  1403	    """§5.4 catalog rows fired by a regime_state (empty for refusals).
  1404
  1405	    D49: uses float(p.entropy_threshold) from governed params, never
  1406	    E11.THETA_H constant. THETA_H stays exported unused per C5.
  1407	    """
  1408	    events: List[Dict[str, Any]] = []
  1409	    if "state" not in state or "entropy" not in state:
  1410	        return events
  1411	    p = params or get_params()
  1412	    as_of = int(state.get("as_of", 0))
  1413	    events.append({"code": "EV_RGM_001", "as_of": as_of, "state": state})
  1414	    if state.get("regime_transition") == "SUSPECTED":
  1415	        events.append({"code": "EV_RGM_002", "as_of": as_of, "state": state})
  1416	    elif state.get("regime_transition") == "CONFIRMED":
  1417	        events.append({"code": "EV_RGM_003", "as_of": as_of, "state": state})
  1418	    if float(state["entropy"]) >= float(p.entropy_threshold):
  1419	        events.append({"code": "EV_RGM_004", "as_of": as_of, "state": state})
  1420	    if float(state["turbulence"]) >= TH_TURB_95:
  1421	        events.append({"code": "EV_RGM_005", "as_of": as_of, "state": state})
  1422	    if state.get("Q") in ("Q0", "Q1"):
  1423	        events.append({"code": "EV_RGM_006", "as_of": as_of, "state": state})
  1424	    return events
  1425
