   130	def bundle_from(conf, avg_q=0.9, mtf_align=1.0, direction="UP",
   131	                temporal_provider=None, framework="RTM.PO3.v1"):
   132	    exp = expected_components(framework)
   133	    om = build_order_map(exp, conf)
   134	    order = [c["cid"] for c in conf]
   135	    evaluate_order_ok(exp, order, om)
   136	    kz = utc_activity_window_check(conf[-1]["t_confirm_ms"],
   137	                                   temporal_provider=temporal_provider)
   138	    return build_bundle_pipeline(exp, order, om, avg_q, mtf_align, kz,
   139	                                 framework, direction, conf[-1]["t_confirm_ms"])
