  1446	            interval=timeframe,
  1447	            trend_context=context.get("trend_context"),
  1448	            volatility_context=context.get("volatility_context"))
  1449	        self._last_n_bars = int(result["n_bars"])
  1450	        state = result["state"]
  1451	        if "snapshot_id" not in state:
  1452	            return []                    # QX/Q0 refusal — nothing fabricated
  1453	        quality = self._window_quality(window_obs)
  1454	        return [self._to_evidence(item, symbol, timeframe, quality, state)
