===== apex/engines/e11_regime/engine.py:1515-1544 (baseline supplied-window resolution) =====
  1515	    def _resolve_candles(self, symbol: str, timeframe: str, as_of: str,
  1516	                         context: Dict[str, Any]) -> List[Dict[str, Any]]:
  1517	        candles = context.get("candles")
  1518	        if candles is not None:
  1519	            return list(candles)
  1520	        window = context.get("window")
  1521	        if window is None:
  1522	            provider = context.get("provider")
  1523	            if provider is None:
  1524	                raise ValueError("MISSING_WINDOW_CONTEXT_QX")
  1525	            import asyncio
  1526	            import inspect
  1527	            bars = context.get("bars", 300)
  1528	            res = provider.get_window(symbol, timeframe, as_of, bars)
  1529	            if inspect.isawaitable(res):
  1530	                try:
  1531	                    asyncio.get_running_loop()
  1532	                except RuntimeError:
  1533	                    window = list(asyncio.run(res))
  1534	                else:
  1535	                    raise ValueError("MISSING_WINDOW_CONTEXT_QX (async "
  1536	                                     "provider inside a running loop — pass "
  1537	                                     "context['candles'] or "
  1538	                                     "context['window'])")
  1539	            else:
  1540	                window = list(res)
