    45	CH4_DDL = """
    46	CREATE TABLE market_observation (
    47	    observation_id TEXT PRIMARY KEY CHECK(typeof(observation_id)='text'),
    48	    symbol TEXT CHECK(typeof(symbol)='text') CHECK(symbol IN ('BTCUSDT','ETHUSDT','SOLUSDT','BNBUSDT','XRPUSDT','ADAUSDT','DOGEUSDT','AVAXUSDT','LINKUSDT','LTCUSDT')),
    49	    timeframe TEXT CHECK(typeof(timeframe)='text') CHECK(timeframe IN ('1m','3m','5m','15m','30m','1h','2h','4h','6h','8h','12h','1d','1w','1mo')),
    50	    open_price TEXT CHECK(typeof(open_price)='text'),
    51	    high_price TEXT CHECK(typeof(high_price)='text'),
    52	    low_price TEXT CHECK(typeof(low_price)='text'),
    53	    close_price TEXT CHECK(typeof(close_price)='text'),
    54	    volume TEXT CHECK(typeof(volume)='text'),
    55	    open_interest TEXT CHECK(typeof(open_interest)='text'),
    56	    open_time TEXT CHECK(typeof(open_time)='text'),
    57	    close_time TEXT CHECK(typeof(close_time)='text'),
    58	    retrieved_at TEXT CHECK(typeof(retrieved_at)='text'),
    59	    candle_status TEXT CHECK(candle_status IN ('MISSING','PARTIAL','CLOSED','CORRECTED','SUPERSEDED')),
    60	    quality_state TEXT CHECK(quality_state IN ('Q0','Q1','Q2','Q3','Q4','QX')),
    61	    source TEXT,
    62	    schema_version TEXT,
    63	    raw_payload_hash TEXT,
    64	    CHECK(CAST(high_price AS REAL)>=max(CAST(open_price AS REAL),CAST(close_price AS REAL)) AND CAST(low_price AS REAL)<=min(CAST(open_price AS REAL),CAST(close_price AS REAL)) AND CAST(high_price AS REAL)>=CAST(low_price AS REAL))
    65	);
    66
    67	CREATE TABLE quality_vector (
    68	    quality_id TEXT PRIMARY KEY CHECK(typeof(quality_id)='text'),
    69	    observation_id TEXT,
    70	    q_schema REAL, q_time REAL, q_seq REAL, q_ohlc REAL, q_volume REAL, q_oi REAL, q_source REAL,
    71	    q_raw REAL CHECK(q_raw>=0 AND q_raw<=1),
    72	    veto_freshness INTEGER, veto_completeness INTEGER, veto_oi_lag INTEGER, veto_source INTEGER,
    73	    FOREIGN KEY(observation_id) REFERENCES market_observation(observation_id)
    74	);
    75
    76	CREATE TABLE snapshot_pit (
    77	    snapshot_id TEXT PRIMARY KEY CHECK(typeof(snapshot_id)='text'),
    78	    as_of TEXT,
    79	    symbol_scope TEXT,
    80	    timeframe_scope TEXT,
    81	    source_state TEXT,
    82	    manifest_hash TEXT,
    83	    parameter_package_id TEXT,
    84	    code_version TEXT,
    85	    vector_quality_state TEXT,
    86	    min_quality REAL,
    87	    weighted_quality REAL,
    88	    created_at TEXT
    89	);
