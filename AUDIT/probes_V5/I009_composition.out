   175	    def test_q5_reachable_only_on_authoritative_overlap(self):
   176	        """§3.7's Q5 gate needs the overlap flag — with the REAL E12 the
   177	        provenance is authoritative and the cascade reaches Q5 inside
   178	        [12:30, 16:00); outside it, the real E12 caps the bundle at Q4 even
   179	        though the branch is non-degraded (E12 said 'no overlap')."""
   180	        conf14 = po3_confirmations()                     # confirms ≤ 15:15Z
   181	        resolved = bundle_from(conf14,
   182	                               temporal_provider=E12TemporalProvider())
   183	        assert resolved.resolution_class == "Q5"
   184	        assert resolved.degraded is False
   185	        conf09 = po3_confirmations(t0=MORNING_MS)        # confirms ≤ 10:15Z
   186	        morning = bundle_from(conf09,
   187	                              temporal_provider=E12TemporalProvider())
   188	        assert morning.resolution_class == "Q4"          # W1, no overlap
   189	        assert morning.degraded is False
   190	        degraded = bundle_from(conf09)                   # CP-4 branch
   191	        assert degraded.resolution_class == "Q4" and degraded.degraded is True
   192	        assert Q_CLASSES.index(resolved.resolution_class) == \
   193	            Q_CLASSES.index("Q5")
