  1346	                             "as_of": int(as_of_ms or 0)}
  1347	    events: List[Dict[str, Any]] = []
  1348	    for candle in candles:
  1349	        if not eng.warmup_ok():
  1350	            # accumulate history from raw inputs while below the norm floors
  1351	            ic = dict(candle.get("ic_inputs") or {})
  1352	            for win, key in (("trend", "trendiness_raw"),
  1353	                             ("vol", "vol_ratio"), ("exp", "expansion_raw"),
  1354	                             ("liq", "level_density"),
  1355	                             ("part", "participation_raw"),
  1356	                             ("sq", "structure_score")):
  1357	                val = (ic.get("liquidity_raw", ic.get(key))
  1358	                       if win == "liq" else ic.get(key))
  1359	                if val is not None and math.isfinite(float(val)):
  1360	                    eng.history_windows[win].append(float(val))
  1361	            state = {"quality": "QX", "reason": "INSUFFICIENT_HISTORY_Q1",
  1362	                     "as_of": int(candle.get("as_of",
  1363	                                             candle.get("ts", 0)) or 0)}
  1364	            continue
  1365	        out = eng.update(candle)
  1366	        if "regime_state" in out:
  1367	            state = out["regime_state"]
  1368	            events.extend(out["events"])
  1369	        else:
  1370	            state = out
  1371	            events.append({"type": out.get("event", "EV_RGM_006"),
  1372	                           "error": out.get("error"),
  1373	                           "as_of": int(out.get("as_of", 0))})
  1374	    if as_of_ms is not None and "as_of" in state:
  1375	        state = dict(state)
  1376	        state["as_of"] = int(as_of_ms)
  1377	    gate_enabled = bool(live_regime_gate)
  1378	    return {
  1379	        "regime_state": state,
  1380	        "dependency_state": ({
  1381	            "oi_state": candles[-1]["ic_inputs"]["oi_state"],
  1382	            "contributing_features": dict(candles[-1]["ic_inputs"].get("contributing_features", {}))}
  1383	            if candles and "oi_state" in candles[-1].get("ic_inputs", {}) else {}),
  1384	        "events": events,
  1385	        "engine": ENGINE,
  1386	        "contract_version": CONTRACT_VERSION,
  1387	        "n_bars": int(eng.bar_index),
  1388	        "H_norm": (entropy_normalized(float(state["entropy"]))
  1389	                   if "entropy" in state else None),
  1390	        "xi_filtered": [float(v) for v in eng.xi],
  1391	        "live_regime_gate": {
  1392	            "enabled": gate_enabled,
  1393	            "reason": LIVE_GATE_OFF_REASON if not gate_enabled
  1394	            else "LIVE_REGIME_GATE_ENABLED_BY_CALLER: Phase-7 + Owner "
  1395	                 "approval asserted at the call site",
  1396	        },
  1397	    }
