  1199	class E07RTMEngine(EngineBase):
  1200	    """E07_RTM_ICT on the frozen EngineBase contract (v4.0.0).
  1201
  1202	    ``compute(symbol, timeframe, as_of, context)``; consumed context keys:
  1203	      ``window`` / ``provider``   — closed-candle window (catalog surface)
  1204	      ``e07_params``              — §6 overrides (unknown keys rejected)
  1205	      ``events``                  — upstream confirmations
  1206	                                    ``[{cid, t_confirm_ms, p_confirm}]``
  1207	      ``framework_id``            — default ``RTM.PO3.v1``
  1208	      ``direction``               — ``UP`` | ``DOWN``
  1209	      ``avg_quality``/``mtf_align`` — §3.7 confidence terms
  1210	      ``econ_events``             — high-impact calendar rows
  1211	      ``temporal_provider``       — ``E12_Temporal_Context.Contract v4.0.0``;
  1212	                                    absent ⇒ documented degraded branch
  1213	    Emissions: one ``EvidenceEvent`` per produced bundle on
  1214	    ``evidence.E07.{condition_state}``; every emission validates the 24-field
  1215	    frame. Bundles are context only — never a capital signal (§0, NG2/NG5).
  1216	    """
  1217
  1218	    engine_id = "E07"
  1219	    analyst_version = ANALYST_VERSION
  1220	    code_revision = "0" * 40
  1221
  1222	    def compute(self, symbol: str, timeframe: str, as_of: str,
  1223	                context: Optional[Dict[str, Any]] = None
  1224	                ) -> List[EvidenceEvent]:
  1225	        context = context or {}
  1226	        window_obs = self._resolve_window(symbol, timeframe, as_of, context)
  1227	        if not window_obs:
  1228	            return []
  1229	        bars = [observation_to_bar(o, timeframe) for o in window_obs]
  1230	        result = run_engine(
  1231	            bars,
  1232	            events=context.get("events"),
  1233	            framework_id=context.get("framework_id", "RTM.PO3.v1"),
  1234	            direction=context.get("direction", "UP"),
  1235	            as_of_ms=context.get("as_of_ms"),
  1236	            avg_q=float(context.get("avg_quality", 0.9)),
  1237	            mtf_align=float(context.get("mtf_align", 1.0)),
  1238	            econ_events=context.get("econ_events"),
  1239	            temporal_provider=context.get("temporal_provider"),
  1240	            params=context.get("e07_params"))
  1241	        bundle = result["bundle"]
  1242	        if bundle is None:
  1243	            return []
  1244	        quality = self._window_quality(window_obs)
  1245	        return [self._to_evidence(bundle, symbol, timeframe, quality, result)]

