  2350	    def _raw_content_hash(self, observation: Any) -> str:
  2351	        """Memo only the frozen content_hash payload, with exact typed values.
  2352
  2353	        repr preserves Decimal precision (numeric equality alone would alias
  2354	        100.0 and 100.00). Every miss calls the native method on the actual
  2355	        observation; this never constructs or modifies a raw record.
  2356	        """
  2357	        key = (type(observation), tuple((type(value),repr(value)) for value in
  2358	            (observation.symbol,observation.timeframe,observation.timestamp,
  2359	             observation.open,observation.close,observation.volume)))
  2360	        if key not in self._content_hashes:
  2361	            digest = observation.content_hash()
  2362	            if len(self._content_hashes) >= 4096:
  2363	                del self._content_hashes[next(iter(self._content_hashes))]
  2364	            self._content_hashes[key] = digest
  2365	        return self._content_hashes[key]
  2366
  2367	    async def window(self, symbol: str, timeframe: str, as_of: str, bars: int) -> list[Any]:
  2368	        end = _iso_to_ms(as_of)
  2369	        window = await self.store.get_window(symbol, timeframe, as_of, bars)
  2370	        if window is None:
  2371	            raise BridgeError("NO_MARKET_DATA", "store returned no window")
  2372	        from dataclasses import replace
  2373	        window = [o for o in window if close_time_ms(_iso_to_ms(o.timestamp), timeframe) <= end]
  2374	        if not window:
  2375	            return []
  2376	        # get_window is the authoritative bar reader. Its legacy projection
  2377	        # substitutes retrieved_at for raw availability and loses OI lineage.
  2378	        # Recover ONLY metadata through the immutable identity, never rewrite
  2379	        # a market/raw row or substitute the derived close for raw availability.
  2380	        rows = await (await self.store.db.execute(
  2381	            "SELECT m.open_time,m.observation_id,m.raw_payload_hash,r.content_hash,"
  2382	            "r.availability_time,r.oi_timestamp,r.oi_state FROM market_observation m "
  2383	            "JOIN raw_observation r ON m.observation_id='obs-'||r.event_id "
  2384	            "WHERE m.symbol=? AND m.timeframe=? AND m.candle_status IN ('CLOSED','CORRECTED') "
  2385	            "AND m.open_time>=? AND m.open_time<=? ORDER BY m.open_time",
  2386	            (symbol, timeframe, window[0].timestamp, window[-1].timestamp))).fetchall()
  2387	        metadata = {}
  2388	        for row in rows:
  2389	            if row[0] in metadata:
  2390	                raise BridgeError("RAW_LINEAGE_INVALID", "ambiguous active observation")
  2391	            metadata[row[0]] = row
  2392	        result = []
  2393	        for obs in window:
  2394	            row = metadata.get(obs.timestamp)
  2395	            content_hash = self._raw_content_hash(obs)
  2396	            if row is None or row[3] != content_hash or row[2] != hashlib.sha256(row[3].encode()).hexdigest():
  2397	                raise BridgeError("RAW_LINEAGE_INVALID", "observation/raw content binding missing")
  2398	            if row[4] is None:
  2399	                raise BridgeError("RAW_LINEAGE_INVALID", "raw availability unavailable")
  2400	            if _iso_to_ms(row[4]) > end:
  2401	                continue  # never expose not-yet-available observations
  2402	            oi_lag = (max(0., (end - _iso_to_ms(row[5])) / 1000.) if row[5] is not None else None)
  2403	            result.append(replace(obs, availability_time=row[4], oi_timestamp=row[5], oi_lag_seconds=oi_lag))
  2404	            self._raw_lineage[(symbol, timeframe, obs.timestamp, content_hash)] = {
  2405	                "observation_id": row[1], "oi_state": row[6], "availability_time": row[4]}
  2406	        return result
  2407
  2408	    async def training_dep_window(self, symbol: str, timeframe: str, *,
  2409	                                  close_to_ms: int, count: int) -> list[Any]:
  2410	        """D35 training-only HTF prefetch: one verified read per cell.
  2411
  2412	        Replaces thousands of identical per-bar window() re-reads over one
  2413	        training cell. Every dependency row closed at or before the cell end
  2414	        is returned (no lower cut: gapped history can reach arbitrarily far
  2415	        back for a 301-bar slice); each per-bar slice re-applies the gates
  2416	        via slice_training_window, so served slices equal live window()
  2417	        calls exactly (parity-tested). Runtime (G1) never uses this path.
  2418	        """
  2419	        return await self.window(symbol, timeframe, _ms_to_iso(close_to_ms), count) if count else []
  2420

