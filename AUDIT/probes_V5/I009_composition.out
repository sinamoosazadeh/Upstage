  1432	def observation_to_candle(obs: MarketObservation,
  1433	                          ic_inputs: Optional[Dict[str, Any]] = None
  1434	                          ) -> Dict[str, Any]:
  1435	    """MarketObservation → the §4 candle shape (ic_inputs carried through)."""
  1436	    ts_ms = 0
  1437	    try:
  1438	        dt = datetime.datetime.fromisoformat(
  1439	            str(obs.timestamp).replace("Z", "+00:00"))
  1440	        ts_ms = int(dt.timestamp() * 1000)
  1441	    except (ValueError, AttributeError):
  1442	        ts_ms = 0
  1443	    return {"o": float(obs.open), "h": float(obs.high), "l": float(obs.low),
  1444	            "c": float(obs.close), "v": float(obs.volume), "ts": ts_ms,
  1445	            "as_of": ts_ms, "symbol": obs.symbol,
  1446	            "timeframe": obs.timeframe,
  1447	            "is_closed": (obs.status == "CLOSED") if obs.status else True,
  1448	            "ic_inputs": dict(ic_inputs or {})}
