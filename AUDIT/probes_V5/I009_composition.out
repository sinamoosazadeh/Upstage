===== apex/data_catalog/store/sqlite_store.py:497-556 (baseline) =====
   497	    async def get_window(self, symbol: str, timeframe: str, as_of: str,
   498	                         bars: int) -> List[MarketObservation]:
   499	        """CLOSED observations with open_time <= as_of, ascending, the LAST
   500	        `bars` rows (PIT-safe by construction).
   501
   502	        The inner query takes the newest `bars` rows at or before `as_of` and
   503	        the outer one restores ascending order — the docstring's "last `bars`
   504	        rows", which an ``ORDER BY open_time ASC LIMIT`` alone would invert
   505	        (ISSUE-CP9-001: engines must see the most recent window, never the
   506	        oldest one).
   507	        """
   508	        cur = await self.db.execute(
   509	            "SELECT * FROM (SELECT observation_id, symbol, timeframe, "
   510	            " open_price, high_price, low_price, close_price, volume, "
   511	            " open_interest, open_time, retrieved_at, candle_status, "
   512	            " quality_state, source, raw_payload_hash "
   513	            " FROM market_observation WHERE symbol=? AND timeframe=? "
   514	            " AND candle_status IN ('CLOSED','CORRECTED') "
   515	            " AND open_time<=? ORDER BY open_time DESC LIMIT ?) "
   516	            "ORDER BY open_time ASC",
   517	            (symbol, timeframe, as_of, bars))
   518	        rows = await cur.fetchall()
   519	        result: List[MarketObservation] = []
   520	        for i, row in enumerate(rows):
   521	            result.append(self._row_to_obs(row, i))
   522	        return result
   523
   524	    async def max_availability_time(self, symbol: str, timeframe: str,
   525	                                    as_of: str) -> Optional[str]:
   526	        """Data frontier: max availability_time over stored raw rows for
   527	        (symbol, timeframe). None when no data (fail-closed at caller)."""
   528	        cur = await self.db.execute(
   529	            "SELECT MAX(availability_time) FROM raw_observation "
   530	            "WHERE symbol=? AND timeframe=?", (symbol, timeframe))
   531	        row = await cur.fetchone()
   532	        if row is None or row[0] is None:
   533	            return None
   534	        return row[0]
   535
   536	    @staticmethod
   537	    def _row_to_obs(row: tuple, seq: int) -> MarketObservation:
   538	        from decimal import Decimal, InvalidOperation
   539	        (obs_id, symbol, timeframe, o, h, l, c, v, oi, open_time,
   540	         retrieved, status, qstate, source, payload_hash) = row
   541	        oi_value: Optional[Decimal] = None
   542	        if oi is not None:
   543	            try:
   544	                oi_value = Decimal(oi)
   545	            except (InvalidOperation, ValueError):
   546	                # T-DC-004: the canonical availability label is not a number —
   547	                # it reads back as MISSING (never 0).
   548	                oi_value = None
   549	        return MarketObservation(
   550	            symbol=symbol, timeframe=timeframe,
   551	            open=Decimal(o), high=Decimal(h), low=Decimal(l),
   552	            close=Decimal(c), volume=Decimal(v),
   553	            oi=oi_value,
   554	            timestamp=open_time, sequence=seq, status=status,
   555	            source=source, availability_time=retrieved,
   556	        )

===== apex/ops/engine_context.py:1798-1842 (baseline) =====
  1798	    async def prepare(self, symbol: str, timeframe: str, as_of: str) -> None:
  1799	        """Outside-budget source preparation; a failed refresh clears success."""
  1800	        key = (symbol,timeframe,as_of)
  1801	        self._ready.pop(key,None)
  1802	        self._failed.pop(key,None)
  1803	        try:
  1804	            if self.environment != "PAPER":
  1805	                raise BridgeError("PAPER_ONLY_EXECUTION",self.environment)
  1806	            from apex.data_catalog.contracts import TIMEFRAMES_14
  1807	            if symbol not in CORE10_SYMBOLS or timeframe not in TIMEFRAMES_14:
  1808	                raise BridgeError("CELL_OUT_OF_UNIVERSE",f"{symbol}:{timeframe}")
  1809	            parse_utc_ms(as_of)
  1810	            fingerprint = await self._input_fingerprint(symbol,timeframe,as_of)
  1811	            saved = await read_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,exact=True)
  1812	            if saved and saved["input_fingerprint"] == fingerprint:
  1813	                context = saved["context"]
  1814	                context["events"] = await read_complete_evidence(self.store,context["events"])
  1815	            else:
  1816	                context = await self._compose_bridge_context(symbol,timeframe,as_of)
  1817	                await append_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,
  1818	                    {"input_fingerprint":fingerprint,"context":{**context,"events":[e.evidence_id for e in context["events"]]}})
  1819	            validate_produced_context(context)
  1820	            self._ready[key] = context
  1821	        except BridgeError as exc:
  1822	            self._failed[key] = exc
  1823	            raise
  1824	        except (ValueError,KeyError,TypeError,ArithmeticError) as exc:
  1825	            refusal = BridgeError("ENGINE_CONTEXT_INVALID",f"{type(exc).__name__}: {exc}")
  1826	            self._failed[key] = refusal
  1827	            raise refusal from exc
  1828
  1829	    async def get_bridge_context(self, symbol: str, timeframe: str, as_of: str) -> dict:
  1830	        """Exactly 38 context fields / 23 risk fields; no fixture fallback.
  1831
  1832	        PAPER serve binds prepare separately so this accessor is a cheap copy
  1833	        inside the scheduler budget. A standalone caller may prepare lazily.
  1834	        """
  1835	        import copy
  1836	        key = (symbol,timeframe,as_of)
  1837	        if key in self._failed:
  1838	            raise self._failed[key]
  1839	        if key not in self._ready:
  1840	            await self.prepare(symbol,timeframe,as_of)
  1841	        return copy.deepcopy(self._ready[key])
  1842

