   257	class TestE09StackAndADLine:
   258	    def test_four_scales_with_the_full_schema(self):
   259	        bars = lcg_window(60)
   260	        res = run_e09(bars, atr=ATR,
   261	                      swings=[{"type": "HH", "idx": 10, "confirmed_at_idx": 11},
   262	                              {"type": "HL", "idx": 20, "confirmed_at_idx": 21},
   263	                              {"type": "HH", "idx": 30, "confirmed_at_idx": 31}])
   264	        assert set(res["scales"]) == set(SCALES)
   265	        for scale, data in res["scales"].items():
   266	            assert data["scale"] == scale
   267	            missing = [k for k in TREND_SCALE_REQUIRED if k not in data]
   268	            assert missing == []
   269	            assert data["direction"] in (-1, 0, 1)
   270	            assert data["quality_label"] in QUALITY_LABELS
   271	            assert len(data["snapshot_id"]) == 64
   272	        missing = [k for k in TREND_STACK_REQUIRED if k not in res]
   273	        assert missing == []
   274	        assert res["alignment"] in ALIGNMENTS
   275
   276	    def test_ad_line_is_the_wilder_chain(self):
   277	        """DI+/DI−/DX/ADX are published per scale; a warm-up window degrades
   278	        instead of presenting an untrustworthy ADX (§3.5)."""
   279	        # Each window gets swings inside its own MICRO window (PIT-legal):
   280	        # the 8-bar run evaluates idx 7, the 60-bar run evaluates idx 59.
   281	        short_swings = [{"type": "HH", "idx": 3, "confirmed_at_idx": 4},
   282	                        {"type": "HL", "idx": 4, "confirmed_at_idx": 5},
   283	                        {"type": "HH", "idx": 5, "confirmed_at_idx": 6}]
   284	        warm_swings = [{"type": "HH", "idx": 55, "confirmed_at_idx": 56},
   285	                       {"type": "HL", "idx": 56, "confirmed_at_idx": 57},
   286	                       {"type": "HH", "idx": 57, "confirmed_at_idx": 58}]
   287	        short = run_e09(lcg_window(8), atr=ATR, swings=short_swings)
   288	        warm = run_e09(lcg_window(60), atr=ATR, swings=warm_swings)
   289	        assert short["scales"]["MICRO"]["degraded_reason"] == "ADX_WARMUP_QX"
   290	        assert warm["scales"]["MICRO"]["degraded_reason"] is None
   291	        micro = warm["scales"]["MICRO"]
   292	        assert 0.0 <= micro["adx"] <= 100.0
   293	        assert 0.0 <= micro["di_plus"] <= 100.0
   294	        assert 0.0 <= micro["di_minus"] <= 100.0
   295	        assert micro["adx"] >= 0.0
   296
   297	    def test_alignment_follows_the_governed_bias_bands(self):
   298	        aligned = run_e09(lcg_window(60, span=1.0), atr=ATR)
   299	        assert -1.0 <= aligned["bias"] <= 1.0
   300	        if abs(aligned["bias"]) > 0.7 and aligned["alignment"] == "ALIGNED_BULL":
   301	            assert all(aligned["scales"][s]["direction"] == 1 for s in SCALES)
   302
   303	    def test_e04_governed_atr_is_consumed_not_recomputed(self):
   304	        """The pos term is ATR-normalised; E09 uses the supplied E04 ATR and
   305	        never derives one of its own."""
   306	        bars = lcg_window(40)
   307	        atr_val = float(run_e04(bars)["atr_series"][-1])
   308	        assert atr_val > 0.0
   309	        a = run_e09(bars, atr=atr_val)
   310	        b = run_e09(bars, atr=atr_val * 2)
   311	        assert a["scales"]["MICRO"]["pos"] != b["scales"]["MICRO"]["pos"]
   312	        assert a["scales"]["MICRO"]["pos"] == pytest.approx(
   313	            2 * b["scales"]["MICRO"]["pos"], rel=1e-9)
