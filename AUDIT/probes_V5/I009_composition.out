   411	class TestTDR001CP4:
   412	    def test_double_run_byte_identical_all_engines(self):
   413	        bars = lcg_window(30)
   414	        ctx_e07 = {"window": obs_window(bars), "events": po3_confirmations(),
   415	                   "direction": "UP"}
   416	        ctx_e08 = {"window": obs_window(bars),
   417	                   "atr_by_idx": {i: ATR for i in range(len(bars))},
   418	                   "vol_ratio_by_idx": {i: 1.0 for i in range(len(bars))},
   419	                   "evr_by_idx": {i: 0.5 for i in range(len(bars))}}
   420	        ctx_e09 = {"window": obs_window(bars), "atr": ATR}
   421	        runs = []
   422	        for _ in range(2):
   423	            batch = []
   424	            batch += E07RTMEngine().compute("BTCUSDT", "1h", AS_OF, ctx_e07)
   425	            batch += E08WyckoffEngine().compute("BTCUSDT", "1h", AS_OF, ctx_e08)
   426	            batch += E09TrendEngine().compute("BTCUSDT", "1h", AS_OF, ctx_e09)
   427	            runs.append([(ev.engine_id, ev.snapshot_id, ev.condition_state,
   428	                          ev.direction, ev.strength, ev.resolution_class)
   429	                         for ev in batch])
   430	        assert runs[0] == runs[1]
   431	        assert len(runs[0]) >= 5
   432
   433	    def test_streaming_replay_is_deterministic_too(self):
   434	        bars = lcg_window(30)
   435	        kw = dict(atr_by_idx={i: ATR for i in range(len(bars))},
   436	                  vol_ratio_by_idx={i: 1.0 for i in range(len(bars))},
   437	                  evr_by_idx={i: 0.5 for i in range(len(bars))})
   438	        a = WyckoffEngineV4().run_full(bars, **kw)
   439	        b = WyckoffEngineV4().run_full(bars, **kw)
   440	        assert json.dumps(a, sort_keys=True, default=str) == json.dumps(
   441	            b, sort_keys=True, default=str)
   442
   443	    def test_e09_stack_replay_is_deterministic(self):
   444	        bars = lcg_window(45)
   445	        swings = [{"type": "HH", "idx": 10, "confirmed_at_idx": 11},
   446	                  {"type": "HL", "idx": 20, "confirmed_at_idx": 21}]
   447	        a = run_e09(bars, atr=ATR, swings=swings)
   448	        b = run_e09(bars, atr=ATR, swings=swings)
   449	        assert json.dumps(a, sort_keys=True, default=str) == json.dumps(
   450	            b, sort_keys=True, default=str)

