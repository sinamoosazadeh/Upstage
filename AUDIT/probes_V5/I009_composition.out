    58	def lcg_window(n, seed=271, base=615.0, span=3.0):
    59	    """A deterministic closed-candle window inside a tight range."""
    60	    bars = []
    61	    x = seed
    62	    price = base
    63	    for i in range(n):
    64	        x = (1103515245 * x + 12345) % (2 ** 31)
    65	        u = x / 2 ** 31
    66	        o = price + (u - 0.5) * span
    67	        c = o + (u - 0.5) * span * 0.5
    68	        h = max(o, c) + span * 0.2
    69	        l = min(o, c) - span * 0.2
    70	        bars.append({"ts": AS_OF_MS + i * 3600000, "o": o, "h": h, "l": l,
    71	                     "c": c, "v": 1000.0, "is_closed": True})
    72	        price = c
    73	    return bars
    74
    75
    76	BARS = lcg_window(60)   # E10's §5.2 Q1 warmup floor needs >= 60 bars
    77
    78
    79	def obs_window(bars, symbol="BTCUSDT", timeframe="1h"):
    80	    out = []
    81	    for i, b in enumerate(bars):
    82	        dt = datetime.datetime.fromtimestamp(b["ts"] / 1000,
    83	                                             tz=datetime.timezone.utc)
    84	        out.append(MarketObservation(
    85	            symbol=symbol, timeframe=timeframe,
    86	            open=Decimal(repr(b["o"])), high=Decimal(repr(b["h"])),
    87	            low=Decimal(repr(b["l"])), close=Decimal(repr(b["c"])),
    88	            volume=Decimal(repr(b["v"])), oi=None,
    89	            timestamp=dt.strftime("%Y-%m-%dT%H:%M:%S.") + "000Z",
    90	            sequence=i, status="CLOSED"))
    91	    return out
    92
    93
    94	def e12_candles(bars):
    95	    return [{"ts": b["ts"], "H": b["h"], "L": b["l"], "C": b["c"],
    96	             "V": b["v"], "availability_time_ms": b["ts"]} for b in bars]
    97
    98
    99	def ic(i):
   100	    """Non-degenerate ic_inputs: every §3.1 sigmoid/min-max window sees
   101	    varying history (a constant window fails closed by design)."""
   102	    return {"trendiness_raw": 0.4 + 0.005 * (i % 7),
   103	            "vol_ratio": 1.0 + 0.01 * (i % 5),
   104	            "expansion_raw": 0.3 + 0.01 * (i % 6),
   105	            "level_density": 0.5 + 0.01 * (i % 4),
   106	            "participation_raw": 0.3 + 0.01 * (i % 5),
   107	            "structure_score": 0.5 + 0.01 * (i % 3),
   108	            "momentum_state_raw": "NEUTRAL",
   109	            "bias_per_TF": {"H4": 0.1, "H1": 0.1, "M15": 0.1},
   110	            "atr_z": 0.01 * (i % 3)}
   111
   112
   113	def e11_candles(bars):
   114	    out = []
   115	    for i, b in enumerate(bars):
   116	        out.append({"o": b["o"], "h": b["h"], "l": b["l"], "c": b["c"],
   117	                    "v": b["v"], "ts": b["ts"], "as_of": b["ts"],
   118	                    "symbol": "BTCUSDT", "timeframe": "1h",
   119	                    "ic_inputs": ic(i)})
   120	    return out
   121
