    64
    65	def lcg_window(n, seed=271, base=615.0, span=3.0):
    66	    """A deterministic closed-candle window inside a tight range."""
    67	    bars = []
    68	    x = seed
    69	    price = base
    70	    for i in range(n):
    71	        x = (1103515245 * x + 12345) % (2 ** 31)
    72	        u = x / 2 ** 31
    73	        o = price + (u - 0.5) * span
    74	        c = o + (u - 0.5) * span * 0.5
    75	        h = max(o, c) + span * 0.2
    76	        l = min(o, c) - span * 0.2
    77	        bars.append({"ts": AS_OF_MS + i * 3600000, "o": o, "h": h, "l": l,
    78	                     "c": c, "v": 1000.0, "is_closed": True})
    79	        price = c
    80	    return bars
    81
    82
    83	def obs_window(bars, symbol="BTCUSDT", timeframe="1h"):
    84	    """Closed-candle window on the catalog surface, timestamped from each
    85	    bar's own ``ts`` so the PIT filters see the real timeline."""
    86	    import datetime
    87	    out = []
    88	    for i, b in enumerate(bars):
    89	        dt = datetime.datetime.fromtimestamp(b["ts"] / 1000,
    90	                                             tz=datetime.timezone.utc)
    91	        out.append(MarketObservation(
    92	            symbol=symbol, timeframe=timeframe,
    93	            open=Decimal(repr(b["o"])), high=Decimal(repr(b["h"])),
    94	            low=Decimal(repr(b["l"])), close=Decimal(repr(b["c"])),
    95	            volume=Decimal(repr(b["v"])), oi=None,
    96	            timestamp=dt.strftime("%Y-%m-%dT%H:%M:%S.") + "000Z",
    97	            sequence=i, status="CLOSED"))
    98	    return out
    99
   100
   101	def po3_confirmations(t0=AS_OF_MS):
   102	    return [{"cid": cid, "t_confirm_ms": t0 + 900000 * (i + 1),
   103	             "p_confirm": 604.0 + i}
   104	            for i, cid in enumerate(["sweep", "choch", "bos", "fvg",
   105	                                     "vol_confirm"])]
   106
   107
   108	def bundle_from(conf, avg_q=0.9, mtf_align=1.0, direction="UP",
   109	                temporal_provider=None, framework="RTM.PO3.v1"):
   110	    exp = expected_components(framework)
   111	    om = build_order_map(exp, conf)
   112	    order = [c["cid"] for c in conf]
   113	    from apex.engines.e07_rtm import evaluate_order_ok
   114	    evaluate_order_ok(exp, order, om)
   115	    kz = utc_activity_window_check(conf[-1]["t_confirm_ms"],
   116	                                   temporal_provider=temporal_provider)
   117	    return build_bundle_pipeline(exp, order, om, avg_q, mtf_align, kz,
   118	                                 framework, direction, conf[-1]["t_confirm_ms"])
