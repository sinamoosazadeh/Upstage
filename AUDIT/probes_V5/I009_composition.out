  1387	class E12TemporalEngine(EngineBase):
  1388	    """E12_Temporal_Context on the frozen EngineBase contract (v4.0.0).
  1389
  1390	    ``compute(symbol, timeframe, as_of, context)``; consumed context keys:
  1391	      ``candles``    — §8.1 candle dicts (``ts``, ``H/L/C/V``,
  1392	                       ``availability_time_ms``) — authoritative
  1393	      ``window``/``provider`` — MarketObservation fallback
  1394	      ``econ_calendar`` — red-day set (None ⇒ EV_TMP_008, conservative)
  1395	      ``rollover_windows``, ``temporal_window_levels``, ``profile``,
  1396	      ``profile_inputs``, ``e12_params`` — §6 overrides (unknown rejected)
  1397	    Emits one EvidenceEvent per §5.4 catalog row on the final state, on
  1398	    ``evidence.E12.{condition_state}``.  Context only: ``direction = 0``
  1399	    (NG — E12 outputs are Context, never signals or permissions)."""
  1400
  1401	    engine_id = ENGINE_ID
  1402	    analyst_version = ANALYST_VERSION
  1403	    code_revision = "0" * 40
  1404
  1405	    _CONF_BY_Q = {"Q4": 1.0, "Q3": 0.8, "Q2": 0.6, "Q1": 0.3,
  1406	                  "Q0": 0.0, "QX": 0.0}
  1407
  1408	    def compute(self, symbol: str, timeframe: str, as_of: str,
  1409	                context: Optional[Dict[str, Any]] = None
  1410	                ) -> List[EvidenceEvent]:
  1411	        context = context or {}
  1412	        candles = self._resolve_candles(symbol, timeframe, as_of, context)
  1413	        if not candles:
  1414	            return []
  1415	        result = run_engine(
  1416	            candles, params=context.get("e12_params"),
  1417	            econ_calendar=context.get("econ_calendar"),
  1418	            rollover_windows=context.get("rollover_windows"),
  1419	            temporal_window_levels=context.get("temporal_window_levels"),
  1420	            profile=context.get("profile"),
  1421	            profile_inputs=context.get("profile_inputs"))
  1422	        self._last_result = result
  1423	        state = result["temporal_state"]
  1424	        rows = catalog_events(state)
  1425	        if not rows:
  1426	            return []                        # QX/Q0 refusal — nothing built
  1427	        quality = self._window_quality(candles)
  1428	        return [self._to_evidence(item, symbol, timeframe, quality, state,
  1429	                                  result) for item in rows]
  1430
  1431	    def _resolve_candles(self, symbol: str, timeframe: str, as_of: str,
  1432	                         context: Dict[str, Any]) -> List[Dict[str, Any]]:
  1433	        candles = context.get("candles")
  1434	        if candles is not None:
  1435	            return list(candles)
  1436	        window = context.get("window")
  1437	        if window is None:
  1438	            provider = context.get("provider")
  1439	            if provider is None:
  1440	                raise ValueError("MISSING_WINDOW_CONTEXT_QX")

===== apex/engines/e07_rtm/engine.py:1247-1266 (baseline supplied-window resolution) =====
  1247	    def _resolve_window(self, symbol: str, timeframe: str, as_of: str,
  1248	                        context: Dict[str, Any]) -> List[MarketObservation]:
  1249	        window = context.get("window")
  1250	        if window is not None:
  1251	            return list(window)
  1252	        provider = context.get("provider")
  1253	        if provider is None:
  1254	            raise ValueError("MISSING_WINDOW_CONTEXT_QX")
  1255	        import asyncio
  1256	        import inspect
  1257	        bars = context.get("bars", 300)
  1258	        result = provider.get_window(symbol, timeframe, as_of, bars)
  1259	        if inspect.isawaitable(result):
  1260	            try:
  1261	                asyncio.get_running_loop()
  1262	            except RuntimeError:
  1263	                return list(asyncio.run(result))
  1264	            raise ValueError("MISSING_WINDOW_CONTEXT_QX (async provider inside "
