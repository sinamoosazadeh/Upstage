   320	class TestCP5EmissionsInsertIntoStore:
   321	    def _events(self):
   322	        window = obs_window(BARS)
   323	        evs = []
   324	        evs += E10MomentumEngine().compute("BTCUSDT", "1h", AS_OF,
   325	                                           {"window": window})
   326	        evs += E11RegimeEngine().compute(
   327	            "BTCUSDT", "1h", AS_OF,
   328	            {"candles": e11_candles(BARS), "W": np.zeros((9, 8)),
   329	             "b": np.zeros(9)})
   330	        evs += E12TemporalEngine().compute(
   331	            "BTCUSDT", "1h", AS_OF,
   332	            {"candles": e12_candles(BARS), "econ_calendar": set()})
   333	        return evs
   334
   335	    def test_all_three_engines_insert(self):
   336	        evs = self._events()
   337	        assert {ev.engine_id for ev in evs} == {"E10", "E11", "E12"}
   338	        for ev in evs:
   339	            ev.validate_24_fields()
   340	            assert ev.direction in (-1, 0, 1)
   341	            if ev.engine_id in ("E11", "E12"):
   342	                assert ev.direction == 0        # context engines (NG1)
   343
   344	        async def scenario():
   345	            store = SQLiteStore(path=":memory:")
   346	            await store.open()
   347	            try:
   348	                for ev in evs[:40]:
   349	                    await store.insert_evidence(ev)
   350	                cur = await store.db.execute(
   351	                    "SELECT COUNT(*) FROM evidence_event")
   352	                count = (await cur.fetchone())[0]
   353	                cur = await store.db.execute(
   354	                    "SELECT DISTINCT engine_id FROM evidence_event "
   355	                    "ORDER BY engine_id")
   356	                return count, [r[0] for r in await cur.fetchall()]
   357	            finally:
   358	                await store.close()
   359
   360	        count, engines = asyncio.run(scenario())
   361	        assert count == min(40, len(evs))
   362	        assert set(engines) <= {"E10", "E11", "E12"} and engines
   363
   364	    def test_duplicate_snapshot_insert_is_rejected_by_the_ddl(self):
   365	        ev = self._events()[0]
