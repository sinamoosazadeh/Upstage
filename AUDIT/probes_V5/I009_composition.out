   153	        info = utc_activity_window_check(AS_OF_MS, temporal_provider=prov)
   154	        assert info["degraded"] is False and info["degraded_reason"] is None
   155	        assert info["source"] == E12_CONTRACT == \
   156	            "E12_Temporal_Context.Contract v4.0.0"
   157	        assert info["config_version"] == "v2024a"
   158	        assert info["which"] == ["UTC_W2", "UTC_W1_W2_OVERLAP"]
   159	        assert info["utc_activity_window"] == "UTC_W2"
   160	        assert info["is_overlap"] is True and info["in_kz"] is True
   161
   162	    def test_degraded_mode_unchanged_without_provider(self):
   163	        info = utc_activity_window_check(AS_OF_MS)
   164	        assert info["degraded"] is True
   165	        assert info["degraded_reason"] == E12_UNAVAILABLE_REASON
   166	        assert info["source"] == "E07_LOCAL_NON_AUTHORITATIVE"
