   289	class TestTDR001CP5:
   290	    def test_double_run_byte_identical_all_engines(self):
   291	        window = obs_window(BARS)
   292	        e12c = e12_candles(BARS)
   293	        e11c = e11_candles(BARS)
   294	        for build in (
   295	            lambda: run_e10(BARS, symbol="BTCUSDT", interval="1h"),
   296	            lambda: run_e11(e11c, W=np.zeros((9, 8)), b=np.zeros(9),
   297	                            symbol="BTCUSDT", timeframe="1h"),
   298	            lambda: run_e12(e12c, econ_calendar=set()),
   299	        ):
   300	            a, b = build(), build()
   301	            assert canonical_json(a) == canonical_json(b)
   302	        # EngineBase surfaces are deterministic too
   303	        for eng, ctx in (
   304	            (E10MomentumEngine(), {"window": window}),
   305	            (E11RegimeEngine(), {"candles": e11c, "W": np.zeros((9, 8)),
   306	                                 "b": np.zeros(9)}),
   307	            (E12TemporalEngine(), {"candles": e12c, "econ_calendar": set()}),
   308	        ):
   309	            ev_a = eng.compute("BTCUSDT", "1h", AS_OF, context=ctx)
   310	            ev_b = eng.compute("BTCUSDT", "1h", AS_OF, context=ctx)
   311	            assert [e.snapshot_id for e in ev_a] == \
   312	                [e.snapshot_id for e in ev_b]
   313	            assert [e.condition_state for e in ev_a] == \
   314	                [e.condition_state for e in ev_b]
