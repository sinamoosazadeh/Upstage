   121	class StubE12:
   122	    """The versioned ``E12_Temporal_Context.Contract v4.0.0`` surface.
   123
   124	    A stub, not E12: CP-4 ships E07's *contract-conformant* branch so the
   125	    degraded path is provably distinguishable; the real engine lands at CP-5.
   126	    """
   127
   128	    config_version = "E12-WINDOWS-CORRECTED-v1"
   129
   130	    def __init__(self, is_overlap=True, raise_=False):
   131	        self.is_overlap = is_overlap
   132	        self.raise_ = raise_
   133	        self.calls = []
   134
   135	    def temporal_window(self, ts_ms):
   136	        self.calls.append(ts_ms)
   137	        if self.raise_:
   138	            raise RuntimeError("E12 unavailable")
   139	        which = ["UTC_W2", "UTC_W1_W2_OVERLAP"] if self.is_overlap else ["UTC_W1"]
   140	        return {"which": which, "is_overlap": self.is_overlap,
   141	                "utc_activity_window": "UTC_W2" if self.is_overlap else "UTC_W1",
   142	                "config_version": self.config_version}
   143
