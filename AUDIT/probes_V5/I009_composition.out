    53	AS_OF = "2026-01-15T14:00:00Z"          # inside the 12:30–16:00 overlap
    54	AS_OF_MS = 1768485600000                # == 2026-01-15T14:00:00Z exactly
    55	MORNING_MS = 1768485600000 - 5 * 3600000  # 09:00Z ⇒ UTC_W1, no overlap
