  1427	def e11_snapshot_id(payload: Dict[str, Any]) -> str:
  1428	    """§5.3 canonical snapshot identity (global contract delegation)."""
  1429	    return canonical_snapshot_id(ENGINE, CONTRACT_VERSION, payload)
