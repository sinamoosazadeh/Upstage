  1340	# E07 provider surface — the versioned contract consumed by
  1341	# E07 ``utc_activity_window_check`` (ISSUE-CP4-005 resolved branch)
  1342	# ---------------------------------------------------------------------------
  1343	class E12TemporalProvider:
  1344	    """``E12_Temporal_Context.Contract v4.0.0`` provider for E07 §3.6.
  1345
  1346	    ``temporal_window(ts_ms) -> {"which": [...], "is_overlap": bool,
  1347	    "utc_activity_window": str, "config_version": str}`` where ``which`` =
  1348	    the primary window plus the derived ``UTC_W1_W2_OVERLAP`` label — the
  1349	    same list semantics E07's degraded local branch uses, but authoritative
  1350	    (E12 owns the registry).  Matching core windows ride along in the
  1351	    separate ``core_windows`` key (E07's degraded branch keeps them separate
  1352	    too, so both modes stay comparable)."""
  1353
  1354	    contract = E07_CONTRACT_LABEL
  1355
  1356	    def __init__(self, params: Optional[EngineParams] = None,
  1357	                 rollover_windows: Optional[Sequence[Dict[str, Any]]] = None,
  1358	                 econ_calendar: Optional[Any] = None) -> None:
  1359	        self.params = params or EngineParams()
  1360	        self.config_version = str(
  1361	            self.params.temporal_window_calendar_version)
  1362	        self.rollover_windows = list(rollover_windows or [])
  1363	        self.econ_calendar = econ_calendar
  1364
  1365	    def temporal_window(self, ts_ms: Any) -> Dict[str, Any]:
  1366	        ts = ts_from_ms(ts_ms)
  1367	        ctx = utc_activity_window_of(ts, self.rollover_windows)
  1368	        h = hour_float(ts)
  1369	        which: List[str] = [ctx["temporal_window"]]
  1370	        if ctx["is_overlap"]:
  1371	            which.append(OVERLAP_LABEL)
  1372	        core = [name for name, (lo, hi) in UTC_CORE_WINDOWS.items()
  1373	                if lo <= h < hi]
  1374	        return {"which": which,
  1375	                "core_windows": core,
  1376	                "is_overlap": bool(ctx["is_overlap"]),
  1377	                "utc_activity_window": ctx["temporal_window"],
  1378	                "window_phase": ctx["window_phase"],
  1379	                "day_type": day_type(ts, self.econ_calendar),
  1380	                "rollover_active": bool(ctx["rollover_active"]),
  1381	                "config_version": self.config_version}
  1382
