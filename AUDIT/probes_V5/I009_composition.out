  1451	class E11RegimeEngine(EngineBase):
  1452	    """E11_Regime on the frozen EngineBase contract (v4.0.0).
  1453
  1454	    ``compute(symbol, timeframe, as_of, context)``; consumed context keys:
  1455	      ``candles``   — §4 candle dicts with ``ic_inputs`` (authoritative)
  1456	      ``window`` / ``provider`` — MarketObservation fallback (ic_inputs per
  1457	                      candle via ``ic_inputs_list`` when supplied)
  1458	      ``W``, ``b``  — trained classifier tensors (None ⇒ fail-closed
  1459	                      EV_RGM_007 at update time — no uniform fallback)
  1460	      ``T``, ``history``, ``mu0``, ``Sigma0``, ``prev_mom``, ``base_rates``
  1461	      ``e11_params`` — §6 overrides (unknown keys rejected)
  1462	      ``live_regime_gate`` — default False (Phase-7 + Owner approval)
  1463	      ``forecast`` / ``next_regime`` / ``adaptive_atr`` — Wave-Out ⇒ raise
  1464	    Emits one EvidenceEvent per §5.4 catalog event on the final state, on
  1465	    ``evidence.E11.{condition_state}``. Context only: ``direction = 0``
  1466	    (NG1 — regime is a veto/context input, never a standalone mandate).
  1467	    """
  1468
  1469	    engine_id = "E11"
  1470	    analyst_version = ANALYST_VERSION
  1471	    code_revision = "0" * 40
  1472
  1473	    _CONF_BY_Q = {"Q5": 1.0, "Q4": 0.9, "Q3": 0.7, "Q2": 0.5, "Q1": 0.3,
  1474	                  "Q0": 0.0, "QX": 0.0}
  1475
  1476	    def compute(self, symbol: str, timeframe: str, as_of: str,
  1477	                context: Optional[Dict[str, Any]] = None
  1478	                ) -> List[EvidenceEvent]:
  1479	        context = context or {}
  1480	        if context.get("forecast") or context.get("next_regime"):
  1481	            forecast_next_regime()           # raises WaveOutError
  1482	        if context.get("adaptive_atr") or context.get("adaptive_period"):
  1483	            raise wave_out("adaptive_atr_e04_e11",
  1484	                           "ADAPTIVE_ATR_WAVE_OUT: adaptive ATR E04↔E11 is "
  1485	                           "Wave-Out (§9.5-9) — raise, never build.")
  1486	        candles = self._resolve_candles(symbol, timeframe, as_of, context)
  1487	        if not candles:
  1488	            return []
  1489	        result = run_engine(
  1490	            candles, params=context.get("e11_params"),
  1491	            W=context.get("W"), b=context.get("b"), T=context.get("T"),
  1492	            history=context.get("history"), mu0=context.get("mu0"),
  1493	            Sigma0=context.get("Sigma0"), prev_mom=context.get(
  1494	                "prev_mom", 0.5),
  1495	            base_rates=context.get("base_rates"), symbol=symbol,
  1496	            timeframe=timeframe,
  1497	            live_regime_gate=bool(context.get("live_regime_gate", False)),
  1498	            classifier_artifact_sha256=context.get("classifier_artifact_sha256"))
  1499	        self._last_result = result
  1500	        state = result["regime_state"]
  1501	        if "snapshot_id" not in state:
  1502	            return []                        # QX/Q0 refusal — nothing built
  1503	        quality = self._window_quality(candles)
  1504	        # CP-14.5 C3: resolve the governed EngineParams ONCE, here, with the
  1505	        # same rule run_engine applies (an EngineParams passes through, any
  1506	        # other value is an override dict for get_params), and hand them to
  1507	        # catalog_events. Values are unchanged — no numeric path is touched.
  1508	        e11_params = context.get("e11_params")
  1509	        params = (e11_params if isinstance(e11_params, EngineParams)
  1510	                  else get_params(e11_params))
  1511	        return [self._to_evidence(item, symbol, timeframe, quality, state,
  1512	                                  result)
  1513	                for item in catalog_events(state, params)]
  1514
  1515	    def _resolve_candles(self, symbol: str, timeframe: str, as_of: str,

===== apex/engines/e12_temporal/engine.py:1214-1440 (baseline) =====
  1214	def run_engine(candles: Sequence[Dict[str, Any]],
  1215	               params: Optional[Dict[str, Any]] = None,
  1216	               econ_calendar: Optional[Any] = None,
  1217	               rollover_windows: Optional[Sequence[Dict[str, Any]]] = None,
  1218	               temporal_window_levels: Optional[Dict[str, Any]] = None,
  1219	               profile: Optional[Dict[str, Any]] = None,
  1220	               profile_inputs: Optional[Dict[str, Any]] = None,
  1221	               events: Optional[List[Dict[str, Any]]] = None
  1222	               ) -> Dict[str, Any]:
  1223	    """Stream ``candles`` through E12 and journal every §5.4 event.
  1224
  1225	    ``econ_calendar=None`` ⇒ HIGH_IMPACT is impossible and EV_TMP_008
  1226	    (Calendar_Unavailable) is emitted once — §8.3 conservative flagging.
  1227	    ``profile`` (pre-built) or ``profile_inputs`` (kwargs for
  1228	    ``compute_temporal_profile``, ``as_of`` filled from the last candle)
  1229	    attach the §5.3 profile ⇒ EV_TMP_006."""
  1230	    p = get_params(params)
  1231	    eng = TemporalWindowEngineStream(behavior_window=int(p.behavior_window),
  1232	                                     min_samples=int(p.daytype_min_samples),
  1233	                                     params=p,
  1234	                                     rollover_windows=rollover_windows,
  1235	                                     n_bins=int(p.fff_bins))
  1236	    journal: List[Dict[str, Any]] = list(events or [])
  1237	    if econ_calendar is None:
  1238	        journal.append({"code": "EV_TMP_008", "as_of": 0,
  1239	                        "reason": "ECON_CALENDAR_NOT_PROVIDED"})
  1240	    if temporal_window_levels is not None:
  1241	        eng.attach_levels(temporal_window_levels)
  1242	        journal.append({"code": "EV_TMP_007", "as_of": 0,
  1243	                        "levels_contract": "TemporalWindowLevels_v4"})
  1244	    if profile is not None:
  1245	        eng.attach_profile(profile)
  1246	        journal.append({"code": "EV_TMP_006",
  1247	                        "as_of": int(profile.get("as_of", 0)),
  1248	                        "quality": profile.get("quality")})
  1249	    prev_window: Optional[str] = None
  1250	    prev_phase: Optional[str] = None
  1251	    prev_dtype: Optional[str] = None
  1252	    prev_overlap = False
  1253	    last_state: Optional[Dict[str, Any]] = None
  1254	    for candle in candles:
  1255	        st = eng.on_candle(candle, econ_calendar)
  1256	        as_of = int(st.get("as_of", 0))
  1257	        if st["quality"] == "QX":
  1258	            last_state = st
  1259	            continue
  1260	        if st["quality"] == "Q0":
  1261	            journal.append({"code": "EV_TMP_009", "as_of": as_of,
  1262	                            "reason": st.get("reason"),
  1263	                            "snapshot_id": st["snapshot_id"]})
  1264	            last_state = st
  1265	            continue
  1266	        window = st["temporal_window"]
  1267	        if prev_window is None:
  1268	            journal.append({"code": "EV_TMP_001", "as_of": as_of,
  1269	                            "window": window})
  1270	        elif window != prev_window:
  1271	            journal.append({"code": "EV_TMP_002", "as_of": as_of,
  1272	                            "window": prev_window})
  1273	            journal.append({"code": "EV_TMP_001", "as_of": as_of,
  1274	                            "window": window})
  1275	        if st["is_overlap"] and not prev_overlap:
  1276	            journal.append({"code": "EV_TMP_003", "as_of": as_of,
  1277	                            "window": window})
  1278	        if prev_phase is not None and st["window_phase"] != prev_phase:
  1279	            journal.append({"code": "EV_TMP_004", "as_of": as_of,
  1280	                            "from": prev_phase, "to": st["window_phase"]})
  1281	        if prev_dtype is not None and st["day_type"] != prev_dtype:
  1282	            journal.append({"code": "EV_TMP_005", "as_of": as_of,
  1283	                            "from": prev_dtype, "to": st["day_type"]})
  1284	        prev_window, prev_phase = window, st["window_phase"]
  1285	        prev_dtype, prev_overlap = st["day_type"], bool(st["is_overlap"])
  1286	        last_state = st
  1287	    if profile_inputs and profile is None and last_state is not None:
  1288	        inputs = dict(profile_inputs)
  1289	        inputs.setdefault("as_of", int(last_state.get("as_of", 0)))
  1290	        inputs.setdefault("min_samples", int(p.daytype_min_samples))
  1291	        inputs.setdefault("n_bins", int(p.fff_bins))
  1292	        inputs.setdefault("fourier_k", int(p.fff_fourier_K))
  1293	        built = compute_temporal_profile(params=p, **inputs)
  1294	        eng.attach_profile(built)
  1295	        journal.append({"code": "EV_TMP_006",
  1296	                        "as_of": int(built["as_of"]),
  1297	                        "quality": built["quality"]})
  1298	        profile = built
  1299	    return {
  1300	        "temporal_state": last_state,
  1301	        "temporal_profile": profile,
  1302	        "events": journal,
  1303	        "engine": ENGINE,
  1304	        "contract_version": CONTRACT_VERSION,
  1305	        "config_version": str(p.temporal_window_calendar_version),
  1306	        "n_candles": len(eng.buffer),
  1307	    }
  1308
