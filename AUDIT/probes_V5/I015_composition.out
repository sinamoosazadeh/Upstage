    64	class TestTNFR004QueueBounds:
    65	    def test_all_p0_delivered_and_p2_evicted(self, report):
    66	        queue = report["t_nfr_004"]
    67	        assert queue["p0_delivered"] == 2000
    68	        assert queue["all_p0_processed"] is True
    69	        assert queue["p2_published"] == 1000
    70	        assert queue["some_p2_evicted"] is True
    71	        assert queue["p2_evicted"] > 0
    72	        assert queue["eviction_reason"] == "QUEUE_OVERFLOW_DROP"
    73
    74	    def test_the_shared_lane_never_exceeds_its_governed_bound(self, report):
    75	        queue = report["t_nfr_004"]
    76	        assert queue["bounded"] is True
    77	        assert queue["lane_qsize"] <= 1000
