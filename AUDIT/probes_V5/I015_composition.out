    30	@pytest.fixture(scope="module")
    31	def report(harness):
    32	    import os
    33	    saved = {name: os.environ.get(name) for name in harness.HARNESS_ENV}
    34	    try:
    35	        yield harness.run_harness(decisions=10, orders=5, minutes=0.0)
    36	    finally:
    37	        # run_harness setdefault's APEX_ENV=PAPER. Restore so the rest of the
    38	        # suite does not inherit that process environment.
    39	        for name, previous in saved.items():
    40	            if previous is None:
    41	                os.environ.pop(name, None)
    42	            else:
    43	                os.environ[name] = previous
