   104	def _analysis_latency(samples: int) -> Dict[str, Any]:
   105	    """T-NFR-001: time the in-repo decision path on synthetic context input."""
   106	    from apex.decision.pipeline import build_proposal
   107	    from apex.risk.kernel import adjudicate
   108
   109	    proposal_input = {
   110	        "setup_id": "SF_FVG_SWEEP_REV-0001", "direction": "LONG",
   111	        "entry_logic_ref": "E-05/FVG", "stop": 99.0, "targets": (103.0,),
   112	        "p_hat": 0.6, "u": 0.2, "c": 0.7, "conflict_state": "CONSENSUS",
   113	        "snapshot_id": "sn-nfr-0001", "r_penalty": 0.10, "cost_unit": 0.05,
   114	        "entry": 100.0}
   115	    adjudication_input = {
   116	        "snapshot_id": "sn-nfr-0001", "timeframe": "15m", "capital": 10_000.0,
   117	        "q_raw": 0.9, "qx_state": False, "failed_setup_gate": False,
   118	        "pit_violation": False, "availability_time": 1,
   119	        "portfolio_exposure": 100.0, "proposed_notional": 50.0,
   120	        "capital_hard_cap": 1_000_000.0, "circuit_breaker_engaged": False,
   121	        "emergency_state": "NORMAL", "per_symbol_exposure": 100.0,
   122	        "symbol_cap": 1_000.0, "portfolio_cap": 1_000_000.0,
   123	        "conflict_state": "CONSENSUS", "staleness_seconds": 1.0,
   124	        "freshness_sla_seconds": 30.0, "oi_lag_seconds": 5.0,
   125	        "oi_lag_threshold_seconds": 60.0, "is_risk_increase": False,
   126	        "uncertainty_is_rising": False, "realized_daily_loss_fraction": 0.0,
   127	        "realized_weekly_loss_fraction": 0.0, "consecutive_losses": 0,
   128	        "time_to_expiry_days": 40.0, "margin_health_fraction": 0.9,
   129	        "stop_distance": 1.0, "min_quantity": 0.001, "risk_state": "LowRisk"}
   130	    timings: List[float] = []
   131	    for _ in range(int(samples)):
   132	        start = time.perf_counter()
   133	        build_proposal(**proposal_input)
   134	        adjudicate(adjudication_input)
   135	        timings.append((time.perf_counter() - start) * 1000.0)
   136	    p95 = percentile(timings, 0.95)
   137	    return {"samples": len(timings), "p95_ms": p95, "max_ms": max(timings),
   138	            "median_ms": percentile(timings, 0.50),
   139	            "bound_ms": ANALYSIS_P95_MS, "within_bound": p95 <= ANALYSIS_P95_MS,
   140	            "label": "SANDBOX-PARTIAL",
   141	            "owner_gate": "AI.10 rule 5 — target device, 30 % headroom"}
   142
