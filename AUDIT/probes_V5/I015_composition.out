    79	    def test_p0_delivery_is_synchronous_not_buffered(self, harness):
    80	        import asyncio
    81
    82	        from apex.bus import EventBus, Priority, make_event
    83
    84	        bus = EventBus()
    85	        seen = []
    86
    87	        async def consumer(event):
    88	            seen.append(event.payload["i"])
    89
    90	        bus.subscribe("t", consumer)
    91
    92	        async def _flow():
    93	            for i in range(5):
    94	                await bus.publish(make_event(Priority.P0, "t", {"i": i}))
    95	            # no dispatcher was ever started: P0 must already be delivered
    96	            return bus.counts["p0_delivered"]
    97
    98	        assert asyncio.run(_flow()) == 5
    99	        assert seen == [0, 1, 2, 3, 4]
