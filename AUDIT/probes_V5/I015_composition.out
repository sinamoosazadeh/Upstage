    41	#: AI.7 bounds (never re-tuned here).
    42	ANALYSIS_P95_MS = 400.0
    43	SUBMISSION_P95_MS = 200.0
    44	CPU_PERCENT_MAX = 20.0
    45	MEMORY_MB_MAX = 400.0
    46
    47	HARNESS_ENV = {
    48	    "APEX_ENV": "PAPER",
    49	    "APEX_ALLOW_SIGNED": "1",
    50	    "TOOBIT_API_KEY": "TEST_KEY_CP8_NFR",
    51	    "TOOBIT_API_SECRET": "TEST_SECRET_CP8_NFR",
