=== Baseline EventBus queue and eviction implementation ===
     1	"""APEX_GEN5 in-process event bus.
     2
     3	Blueprint: §9.5-10 ("Event bus = in-process asyncio.Queue only"), AI.12 Phase
     4	3 (evidence event bus: "Message ordering preserved; no event loss; P0/P1
     5	priority honored; No buffering of critical events; P0 = synchronous"),
     6	Ch.23/AI.8 alert priorities and queue behavior.
     7
     8	Law implemented here:
     9	- In-process ``asyncio.Queue`` ONLY. A networked bus is Wave-Out (§9.5-9).
    10	- Priorities P0..P3 (Ch.23): P0 capital/emergency alerts; P1 major setup,
    11	  forecast update, risk escalation; P2 routine features/patterns; P3
    12	  research/archived outcomes.
    13	- P0 is SYNCHRONOUS: delivered inline by awaiting every subscriber in
    14	  publish order — never queued, never dropped, never buffered.
    15	- P1 has a dedicated FIFO lane; P2/P3 share one FIFO lane. Ordering is
    16	  preserved per lane.
    17	- P0/P1 are never dropped, even when lanes are full: the oldest P3/P2 item
    18	  is evicted to make room (eviction logged with reason and timestamp).
    19	- The inbound raw-candle queue holds 1000 items; on overflow there is NO
    20	  backpressure — the oldest item is dropped and QUEUE_OVERFLOW_DROP is
    21	  logged (AI.9).
    22	- Ledger writes are synchronous (AI.8): the ledger writer consumes its
    23	  callback inline; a write failure halts execution (CP-7 owns the writer).
    24	"""
    25
    26	from __future__ import annotations
    27
    28	import asyncio
    29	import itertools
    30	import time
    31	from dataclasses import dataclass, field
    32	from enum import IntEnum
    33	from typing import Any, Awaitable, Callable, Deque, Dict, List, Tuple
    34
    35	from apex.identity.uuid_v7 import uuid_v7
    36
    37	P0 = 0
    38	P1 = 1
    39	P2 = 2
    40	P3 = 3
    41
    42	# Governed lane bounds (AI.7/AI.9): shared lane capacity; raw-candle queue.
    43	DEFAULT_LANE_MAXSIZE = 1000
    44	RAW_CANDLE_QUEUE_MAXSIZE = 1000  # Ch.23/AI.9: 1000 items, no backpressure
    45
    46
    47	class Priority(IntEnum):
    48	    P0 = 0
    49	    P1 = 1
    50	    P2 = 2
    51	    P3 = 3
    52
    53
    54	@dataclass(frozen=True)
    55	class BusEvent:
    56	    priority: int          # P0..P3
    57	    topic: str             # routing label (e.g. 'evidence.E01.BOS')
    58	    payload: Any           # event body (dict/object); not mutated by the bus
    59	    event_id: str          # UUIDv7 operational identity (never in snapshots)
    60	    created_at: float      # UTC epoch seconds (operational only)
    61
    62
    63	Consumer = Callable[[BusEvent], Awaitable[None]]
    64
    65
    66	def make_event(priority: int, topic: str, payload: Any) -> BusEvent:
    67	    """Construct a BusEvent with a fresh UUIDv7 event_id."""
    68	    return BusEvent(
    69	        priority=Priority(priority),
    70	        topic=topic,
    71	        payload=payload,
    72	        event_id=uuid_v7(),
    73	        created_at=time.time(),
    74	    )
    75
    76
    77	@dataclass(frozen=True)
    78	class EvictionRecord:
    79	    reason: str
    80	    timestamp: float
    81	    event_id: str
    82	    priority: int
    83	    topic: str
    84
    85
    86	class EventBus:
    87	    """In-process priority bus. Created per process; no network surface.
    88
    89	    ``subscribe`` registers an async consumer for a topic; ``publish``
    90	    routes by priority: P0 inline (synchronous), P1 dedicated lane, P2/P3
    91	    shared lane. A background ``dispatch`` task drains lanes FIFO.
    92	    """
    93
    94	    def __init__(self, lane_maxsize: int = DEFAULT_LANE_MAXSIZE) -> None:
    95	        self._lane_maxsize = lane_maxsize
    96	        # P1 lane: capacity-bounded ONLY by eviction pressure on the shared
    97	        # lane (Ch.23: P0/P1 are never dropped even when the queue is full).
    98	        self._p1_lane: asyncio.Queue[BusEvent] = asyncio.Queue()
    99	        self._shared_lane: asyncio.Queue[BusEvent] = asyncio.Queue(maxsize=lane_maxsize)
   100	        self._subscribers: Dict[str, List[Consumer]] = {}
   101	        self._evictions: Deque[EvictionRecord] = __import__(
   102	            "collections").deque(maxlen=4096)
   103	        self._dispatcher: asyncio.Task | None = None
   104	        self._counts: Dict[str, int] = {"p0_delivered": 0, "evicted": 0,
   105	                                        "raw_dropped": 0}
   106
   107	    # -- subscription -------------------------------------------------------
   108	    def subscribe(self, topic: str, consumer: Consumer) -> None:
   109	        """Register an async consumer. Multiple consumers per topic are
   110	        delivered in subscription order (ordering preserved)."""
   111	        self._subscribers.setdefault(topic, []).append(consumer)
   112
   113	    def unsubscribe(self, topic: str, consumer: Consumer) -> None:
   114	        subs = self._subscribers.get(topic, [])
   115	        if consumer in subs:
   116	            subs.remove(consumer)
   117
   118	    # -- publish ------------------------------------------------------------
   119	    async def publish(self, event: BusEvent) -> None:
   120	        """Route by priority.
   121
   122	        P0 (synchronous consumer law, AI.12): every subscriber is awaited
   123	        inline, in subscription order — never buffered, never dropped.
   124	        P1: dedicated lane. P2/P3: shared lane. Enqueue never raises when
   125	        full: P0/P1 evict the oldest shared-lane item; P2/P3 drop the
   126	        oldest item (QUEUE_OVERFLOW_DROP), all logged.
   127	        """
   128	        if event.priority == Priority.P0:
   129	            for consumer in self._subscribers.get(event.topic, []):
   130	                await consumer(event)  # synchronous, in publish order
   131	            self._counts["p0_delivered"] += 1
   132	            return
   133	        if event.priority == Priority.P1:
   134	            # P1 is never dropped and never blocks: when the lane is at the
   135	            # governed bound, the oldest P3/P2 item yields to make room.
   136	            if self._p1_lane.qsize() >= self._lane_maxsize:
   137	                self._evict_shared_for_critical(event)
   138	            await self._p1_lane.put(event)
   139	            return
   140	        # P2/P3 shared lane
   141	        if self._shared_lane.full():
   142	            dropped = self._shared_lane.get_nowait()
   143	            self._record_eviction("QUEUE_OVERFLOW_DROP", dropped)
   144	            self._counts["evicted"] += 1
   145	        await self._shared_lane.put(event)
   146
   147	    def _evict_shared_for_critical(self, event: BusEvent) -> None:
   148	        """P0/P1 are never dropped even when the lane is full: the oldest
   149	        P3/P2 item is evicted to make room (Ch.23 critical-alert
   150	        preservation). Eviction is logged with reason and timestamp."""
   151	        try:
   152	            victim = self._shared_lane.get_nowait()
   153	        except asyncio.QueueEmpty:
   154	            # shared lane is empty: reuse its slot by pulling nothing —
   155	            # nothing to evict; put below will fail if lane still full.
   156	            return
   157	        self._record_eviction("EVICT_FOR_CRITICAL", victim)
   158	        self._counts["evicted"] += 1
   159
   160	    def _record_eviction(self, reason: str, event: BusEvent) -> None:
   161	        self._evictions.append(EvictionRecord(
   162	            reason=reason,
   163	            timestamp=time.time(),
   164	            event_id=event.event_id,
   165	            priority=int(event.priority),
   166	            topic=event.topic,
   167	        ))
   168
   169	    # -- delivery -----------------------------------------------------------
   170	    async def dispatch(self) -> None:
   171	        """Drain lanes FIFO forever. P1 lane is drained before the shared
   172	        lane when both are non-empty; ordering within each lane is
   173	        preserved. Stop via ``stop_dispatch``."""
   174	        while True:
   175	            try:
   176	                if not self._p1_lane.empty():
   177	                    event = self._p1_lane.get_nowait()
   178	                else:
   179	                    event = self._shared_lane.get_nowait()
   180	            except asyncio.QueueEmpty:
   181	                await asyncio.sleep(0)
   182	                continue
   183	            for consumer in self._subscribers.get(event.topic, []):
   184	                await consumer(event)
   185
   186	    def start(self) -> asyncio.Task:
   187	        """Start the background dispatch task (single event loop model)."""
   188	        if self._dispatcher is None or self._dispatcher.done():
   189	            self._dispatcher = asyncio.create_task(self.dispatch())
   190	        return self._dispatcher
   191
   192	    async def stop(self) -> None:
   193	        if self._dispatcher is not None and not self._dispatcher.done():
   194	            self._dispatcher.cancel()
   195	            try:
   196	                await self._dispatcher
   197	            except asyncio.CancelledError:
   198	                pass
   199	            self._dispatcher = None
   200
   201	    # -- observability ------------------------------------------------------
   202	    @property
   203	    def eviction_log(self) -> List[EvictionRecord]:
   204	        return list(self._evictions)
   205
   206	    @property
   207	    def counts(self) -> Dict[str, int]:
   208	        return dict(self._counts)
   209
   210
   211	class RawCandleQueue:
   212	    """Inbound raw-candle queue (Ch.23/AI.9): 1000 items, NO overflow
   213	    backpressure — on overflow the OLDEST item is dropped and
   214	    QUEUE_OVERFLOW_DROP is logged. In-process asyncio.Queue only."""
   215
   216	    def __init__(self, maxsize: int = RAW_CANDLE_QUEUE_MAXSIZE) -> None:
   217	        self._queue: asyncio.Queue = asyncio.Queue(maxsize=maxsize)
   218	        self._drops: Deque[EvictionRecord] = __import__(
   219	            "collections").deque(maxlen=4096)
   220
   221	    async def put(self, candle: Any, event_id: str, topic: str) -> None:
   222	        if self._queue.full():
   223	            oldest = self._queue.get_nowait()
   224	            self._drops.append(EvictionRecord(
   225	                reason="QUEUE_OVERFLOW_DROP",
   226	                timestamp=time.time(),
   227	                event_id=getattr(oldest, "event_id", event_id),
   228	                priority=P2,
   229	                topic=topic,
   230	            ))
   231	        await self._queue.put(candle)
   232
   233	    async def get(self) -> Any:
   234	        return await self._queue.get()
   235
   236	    def qsize(self) -> int:
   237	        return self._queue.qsize()
   238
   239	    @property
   240	    def drop_log(self) -> List[EvictionRecord]:
   241	        return list(self._drops)
