   144	def _submission_latency(samples: int) -> Dict[str, Any]:
   145	    """T-NFR-002: ACK latency against the in-repo fake responder."""
   146	    from apex.config import Config
   147	    from apex.execution.toobit_adapter import ToobitAdapter
   148	    from fake_toobit_responder import FakeToobitResponder
   149
   150	    responder = FakeToobitResponder(api_key=HARNESS_ENV["TOOBIT_API_KEY"],
   151	                                    api_secret=HARNESS_ENV["TOOBIT_API_SECRET"])
   152	    adapter = ToobitAdapter(config=Config(), transport=responder)
   153	    timings: List[float] = []
   154	    for i in range(int(samples)):
   155	        start = time.perf_counter()
   156	        asyncio.run(adapter.submit_order(
   157	            intent_id=f"intent-nfr-{i:05d}", symbol="BTCUSDT", timeframe="15m",
   158	            direction="LONG", quantity=1, price=60000, order_type="LIMIT"))
   159	        timings.append((time.perf_counter() - start) * 1000.0)
   160	    p95 = percentile(timings, 0.95)
   161	    return {"samples": len(timings), "p95_ms": p95, "max_ms": max(timings),
   162	            "bound_ms": SUBMISSION_P95_MS, "within_bound": p95 <= SUBMISSION_P95_MS,
   163	            "label": "SANDBOX-PARTIAL",
   164	            "note": "in-process fake responder; the network leg is an owner "
   165	                    "measurement on the target device"}
   166
