    61	def percentile(values: List[float], fraction: float) -> float:
    62	    """Nearest-rank percentile, ``rank = ceil(p·n)`` (no interpolation)."""
    63	    if not values:
    64	        raise ValueError("EMPTY_SAMPLE")
    65	    if not 0.0 < float(fraction) <= 1.0:
    66	        raise ValueError("FRACTION_QX")
    67	    ordered = sorted(values)
    68	    rank = max(1, min(len(ordered), math.ceil(float(fraction) * len(ordered))))
    69	    return ordered[rank - 1]
    70
