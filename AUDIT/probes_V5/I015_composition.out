   168	def _resource_sample(minutes: float) -> Dict[str, Any]:
   169	    """T-NFR-003: CPU/memory sample for the requested window."""
   170	    import resource
   171
   172	    start_wall = time.perf_counter()
   173	    start_cpu = time.process_time()
   174	    deadline = start_wall + max(0.0, float(minutes)) * 60.0
   175	    while time.perf_counter() < deadline:
   176	        time.sleep(0.05)
   177	    wall = max(1e-9, time.perf_counter() - start_wall)
   178	    cpu = time.process_time() - start_cpu
   179	    peak_rss_kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
   180	    memory_mb = peak_rss_kb / 1024.0
   181	    cpu_percent = 100.0 * cpu / wall
   182	    return {"minutes": float(minutes), "cpu_percent": cpu_percent,
   183	            "cpu_bound": CPU_PERCENT_MAX,
   184	            "memory_mb": memory_mb, "memory_bound_mb": MEMORY_MB_MAX,
   185	            "within_bounds": cpu_percent <= CPU_PERCENT_MAX
   186	            and memory_mb <= MEMORY_MB_MAX,
   187	            "label": "OWNER-VERIFY",
   188	            "owner_gate": "AI.10 rule 5 — 60-minute run on the target device",
   189	            "note": "an idle sample is not the acceptance measurement"}
   190
   191
   192	def run_harness(*, decisions: int = 200, orders: int = 100,
   193	                minutes: float = 1.0) -> Dict[str, Any]:
   194	    _prepare_imports()
   195	    for name, value in HARNESS_ENV.items():
   196	        os.environ.setdefault(name, value)
   197	    report: Dict[str, Any] = {
   198	        "harness": "AI.10 NFR harness (AI.7 bounds)",
   199	        "bounds": {"analysis_p95_ms": ANALYSIS_P95_MS,
   200	                   "submission_p95_ms": SUBMISSION_P95_MS,
   201	                   "cpu_percent": CPU_PERCENT_MAX,
   202	                   "memory_mb": MEMORY_MB_MAX},
   203	        "t_nfr_004": asyncio.run(_queue_bounds_probe()),
   204	        "t_nfr_001": _analysis_latency(decisions),
   205	        "t_nfr_002": _submission_latency(orders),
   206	        "t_nfr_003": _resource_sample(minutes),
   207	    }
   208	    measured_in_bounds = (report["t_nfr_004"]["all_p0_processed"]
   209	                          and report["t_nfr_004"]["some_p2_evicted"]
   210	                          and report["t_nfr_001"]["within_bound"]
   211	                          and report["t_nfr_002"]["within_bound"])
   212	    report["sandbox_verdict"] = "MEASURED_IN_BOUNDS" if measured_in_bounds \
   213	        else "BOUND_EXCEEDED"
   214	    report["measured_in_bounds"] = measured_in_bounds
   215	    report["owner_gates_open"] = ["T-NFR-001 target device (30 % headroom)",
   216	                                  "T-NFR-002 target device (30 % headroom)",
   217	                                  "T-NFR-003 target device 60-minute run",
   218	                                  "T-TOOBIT-001 depth > 500k USDT per symbol",
   219	                                  "T-TOOBIT-002 venue rate ≤ 100 req/s"]
   220	    report["note"] = ("sandbox numbers are measurements of this repository in "
   221	                      "this environment; they are NOT target-device acceptance "
   222	                      "results (AI.10 rule 5 / AI.13)")
   223	    return report
   224
   225
   226	def main(argv: List[str] | None = None) -> int:
   227	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   228	    parser.add_argument("--json", action="store_true")
   229	    parser.add_argument("--decisions", type=int, default=200)
   230	    parser.add_argument("--orders", type=int, default=100)
   231	    parser.add_argument("--minutes", type=float, default=1.0)
   232	    args = parser.parse_args(argv)
   233	    report = run_harness(decisions=args.decisions, orders=args.orders,
   234	                         minutes=args.minutes)
   235	    if args.json:
   236	        print(json.dumps(report, indent=2, sort_keys=True))
   237	    else:
   238	        q = report["t_nfr_004"]
   239	        print(f"T-NFR-004 queue bounds: P0 {q['p0_delivered']}/{q['p0_expected']} "
   240	              f"delivered, P2 evicted {q['p2_evicted']}, "
   241	              f"reason={q['eviction_reason']} "
   242	              f"→ {'PASS' if q['all_p0_processed'] and q['some_p2_evicted'] else 'FAIL'}")
   243	        a, s = report["t_nfr_001"], report["t_nfr_002"]
   244	        print(f"T-NFR-001 analysis p95 {a['p95_ms']:.2f} ms "
   245	              f"(bound {a['bound_ms']} ms) → "
   246	              f"{'within' if a['within_bound'] else 'EXCEEDS'} [{a['label']}]")
   247	        print(f"T-NFR-002 submission p95 {s['p95_ms']:.2f} ms "
   248	              f"(bound {s['bound_ms']} ms) → "
   249	              f"{'within' if s['within_bound'] else 'EXCEEDS'} [{s['label']}]")
   250	        r = report["t_nfr_003"]
   251	        print(f"T-NFR-003 resource sample {r['minutes']:.1f} min: "
   252	              f"CPU {r['cpu_percent']:.2f} %, RSS {r['memory_mb']:.1f} MB "
   253	              f"[{r['label']}]")
   254	        print(f"sandbox verdict: {report['sandbox_verdict']}; owner gates open: "
   255	              f"{len(report['owner_gates_open'])}")
   256	    return 0 if report["measured_in_bounds"] else 1
   257
   258
   259	if __name__ == "__main__":
   260	    raise SystemExit(main())
