    72	async def _queue_bounds_probe() -> Dict[str, Any]:
    73	    """T-NFR-004: 2000 P0 + 1000 P2 (+ P3 pressure) on the frozen bus."""
    74	    from apex.bus import EventBus, Priority, make_event
    75
    76	    bus = EventBus()                      # dispatcher NOT started: nothing drains
    77	    seen = {"P0": 0, "P1": 0, "P2": 0, "P3": 0}
    78
    79	    async def consumer(event):
    80	        seen[f"P{int(event.priority)}"] += 1
    81
    82	    bus.subscribe("nfr", consumer)
    83	    for _ in range(2000):
    84	        await bus.publish(make_event(Priority.P0, "nfr", {"i": 1}))
    85	    for _ in range(1000):
    86	        await bus.publish(make_event(Priority.P2, "nfr", {"i": 2}))
    87	    for _ in range(100):
    88	        await bus.publish(make_event(Priority.P3, "nfr", {"i": 3}))
    89	    evictions = bus.eviction_log
    90	    return {"p0_delivered": bus.counts["p0_delivered"],
    91	            "p0_expected": 2000,
    92	            "all_p0_processed": bus.counts["p0_delivered"] == 2000,
    93	            "p2_published": 1000,
    94	            "p3_published": 100,
    95	            "p2_evicted": sum(1 for e in evictions if int(e.priority) == 2),
    96	            "p3_evicted": sum(1 for e in evictions if int(e.priority) == 3),
    97	            "some_p2_evicted": any(int(e.priority) == 2 for e in evictions),
    98	            "eviction_reason": evictions[0].reason if evictions else None,
    99	            "bounded": bus._shared_lane.qsize() <= 1000,
   100	            "lane_qsize": bus._shared_lane.qsize(),
   101	            "counts": bus.counts}
   102
