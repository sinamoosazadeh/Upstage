   507	def kyle_lambda(*, returns: Sequence[float], signed_volume: Sequence[float],
   508	                window: int = 100) -> Dict[str, Any]:
   509	    """B06 — ``λ = cov(r, v_signed)/var(v_signed)`` on a rolling window."""
   510	    r = [float(x) for x in returns]
   511	    v = [float(x) for x in signed_volume]
   512	    if len(r) != len(v):
   513	        raise ValueError("KYLE_INPUT_LENGTH_QX")
   514	    n = min(len(r), int(window))
   515	    if n < 3:
   516	        raise ValueError("INSUFFICIENT_HISTORY_B06")
   517	    r, v = r[-n:], v[-n:]
   518	    mr = sum(r) / n
   519	    mv = sum(v) / n
   520	    cov = sum((r[i] - mr) * (v[i] - mv) for i in range(n)) / (n - 1)
   521	    var = sum((v[i] - mv) ** 2 for i in range(n)) / (n - 1)
   522	    if var <= 0.0:
   523	        raise ValueError("ZERO_SIGNED_VOLUME_VARIANCE_B06")
   524	    return {"kyle_lambda": cov / var, "window": n, "q_label": Q3}
   525	
   526	
   527	def amihud_illiquidity(*, returns: Sequence[float],
   528	                       volumes: Sequence[float]) -> Dict[str, Any]:
   529	    """B07 — ``amihud_illiquidity_proxy = |return| / volume`` (mean over the
   530	    window; a zero-volume bar is skipped, never fabricated)."""
   531	    r = [float(x) for x in returns]
   532	    v = [float(x) for x in volumes]
   533	    if len(r) != len(v):
   534	        raise ValueError("AMIHUD_INPUT_LENGTH_QX")
   535	    ratios = [abs(r[i]) / v[i] for i in range(len(r)) if v[i] > 0.0]
   536	    if not ratios:
   537	        raise ValueError("NO_LIQUID_BAR_B07")
   538	    return {"amihud_illiquidity_proxy": sum(ratios) / len(ratios),
   539	            "n": len(ratios), "skipped_zero_volume": len(r) - len(ratios),
   540	            "q_label": Q3}
   541	
   542	

