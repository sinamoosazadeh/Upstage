  1829	    async def get_bridge_context(self, symbol: str, timeframe: str, as_of: str) -> dict:
  1830	        """Exactly 38 context fields / 23 risk fields; no fixture fallback.
  1831	
  1832	        PAPER serve binds prepare separately so this accessor is a cheap copy
  1833	        inside the scheduler budget. A standalone caller may prepare lazily.
