   619	
   620	    async def _stage_execution(self, payload: Mapping[str, Any]) -> Dict[str, Any]:
   621	        state = self._state(payload)
   622	        plan: F.TradePlan = state["plan_obj"]
   623	        if not self.trading_enabled:
   624	            raise CellRefusal("BOOT_NOT_READY",
   625	                              f"boot_state={self.boot_verdict.get('boot_state')} "
   626	                              f"new_trades_allowed=False")
   627	        if str(plan.decision) not in ("ALLOW", "REDUCE"):
   628	            raise CellRefusal("DECISION_NO_TRADE", str(plan.decision))
   629	        price = await last_closed_price(self.store, plan.symbol, plan.timeframe,
   630	                                        payload["as_of"])
   631	        if price is None:
   632	            raise CellRefusal("NO_PRICE_FOR_CELL", "no closed bar to price against")
   633	        # D51: reserve only when a valid trade plan exists, immediately before
   634	        # admission. The increment is synchronous (atomic under semaphore 4).
   635	        if not self._take_budget():
   636	            raise CellRefusal("TRADE_BUDGET_REACHED",
   637	                              f"max_trades_per_cycle={self.max_trades_per_cycle}")
   638	        record = await self.execute_plan(
   639	            plan, price=price, timestamp_utc=payload["as_of"],
   640	            close_ms=int(payload["close_ms"]))
   641	        if not record.get("submitted"):
   642	            self._release_budget()
   643	        state["trade"] = record
   644	        return {"detail": f"intent={record['intent_id']} state={record['state']} "
   645	                          f"fill={record.get('fill')} protected="
   646	                          f"{record.get('protected')}"}
   647	
   648	    async def _resolve_plan(self, payload: Mapping[str, Any]
   649	                            ) -> Mapping[str, Any]:
   650	        """Ask the decision bridge for this cell's plan (the frozen SL-5 → SL-6
   651	        seam). No provider ⇒ a NAMED refusal, never a fabricated plan."""
   652	        if self.plan_provider is None:
   653	            raise CellRefusal(
   654	                "NO_PLAN_PROVIDER",
   655	                "no plan provider is wired: the engine → fabric → setup → "
   656	                "forecast → risk → plan bridge is a separate increment "
   657	                "(PHASE2_HANDOFF_WIRING §REMAINING WORK)")
   658	        provided = self.plan_provider(payload["symbol"], payload["timeframe"],
   659	                                      payload["as_of"])
   660	        plan = await provided if hasattr(provided, "__await__") else provided
   661	        if plan is None:
   662	            refusal = getattr(self.plan_provider,"refusals",{}).get(payload["cell_id"])
   663	            if self.environment == "PAPER" and refusal:
   664	                raise CellRefusal(refusal["reason"],refusal.get("detail",""))
   665	            raise CellRefusal("NO_PLAN_FOR_CELL",
   666	                              f"{payload['cell_id']} has no governed plan at "
   667	                              f"{payload['as_of']}")
   668	        if not isinstance(plan, Mapping):
   669	            raise CellRefusal("PLAN_TYPE_QX", type(plan).__name__)
   670	        return dict(plan)
