   648	    async def _resolve_plan(self, payload: Mapping[str, Any]
   649	                            ) -> Mapping[str, Any]:
   650	        """Ask the decision bridge for this cell's plan (the frozen SL-5 → SL-6
   651	        seam). No provider ⇒ a NAMED refusal, never a fabricated plan."""
   652	        if self.plan_provider is None:
   653	            raise CellRefusal(
   654	                "NO_PLAN_PROVIDER",
   655	                "no plan provider is wired: the engine → fabric → setup → "
   656	                "forecast → risk → plan bridge is a separate increment "
   657	                "(PHASE2_HANDOFF_WIRING §REMAINING WORK)")
   658	        provided = self.plan_provider(payload["symbol"], payload["timeframe"],
   659	                                      payload["as_of"])
   660	        plan = await provided if hasattr(provided, "__await__") else provided
   661	        if plan is None:
   662	            refusal = getattr(self.plan_provider,"refusals",{}).get(payload["cell_id"])
   663	            if self.environment == "PAPER" and refusal:
   664	                raise CellRefusal(refusal["reason"],refusal.get("detail",""))
   665	            raise CellRefusal("NO_PLAN_FOR_CELL",
   666	                              f"{payload['cell_id']} has no governed plan at "
   667	                              f"{payload['as_of']}")
   668	        if not isinstance(plan, Mapping):
   669	            raise CellRefusal("PLAN_TYPE_QX", type(plan).__name__)
   670	        return dict(plan)
   956	    async def run_cycle(self, *, now_ms: Optional[int] = None) -> Dict[str, Any]:
   957	        moment = self.clock.now_ms() if now_ms is None else int(now_ms)
   958	        as_of = _ms_to_iso(moment)
   959	        self._budget_taken = 0
   960	        self._cycle_proposals = {}
   961	        if not self._cursor_loaded:
   962	            await self._load_cursor()
   963	        cycle: Dict[str, Any] = {"cycle": len(self.cycles) + 1, "as_of": as_of,
   964	                                 "signal_source": self.signal_source,
   965	                                 "trading_enabled": self.trading_enabled,
   966	                                 "budget_limit": self.max_trades_per_cycle}
   967	        cycle["catch_up"] = (await self.catch_up(moment) if self.catch_up else
   968	                             {"cells_checked": 0, "cells_updated": 0,
   969	                              "bars_ingested": 0, "failures": []})
   970	        self._catch_up_failed = {row["cell"]: row
   971	                                 for row in cycle["catch_up"]["failures"]}
   972	        if self.watchdog is not None:
   973	            cycle["heartbeat"] = await _maybe_await(self.watchdog.heartbeat())
   974	        cycle["storage"] = await self._storage_guard()
   975	        if self.gateway is not None:
   976	            cycle["telegram"] = await self.gateway.run_once()
   977	        # The scheduler's law is "on each TF close run the stages for THAT
   978	        # cell": a cell runs once per close, and a cell whose close has not
   979	        # advanced since the previous cycle is not run again.
   980	        already = []
   981	        due = []
   982	        for item in self.scheduler.due_cells(now_ms=moment):
   983	            recorded = self._last_close.get(item[0].cell_id)
   984	            if recorded is not None and int(item[1]) <= int(recorded):
   985	                already.append(item)
   986	                continue
   987	            due.append(item)
   988	        cycle["cells_skipped_already_decided"] = len(already)
   989	        if self.max_cells_per_cycle is not None:
   990	            due = due[:self.max_cells_per_cycle]
   991	        # G1: all expensive source preparation completes before run_cell
   992	        # starts its latency clock. D22 failures never enter preparation;
   993	        # a failed source must not fall back to its previous cached success.
   994	        self._context_preparation_failed = {}
   995	        preparation = {"cells_checked": 0, "cells_prepared": 0, "failures": []}
   996	        receipt_ms = max(moment,self.clock.now_ms())
   997	        self._decision_as_of = ({cell.cell_id:_ms_to_iso(max(close,receipt_ms))
   998	                                for cell,close in due} if self.environment == "PAPER" else {})
   999	        cycle["decision_as_of"] = dict(self._decision_as_of)
  1000	        cycle["publishers"] = await self._refresh_publishers(due)
  1001	        published = (cycle.get("catch_up") or {}).get("quality_publish") or {}
  1002	        cycle["publishers"]["quality_facts_written"] = int(
  1003	            cycle["publishers"].get("quality_facts_written") or 0) + int(
  1004	                published.get("written") or 0)
  1005	        cycle["publishers"]["failures"] = list(
  1006	            cycle["publishers"].get("failures") or [])
  1007	        cycle["publishers"]["failures"].extend(list(published.get("failures") or []))
  1008	        prepare = getattr(self.plan_provider, "prepare", None)
  1009	        if callable(prepare):
  1010	            for cell, close in due:
  1011	                if cell.cell_id in self._catch_up_failed:
  1012	                    continue
  1013	                preparation["cells_checked"] += 1
  1014	                try:
  1015	                    await _maybe_await(prepare(cell.symbol, cell.timeframe, self._decision_as_of.get(cell.cell_id,_ms_to_iso(close))))
  1016	                    preparation["cells_prepared"] += 1
  1017	                except Exception as exc:
  1018	                    failed = {"cell": cell.cell_id,
  1019	                              "reason": getattr(exc, "reason", "ENGINE_CONTEXT_PREPARATION_FAILED"),
  1020	                              "detail": getattr(exc, "detail", type(exc).__name__)}
  1021	                    self._context_preparation_failed[cell.cell_id] = failed
  1022	                    preparation["failures"].append(failed)
  1023	        cycle["context_preparation"] = preparation
  1024	        tasks = [asyncio.create_task(self.scheduler.run_cell(
  1025	                    cell, close_ms=close, context={"cell_state": {}}))
  1026	                 for cell, close in due]
  1027	        runs = list(await asyncio.gather(*tasks)) if tasks else []
