    92	def synthetic_legacy_cases() -> List[Dict[str, Any]]:
    93	    """v4-derived self-check cases (ADR-P2-009): each case is built from a v4
    94	    object, expressed in the legacy shape, then round-tripped through the real
    95	    adapter and compared semantically."""
    96	    e05 = {
    97	        "schema_version": "3.0.0", "fid": "fvg-synth-1", "direction": "BULL",
    98	        "lower": 100.0, "upper": 102.0, "created_at_ts": 1710460800000,
    99	        "created_at_idx": 10, "ftype": "CONVENTIONAL",
   100	    }
   101	    e05_doji = {**e05, "fid": "fvg-synth-2", "ftype": "DOJI_FVG"}
   102	    e06 = {
   103	        "version": "3.0.0", "oid": "ob-synth-1", "direction": "LONG",
   104	        "zone_lo": 99.0, "zone_hi": 101.0, "origin_ts": 1710460800000,
   105	        "origin_idx": 12,
   106	    }
   107	    e06_hl = {**e06, "oid": "ob-synth-2"}
   108	    e06_hl.pop("zone_lo")
   109	    e06_hl.pop("zone_hi")
   110	    e06_hl["origin_high"] = 101.0
   111	    e06_hl["origin_low"] = 99.0
   112	    return [
   113	        {"engine_id": "E05", "version": "v3", "payload": e05,
   114	         "expect": {"ftype": "CONVENTIONAL", "penalty_applied": False}},
   115	        {"engine_id": "E05", "version": "v3", "payload": e05_doji,
   116	         "expect": {"ftype": "CONVENTIONAL", "penalty_applied": True}},
   117	        {"engine_id": "E06", "version": "v3", "payload": e06,
   118	         "expect": {"derived_from": "zone_lo_zone_hi"}},
   119	        {"engine_id": "E06", "version": "v3", "payload": e06_hl,
   120	         "expect": {"derived_from": "origin_high_origin_low"}},
   121	    ]
