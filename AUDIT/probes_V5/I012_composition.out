    54	def verify_fixture(payload: Dict[str, Any]) -> Dict[str, Any]:
    55	    """Hash-seal check over the ``cases`` array (never over the whole file)."""
    56	    from apex.identity.canonical_json import canonical_json
    57
    58	    cases = payload.get("cases")
    59	    meta = payload.get("_meta", {})
    60	    if not isinstance(cases, list) or not cases:
    61	        return {"ok": False, "reason": "FIXTURE_CASES_ABSENT"}
    62	    digest = hashlib.sha256(canonical_json(cases).encode("utf-8")).hexdigest()
    63	    expected = meta.get("cases_sha256")
    64	    return {"ok": digest == expected, "cases_sha256": digest,
    65	            "expected": expected, "case_count": len(cases),
    66	            "declared_count": meta.get("case_count"),
    67	            "count_ok": meta.get("case_count") == len(cases),
    68	            "reason": None if digest == expected else "FIXTURE_HASH_MISMATCH"}
    69
    70
    71	def _apply_scenario(responder, scenario: Dict[str, Any]) -> None:
    72	    if "fill_mode" in scenario:
    73	        responder.set_fill_mode(scenario["fill_mode"],
    74	                                price=scenario.get("fill_price"))
    75	    if scenario.get("timeouts"):
    76	        responder.lose_next_ack(scenario["timeouts"],
    77	                                record=scenario.get("record_before_timeout",
    78	                                                    True))
    79	    if scenario.get("fail_with") is not None:
    80	        responder.fail_next(scenario["fail_with"],
    81	                            scenario.get("fail_times", 1))
    82	    for order in scenario.get("seed_orders", []):
    83	        responder.seed_order(**order)
    84	    if scenario.get("seed_position"):
    85	        responder.seed_position(**scenario["seed_position"])
    86
    87
    88	def run_case(case: Dict[str, Any]) -> Dict[str, Any]:
    89	    """One fixture case against the real adapter + the fake responder."""
    90	    import asyncio
    91
    92	    from apex.config import Config
    93	    from apex.execution.toobit_adapter import ToobitAdapter
    94	    from fake_toobit_responder import FakeToobitResponder
    95
    96	    operations = {
    97	        "submit_order": lambda adapter, call: adapter.submit_order(**call),
    98	        "cancel_order": lambda adapter, call: adapter.cancel_order(**call),
    99	        "query_order_state": lambda adapter, call:
   100	            adapter.query_order_state(**call),
   101	        "query_open_positions": lambda adapter, call:
   102	            adapter.query_open_positions(**call),
   103	        "query_account_margin_health": lambda adapter, call:
   104	            adapter.query_account_margin_health(**call),
   105	    }
   106	    responder = FakeToobitResponder(api_key=HARNESS_ENV["TOOBIT_API_KEY"],
   107	                                    api_secret=HARNESS_ENV["TOOBIT_API_SECRET"])
   108	    adapter = ToobitAdapter(config=Config(), transport=responder,
   109	                            utc_now=lambda: "2026-01-01T00:00:00.000Z",
   110	                            clock=lambda: 1000.0)
   111	    _apply_scenario(responder, case.get("scenario", {}))
   112	    calls = case.get("calls") or [case["call"]]
   113	    posts_before = len(responder.calls_to("/api/v1/futures/order", "POST"))
   114	    result = None
   115	    for call in calls:
   116	        result = asyncio.run(operations[case["operation"]](adapter, call))
   117	    observed = result.to_dict()
   118	    failures: List[str] = []
   119	    for key, expected in case.get("expect", {}).items():
   120	        if key == "attempts":
   121	            if len(result.attempts) != expected:
   122	                failures.append(f"{key}: {len(result.attempts)} != {expected}")
   123	        elif key == "attempt_sources":
   124	            sources = [a.result_source for a in result.attempts]
   125	            if sources != expected:
   126	                failures.append(f"{key}: {sources} != {expected}")
   127	        elif key == "unique_idempotency_keys":
   128	            keys = [a.idempotency_key for a in result.attempts]
   129	            unique = len(set(keys)) == len(keys)
   130	            if unique is not expected:
   131	                failures.append(f"{key}: unique={unique} != {expected}")
   132	        elif key == "interval_disabled":
   133	            if dict(result.interval_disabled or {}) != expected:
   134	                failures.append(f"{key}: {result.interval_disabled} != {expected}")
   135	        elif observed.get(key) != expected:
   136	            failures.append(f"{key}: {observed.get(key)!r} != {expected!r}")
   137	    venue = case.get("expect_venue") or {}
   138	    if "posts_to_order_endpoint" in venue:
   139	        posts = len(responder.calls_to("/api/v1/futures/order", "POST")) - \
   140	            posts_before
   141	        if posts != venue["posts_to_order_endpoint"]:
   142	            failures.append(f"posts_to_order_endpoint: {posts} != "
   143	                            f"{venue['posts_to_order_endpoint']}")
   144	    if "signature_violations" in venue:
   145	        violations = len(responder.signature_violations())
   146	        if violations != venue["signature_violations"]:
   147	            failures.append(f"signature_violations: {violations} != "
   148	                            f"{venue['signature_violations']}")
   149	    if "request_params" in venue:
   150	        sent = responder.calls_to("/api/v1/futures/order", "POST")[-1].params
   151	        for key, value in venue["request_params"].items():
   152	            if sent.get(key) != value:
   153	                failures.append(f"request_params.{key}: {sent.get(key)!r} != "
   154	                                f"{value!r}")
   155	    if "venue_recorded_client_order_id" in venue:
   156	        if venue["venue_recorded_client_order_id"] not in responder.orders:
   157	            failures.append("venue_recorded_client_order_id: absent")
   158	    if "leverage_sent_for_BTCUSDT" in venue:
   159	        if responder.leverage.get("BTC-SWAP-USDT") != \
   160	                venue["leverage_sent_for_BTCUSDT"]:
   161	            failures.append("leverage_sent_for_BTCUSDT: mismatch")
   162	    state = case.get("expect_state") or {}
   163	    if "disabled_intervals" in state:
   164	        observed_state = {k: list(v) for k, v in
   165	                          adapter.disabled_intervals().items()}
   166	        if observed_state != state["disabled_intervals"]:
   167	            failures.append(f"disabled_intervals: {observed_state} != "
   168	                            f"{state['disabled_intervals']}")
   169	    return {"id": case["id"], "operation": case["operation"],
   170	            "ok": not failures, "failures": failures}
   171
   172
   173	def run_harness(*, legacy_export: str | None = None) -> Dict[str, Any]:
   174	    payload = json.loads(FIXTURE.read_text(encoding="utf-8"))
   175	    seal = verify_fixture(payload)
   176	    try:
   177	        fixture_name = str(FIXTURE.relative_to(REPO_ROOT))
   178	    except ValueError:                    # relocated fixture (tests, owner copy)
   179	        fixture_name = str(FIXTURE)
   180	    report: Dict[str, Any] = {"harness": "AI.10 adapter conformance runner",
   181	                              "fixture": fixture_name,
   182	                              "fixture_seal": seal, "cases": []}
   183	    if not (seal["ok"] and seal["count_ok"]):
   184	        report["status"] = "FIXTURE_INTEGRITY_FAILURE"
   185	        report["passed"] = False
   186	        return report
   187
   188	    from apex.research import adapter_conformance as ac
   189
   190	    cases = [run_case(case) for case in payload["cases"]]
   191	    report["cases"] = cases
   192	    report["cases_passed"] = sum(1 for c in cases if c["ok"])
   193	    report["cases_total"] = len(cases)
   194	    report["t_ad_001"] = ac.t_ad_001(export_path=legacy_export)
   195	    report["t_ad_002"] = ac.t_ad_002(retries=100, submit=_retry_seam())
   196	    report["passed"] = (report["cases_passed"] == report["cases_total"]
   197	                        and report["t_ad_001"]["passed"]
   198	                        and report["t_ad_002"]["passed"])
   199	    report["status"] = "PASS" if report["passed"] else "FAIL"
   200	    return report
   201
   202
   203	def _retry_seam():
   204	    """T-AD-002 seam: the CP-7 adapter's own duplicate cache."""
   205	    import asyncio
   206
   207	    from apex.config import Config
   208	    from apex.execution.toobit_adapter import ToobitAdapter
   209	    from fake_toobit_responder import FakeToobitResponder
   210
   211	    responder = FakeToobitResponder(api_key=HARNESS_ENV["TOOBIT_API_KEY"],
   212	                                    api_secret=HARNESS_ENV["TOOBIT_API_SECRET"])
   213	    adapter = ToobitAdapter(config=Config(), transport=responder)
   214
   215	    def submit(intent_id: str) -> Dict[str, Any]:
   216	        result = asyncio.run(adapter.submit_order(
   217	            intent_id=intent_id, symbol="BTCUSDT", timeframe="15m",
   218	            direction="LONG", quantity=1, price=60000, order_type="LIMIT"))
   219	        return result.to_dict()
   220
   221	    return submit
   222
   223
   224	def main(argv: List[str] | None = None) -> int:
   225	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   226	    parser.add_argument("--json", action="store_true",
   227	                        help="print the full JSON verdict")
   228	    parser.add_argument("--legacy-export", default=None,
   229	                        help="path to an owner-supplied v2/v3 export (JSON list)")
   230	    args = parser.parse_args(argv)
   231
   232	    _prepare_imports()
   233	    for name, value in HARNESS_ENV.items():
   234	        os.environ.setdefault(name, value)
   235	    report = run_harness(legacy_export=args.legacy_export)
   236
   237	    if args.json:
   238	        print(json.dumps(report, indent=2, sort_keys=True))
   239	    elif report["status"] == "FIXTURE_INTEGRITY_FAILURE":
   240	        print(f"FIXTURE INTEGRITY FAILURE: {report['fixture']} — "
   241	              f"{report['fixture_seal'].get('reason')}; no case was executed")
   242	    else:
   243	        seal = report["fixture_seal"]
   244	        print(f"fixture: {report['fixture']} "
   245	              f"({seal.get('case_count')} cases, sha256 "
   246	              f"{str(seal.get('cases_sha256'))[:16]}…, "
   247	              f"sealed={seal['ok']})")
   248	        for case in report["cases"]:
   249	            mark = "PASS" if case["ok"] else "FAIL"
   250	            print(f"  [{mark}] {case['id']} {case['operation']}"
   251	                  + ("" if case["ok"] else " — " + "; ".join(case["failures"])))
   252	        print(f"T-AD-001 legacy translation: "
   253	              f"{'PASS' if report['t_ad_001']['passed'] else 'FAIL'}")
   254	        print(f"T-AD-002 idempotent retries: "
   255	              f"{'PASS' if report['t_ad_002']['passed'] else 'FAIL'}")
   256	        print(f"status: {report['status']} "
   257	              f"({report.get('cases_passed')}/{report.get('cases_total')} cases)")
   258	    if report["status"] == "FIXTURE_INTEGRITY_FAILURE":
   259	        return 2
   260	    return 0 if report["passed"] else 1
   261
   262
   263	if __name__ == "__main__":
   264	    raise SystemExit(main())
=== Baseline CP-8 adapter tests, full module ===
     1	"""CP-8 integration — the AI.10 adapter-conformance harness against REAL CP-7
     2	objects: the ``ToobitAdapter`` submit seam and the in-repo fake responder.
     3
     4	T-AD-002 (idempotency) is exercised here end-to-end because the research plane
     5	must not own an exchange seam: the harness supplies the retry key, the CP-7
     6	adapter answers duplicates from its own cache and the fake responder counts the
     7	actual venue submissions. T-AD-001 (legacy export translation) runs the
     8	synthetic legacy cases through the real E05/E06 adapters.
     9	"""
    10	from __future__ import annotations
    11
    12	import asyncio
    13
    14	import pytest
    15
    16	from apex.config import Config
    17	from apex.execution.toobit_adapter import ToobitAdapter
    18	from apex.research import adapter_conformance as ac
    19
    20	TEST_KEY = "TEST_KEY_CP8"
    21	TEST_SECRET = "TEST_SECRET_CP8"
    22	CLIENT_ORDER_ID = "intent-cp8-tad002"
    23
    24
    25	def run(coro):
    26	    return asyncio.run(coro)
    27
