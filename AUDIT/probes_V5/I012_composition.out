=== I-012 baseline source: adapter_conformance.py ===
    59	def _load_adapter(engine_id: str) -> Callable[[Mapping[str, Any]], Any]:
    60	    target = ENGINE_ADAPTERS.get(engine_id)
    61	    if target is None:
    62	        raise AdapterConformanceError("ENGINE_ADAPTER_ABSENT", engine_id)
    63	    module_name, _, attr = target.partition(":")
    64	    module = __import__(module_name, fromlist=[attr])
    65	    return getattr(module, attr)
    66
    67
    68	def translate_legacy(*, engine_id: str, payload: Mapping[str, Any],
    69	                     version: str) -> Dict[str, Any]:
    70	    """Read-only translation of ONE legacy record into its v4 object.
    71
    72	    The caller receives the canonical v4 projection plus the lineage facts of
    73	    the migration; nothing is written anywhere.
    74	    """
    75	    if version not in LEGACY_VERSIONS:
    76	        raise AdapterConformanceError("LEGACY_VERSION_QX", version)
    77	    adapter = _load_adapter(engine_id)
    78	    before = canonical_json(dict(payload))
    79	    obj = adapter(dict(payload))
    80	    after = canonical_json(obj.to_canonical() if hasattr(obj, "to_canonical")
    81	                           else (obj.to_dict() if hasattr(obj, "to_dict")
    82	                                 else str(obj)))
    83	    return {"engine_id": engine_id, "version": version,
    84	            "legacy_hash": __import__("hashlib").sha256(
    85	                before.encode()).hexdigest(),
    86	            "v4_hash": __import__("hashlib").sha256(after.encode()).hexdigest(),
    87	            "v4_object_type": type(obj).__name__,
    88	            "read_only": True, "state_mutated": False,
    89	            "contract_version": CONTRACT_VERSION}
    90
