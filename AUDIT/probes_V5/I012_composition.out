   126	class TestTAd001Synthetic:
   127	    def test_synthetic_cases_pass(self):
   128	        verdict = ac.t_ad_001()
   129	        assert verdict["test"] == "T-AD-001"
   130	        assert verdict["passed"] is True
   131	        assert verdict["failures"] == []
   132	        assert verdict["synthetic_cases"] == len(ac.synthetic_legacy_cases())
   133	        assert all(row["read_only"] is True for row in verdict["results"])
