     1	#!/usr/bin/env python3
     2	"""AI.10 conformance **harness runner** (CP-8 scope; delegated by CP-7).
     3
     4	Runs, in one executable pass:
     5
     6	* the hash-locked 19-case Toobit conformance fixture
     7	  (``tests/fixtures/toobit_adapter_conformance.json``) against the REAL CP-7
     8	  ``ToobitAdapter`` over the in-repo fake responder (a test double only — no
     9	  network, no credentials, nothing outside the sandbox);
    10	* **T-AD-001** legacy-adapter translation (synthetic self-checks; an owner
    11	  export path can be supplied with ``--legacy-export``);
    12	* **T-AD-002** idempotent-retry conformance through the adapter seam.
    13
    14	The fixture is verified against ``_meta.cases_sha256`` BEFORE any case runs;
    15	a tampered fixture aborts the harness (exit 2) instead of producing a verdict.
    16
    17	Usage
    18	-----
    19	    python3 scripts/run_adapter_conformance.py [--json] [--legacy-export PATH]
    20
    21	Exit codes: 0 all green · 1 conformance failure · 2 fixture integrity failure.
    22	"""
    23
    24	from __future__ import annotations
    25
    26	import argparse
    27	import hashlib
    28	import json
    29	import os
    30	import sys
    31	from pathlib import Path
    32	from typing import Any, Dict, List
    33
    34	REPO_ROOT = Path(__file__).resolve().parents[1]
    35	FIXTURE = REPO_ROOT / "tests" / "fixtures" / "toobit_adapter_conformance.json"
    36
    37	#: The harness itself is the composition root: it sets the PAPER/test-double
    38	#: environment the adapter needs. These are the nine G16 names only — the
    39	#: values here are the fixture key/secret of the in-repo responder.
    40	HARNESS_ENV = {
    41	    "APEX_ENV": "PAPER",
    42	    "APEX_ALLOW_SIGNED": "1",
    43	    "TOOBIT_API_KEY": "TEST_KEY_CP8_HARNESS",
    44	    "TOOBIT_API_SECRET": "TEST_SECRET_CP8_HARNESS",
    45	}
    46
    47
    48	def _prepare_imports() -> None:
    49	    for extra in (str(REPO_ROOT), str(REPO_ROOT / "tests")):
    50	        if extra not in sys.path:
    51	            sys.path.insert(0, extra)
    52
