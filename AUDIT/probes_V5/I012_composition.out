    50
    51	class TestTAd002AdapterSeam:
    52	    def _submit_factory(self, adapter, seen):
    53	        def submit(intent_id: str):
    54	            result = run(adapter.submit_order(
    55	                intent_id=intent_id, symbol="BTCUSDT", timeframe="15m",
    56	                direction="LONG", quantity=1, price=60000,
    57	                order_type="LIMIT"))
    58	            seen.append(result)
    59	            return result.to_dict()
    60
    61	        return submit
    62
    63	    def test_one_hundred_retries_produce_one_venue_order(self, venue):
    64	        responder, adapter = venue
    65	        seen = []
    66	        verdict = ac.t_ad_002(retries=100,
    67	                              submit=self._submit_factory(adapter, seen))
    68	        assert verdict["unique_keys"] == 1
    69	        assert verdict["key_stable"] is True
    70	        assert verdict["new_submissions"] == 1
    71	        assert verdict["cached_hits"] == 99
    72	        assert verdict["no_double_execution"] is True
    73	        assert verdict["passed"] is True
    74
    75	        # the venue itself saw exactly one POST /api/v1/futures/order
    76	        posts = responder.calls_to("/api/v1/futures/order", "POST")
    77	        assert len(posts) == 1
    78	        assert responder.open_order_count() == 1
    79	        # no signature violation anywhere in the retry storm
    80	        assert responder.signature_violations() == []
    81
    82	    def test_duplicate_result_is_flagged_cached_and_not_resubmitted(self, venue):
    83	        responder, adapter = venue
    84	        seen = []
    85	        submit = self._submit_factory(adapter, seen)
    86	        submit(CLIENT_ORDER_ID)
    87	        submit(CLIENT_ORDER_ID)
    88	        assert seen[-1].cached is True
    89	        assert seen[-1].resubmitted is False
    90	        assert seen[-1].order_id == seen[0].order_id
    91	        assert seen[-1].idempotency_key == seen[0].idempotency_key
    92	        assert len(responder.calls_to("/api/v1/futures/order", "POST")) == 1
    93
    94	    def test_the_retry_key_is_a_replay_key_not_the_attempt_index(self):
    95	        common = dict(engine_version="4.0.0", contract_version="4.0.0",
    96	                      symbol="BTCUSDT", timeframe="15m",
    97	                      as_of="2026-08-30T14:00:00Z", input_hash="a" * 64,
    98	                      parameter_package_id="pkg-cp8-0.1.0",
    99	                      code_revision="0" * 40)
   100	        payload = {"intent_id": CLIENT_ORDER_ID, "quantity": 1.0}
   101	        first = ac.stable_retry_key(payload=payload, **common)
   102	        again = ac.stable_retry_key(payload=payload, **common)
   103	        assert first == again
   104	        # any real change of the intent changes the key
   105	        changed = ac.stable_retry_key(payload={**payload, "quantity": 2.0},
   106	                                      **common)
   107	        assert changed != first
   108
   109	    def test_a_lost_ack_is_recorded_on_the_venue_side(self, venue):
   110	        responder, adapter = venue
   111	        responder.lose_next_ack(1)
   112	        seen = []
   113	        submit = self._submit_factory(adapter, seen)
   114	        verdict = ac.t_ad_002(retries=3, submit=submit)
   115	        # the ACK was lost but the order WAS recorded: the retry answers from
   116	        # the adapter cache, so the venue never sees a second order
   117	        assert verdict["unique_keys"] == 1
   118	        posts = responder.calls_to("/api/v1/futures/order", "POST")
   119	        assert len(posts) == 1
