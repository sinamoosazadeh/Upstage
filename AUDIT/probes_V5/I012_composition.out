=== I-012 baseline source: E05 adapter ===
   699	# --------------------------------------------------------------------------
   700	# §5.5 v3→v4 migration adapter (read-only; fail-closed on ambiguity)
   701	# --------------------------------------------------------------------------
   702	def load_v3_adapter(payload: Dict[str, Any]) -> FVGObject:
   703	    """Explicit read-only migration v3 → v4 (§5.5): mitigation_dir absent
   704	    ⇒ default 0; ftype DOJI_FVG ⇒ CONVENTIONAL with the 0.7 penalty marker
   705	    in extra. Unresolved ambiguity fails closed (never a silent v4 live
   706	    interpretation)."""
   707	    if payload.get("schema_version", "3.0.0") not in ("3.0.0", "3"):
   708	        raise ValueError("E05_ADAPTER_VERSION_QX: not a v3 payload")
   709	    required = ("fid", "direction", "lower", "upper", "created_at_ts",
   710	                "created_at_idx")
   711	    missing = [k for k in required if k not in payload]
   712	    if missing:
   713	        raise ValueError(f"E05_ADAPTER_AMBIGUOUS_QX: missing {missing}")
   714	    ftype = payload.get("ftype", "CONVENTIONAL")
   715	    penalty_applied = False
   716	    if ftype == "DOJI_FVG":
   717	        ftype = "CONVENTIONAL"
   718	        penalty_applied = True
   719	    lower = float(payload["lower"])
   720	    upper = float(payload["upper"])
   721	    sal0 = float(payload.get("salience_0", payload.get("salience", 0.0)))
   722	    obj = FVGObject(
   723	        fid=str(payload["fid"]), direction=payload["direction"],
   724	        lower=lower, upper=upper, mid=(lower + upper) / 2,
   725	        width=upper - lower,
   726	        created_at_ts=int(payload["created_at_ts"]),
   727	        created_at_idx=int(payload["created_at_idx"]),
   728	        ftype=ftype,
   729	        quality_tag=payload.get("quality_tag", "Q2"),
   730	        fate=payload.get("fate", "FRESH"),
   731	        age_bars=int(payload.get("age_bars", 0)),
   732	        touch_count=int(payload.get("touch_count", 0)),
   733	        mitigation_depth=float(payload.get("mitigation_depth", 0.0)),
   734	        mitigation_dir=int(payload.get("mitigation_dir", 0)),
   735	        salience_0=sal0,
   736	        salience=float(payload.get("salience", sal0)),
   737	        freshness=float(payload.get("freshness", 1.0)),
   738	        premium_z=float(payload.get("premium_z", 0.0)))
   739	    if penalty_applied:
   740	        obj.extra["v3_doji_penalty"] = 0.7
   741	    obj.update_snapshot()
   742	    return obj
   743
=== I-012 baseline source: E06 adapter ===
   727	# --------------------------------------------------------------------------
   728	# §8.7 serialization compatibility (v3 read-only research adapter)
   729	# --------------------------------------------------------------------------
   730	def load_v3_adapter(payload: Dict[str, Any]) -> OB:
   731	    """Live v4 does NOT consume v3 payloads directly (§8.7): only the
   732	    explicit read-only migration adapter may derive zone_hi/zone_lo from
   733	    older H/L-based fields; ambiguity fails closed."""
   734	    if payload.get("version", "3.0.0") not in ("3.0.0", "3"):
   735	        raise ValueError("E06_ADAPTER_VERSION_QX: not a v3 payload")
   736	    if "zone_lo" in payload and "zone_hi" in payload:
   737	        zone_lo, zone_hi = float(payload["zone_lo"]), float(payload["zone_hi"])
   738	    elif "origin_high" in payload and "origin_low" in payload:
   739	        zone_lo, zone_hi = (float(payload["origin_low"]),
   740	                            float(payload["origin_high"]))
   741	    else:
   742	        raise ValueError(
   743	            "E06_ADAPTER_AMBIGUOUS_QX: cannot derive zone from v3 fields")
   744	    required = ("oid", "direction", "origin_ts", "origin_idx")
   745	    missing = [k for k in required if k not in payload]
   746	    if missing:
   747	        raise ValueError(f"E06_ADAPTER_AMBIGUOUS_QX: missing {missing}")
   748	    ob = OB(
   749	        oid=str(payload["oid"]), direction=payload["direction"],
   750	        zone_lo=zone_lo, zone_hi=zone_hi,
   751	        origin_ts=int(payload["origin_ts"]),
   752	        origin_idx=int(payload["origin_idx"]),
   753	        displacement_mag=float(payload.get("displacement_mag", 0.0)),
   754	        displacement_multi=float(payload.get("displacement_multi", 0.0)),
   755	        structural_event=payload.get("structural_event", "NONE"),
   756	        structural_strength=float(payload.get("structural_strength", 0.3)),
   757	        otype=payload.get("otype", "ENTRY"),
   758	        quality=payload.get("quality", "Q2"),
   759	        fate=payload.get("fate", "CANDIDATE"),
   760	        vol_ratio=float(payload.get("vol_ratio", 0.0)),
   761	        width=zone_hi - zone_lo,
   762	        confirmed_at=int(payload.get("confirmed_at",
   763	                                     payload["origin_ts"])))
   764	    ob.snapshot_id = e06_snapshot_id(ob)
   765	    return ob
