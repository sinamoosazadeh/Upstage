    37	@pytest.fixture()
    38	def venue():
    39	    from fake_toobit_responder import FakeToobitResponder
    40
    41	    responder = FakeToobitResponder(api_key=TEST_KEY, api_secret=TEST_SECRET,
    42	                                    balance="10000")
    43	    adapter = ToobitAdapter(config=Config(), transport=responder)
    44	    return responder, adapter
