  2322	            bundle["measured_mtf"] = {k: v for k, v in mtf.items() if k != "frames"}
  2323	        lineage = tuple(self._raw_lineage[(symbol, timeframe, obs.timestamp, obs.content_hash())]["observation_id"]
  2324	                        for obs in bundle["raw_window"])
  2325	        available = max([_iso_to_ms(bundle["window"][-1].timestamp)] + [_iso_to_ms(obs.availability_time) for obs in bundle["raw_window"]])
  2326	        events = [replace(event, lineage=tuple(dict.fromkeys((*event.lineage, *lineage))),
  2327	                          availability_time=_ms_to_iso(max(_iso_to_ms(event.availability_time), available)))
  2328	                  for event in bundle["events"]]
  2329	        bundle["events"] = await persist_complete_evidence(self.store, events)
  2330	        bundle["raw_observation_ids"] = lineage
  2331	        bundle["classifier_artifact_sha256"] = artifact["artifact_sha256"]
  2332	        self.diagnostics[f"{symbol}:{timeframe}"] = {"status": "ENGINE_BUNDLE_PREPARED",
  2333	            "engine_order": list(bundle["engine_order"]), "evidence_count": len(events),
  2334	            "as_of": last["as_of"], "classifier_artifact_sha256": artifact["artifact_sha256"]}
  2335	        return bundle
  2336
