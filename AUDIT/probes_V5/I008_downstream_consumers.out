===== apex/ops/plan_bridge.py:541-635 (baseline) =====
   541	    async def __call__(self, symbol: str, timeframe: str, as_of: str
   542	                       ) -> Optional[Mapping[str, Any]]:
   543	        key = f"{symbol}:{timeframe}"
   544	        try:
   545	            if self.environment != "PAPER":
   546	                raise BridgeError("PAPER_ONLY_EXECUTION", self.environment)
   547	            if symbol not in CORE10_SYMBOLS or timeframe not in TIMEFRAMES_14:
   548	                raise BridgeError("CELL_OUT_OF_UNIVERSE", key)
   549	            source = await self._source_context(symbol, timeframe, as_of)
   550	            if source is None:
   551	                raise BridgeError(
   552	                    "ENGINE_CONTEXT_UNAVAILABLE",
   553	                    "no governed engine context or complete persisted evidence reader",
   554	                )
   555	            plan = await self._build(source, symbol=symbol, timeframe=timeframe,
   556	                                     as_of=as_of)
   557	            self.refusals.pop(key, None)
   558	            self.plans[key] = dict(plan)
   559	            return plan
   560	        except BridgeError as exc:
   561	            self.refusals[key] = {"reason": exc.reason, "detail": exc.detail}
   562	            return None
   563	        except FamilyError as exc:
   564	            self.refusals[key] = {"reason": exc.reason, "detail": exc.detail}
   565	            return None
   566	        except Exception as exc:
   567	            # A provider exception must not become a guessed plan.  Keep a
   568	            # stable machine reason while retaining the type/detail for audit.
   569	            self.refusals[key] = {
   570	                "reason": "BRIDGE_FAIL_CLOSED",
   571	                "detail": f"{type(exc).__name__}: {exc}",
   572	            }
   573	            return None
   574
   575	    async def _source_context(self, symbol: str, timeframe: str,
   576	                              as_of: str) -> Optional[Mapping[str, Any]]:
   577	        if self.context_source is not None:
   578	            value = self.context_source(symbol, timeframe, as_of)
   579	            return await _maybe_await(value)
   580	        for name in ("get_bridge_context", "get_engine_context",
   581	                     "read_bridge_context", "read_engine_context"):
   582	            reader = getattr(self.store, name, None)
   583	            if reader is None:
   584	                continue
   585	            return await _maybe_await(reader(symbol, timeframe, as_of))
   586	        contexts = getattr(self.store, "bridge_contexts", None)
   587	        if isinstance(contexts, Mapping):
   588	            return contexts.get((symbol, timeframe)) or contexts.get(
   589	                f"{symbol}:{timeframe}")
   590	        return None
   591
   592	    async def _window(self, context: Mapping[str, Any], *, symbol: str,
   593	                      timeframe: str, as_of: str) -> List[Dict[str, float]]:
   594	        supplied = context.get("bars")
   595	        if supplied is None:
   596	            window_bars = context.get("window_bars", self.max_bars)
   597	            try:
   598	                window = await _maybe_await(
   599	                    self.store.get_window(symbol, timeframe, as_of, int(window_bars)))
   600	            except AttributeError as exc:
   601	                raise BridgeError("NO_MARKET_DATA", "store has no PIT window reader") from exc
   602	            supplied = window
   603	        bars = _normalise_bars(supplied)
   604	        for index, bar in enumerate(bars):
   605	            timestamp = bar.get("timestamp", bar.get("as_of"))
   606	            if timestamp is not None:
   607	                stamp_ms = _event_time_ms(timestamp, fallback=None)
   608	                if stamp_ms is not None and stamp_ms > _as_of_ms(as_of):
   609	                    raise BridgeError("BRIDGE_PIT_VIOLATION", f"bar index={index}")
   610	            if bar.get("status") not in (None, "CLOSED"):
   611	                raise BridgeError("DATA_QUALITY_QX", f"bar index={index}")
   612	        return bars
   613
   614	    async def _build(self, raw_context: Mapping[str, Any], *, symbol: str,
   615	                     timeframe: str, as_of: str) -> Mapping[str, Any]:
   616	        context = _flatten_context(raw_context)
   617	        missing_context = [key for key in REQUIRED_CONTEXT_KEYS
   618	                           if key not in context or context[key] is None]
   619	        if missing_context:
   620	            raise BridgeError("BRIDGE_CONTEXT_INCOMPLETE",
   621	                              ",".join(missing_context))
   622	        _validate_e11_context(context["e11_context"])
   623	        transport = context["e11_context"].get("bridge_inputs")
   624	        if transport is not None:
   625	            if not isinstance(transport, Mapping) or set(transport) & set(REQUIRED_CONTEXT_KEYS):
   626	                raise BridgeError("PRODUCER_TRANSPORT_INVALID", "optional inputs overwrite required context")
   627	            context.update(transport)
   628	        regime_label = _regime_label(context["regime_state"])
   629	        # ``events`` is the only evidence path.  A reduced SQL row fails in
   630	        # _fabric_ref rather than being silently upgraded to ACTIVE.
   631	        events = _event_list(_required(context, "events"))
   632	        as_of_ms = _as_of_ms(as_of)
   633	        refs = [_fabric_ref(event, symbol=symbol, timeframe=timeframe,
   634	                            as_of_ms=as_of_ms) for event in events]
   635	        ages = context.get("evidence_age_bars")

