  1557	def complete_engine_bundle(item: Mapping[str, Any], symbol: str, timeframe: str,
  1558	                           artifact: Mapping[str, Any], *, rtm_context: Mapping[str, Any]) -> dict:
  1559	    """Native twelve-engine assembly from the shared PIT feature timeline.
  1560
  1561	    No fixture defaults, replacement indicator or incomplete EvidenceEvent.
  1562	    Native warmup is represented by missing optional evidence, not invented
  1563	    volume/ATR scalars. E06 starts at the actual joint dependency frontier.
  1564	    """
  1565	    from dataclasses import asdict
  1566	    artifact = validate_classifier(artifact)
  1567	    derive_quality = rtm_context.get("derive_avg_quality") is True
  1568	    for key in ("avg_quality", "mtf_align"):
  1569	        if key == "avg_quality" and derive_quality:
  1570	            continue
  1571	        value = rtm_context.get(key)
  1572	        if not isinstance(value, (int, float)) or isinstance(value, bool) or not math.isfinite(value) or not 0 <= value <= 1:
  1573	            raise BridgeError("E07_CONTEXT_UNAVAILABLE", key)
  1574	    if "vector" not in item:
  1575	        raise BridgeError("E11_CONTEXT_UNAVAILABLE", str(item.get("reason", "missing vector")))
  1576	    original = item["frame"]
  1577	    prior_atr = [state.atr14_wilder for state in original["volatility"]["states"][:-1]]
  1578	    frame = upstream_frame(original["raw_window"], symbol, timeframe, emit=True,
  1579	        atr14_history=prior_atr, structure_result=original["structure"],
  1580	        volatility_stream=item["volatility_stream"], temporal_profile=item.get("temporal_profile"))
  1581	    # The timeline's IC/history is authoritative, including the full prior
  1582	    # ATR reference; emission preparation must not replace it with a slice.
  1583	    frame["ic"] = dict(item["ic"])
  1584	    events, order = frame["events"], frame["engine_order"]
  1585	    window, end = frame["window"], item["as_of"]
  1586	    atr_by_idx = {i: value for i, value in enumerate(frame["atr14"]) if value is not None}
  1587	    by_time = {_iso_to_ms(obs.timestamp): i for i, obs in enumerate(window)}
  1588	    struct = {}
  1589	    for event in frame["structural_events"]:
  1590	        i = event["candle_index"]
  1591	        direction = "UP" if "BULLISH" in event["event_type"] else "DOWN"
  1592	        struct.setdefault(i, []).append({"idx": i, "dir": direction, "direction": direction,
  1593	            "kind": "BOS" if event["event_type"].startswith(("EV_STR_007", "EV_STR_008")) else "CHoCH",
  1594	            "valid_at_idx": i, "confirmed_at_idx": i, "source": event})
  1595	    order.append("E05")
  1596	    fvg = E05.run_engine([E05.observation_to_bar(o) for o in window], symbol=symbol,
  1597	        tick_size=E01.resolve_tick_size(symbol), atr_by_idx=atr_by_idx, bos_by_idx=struct)
  1598	    fvg_emitter = E05.E05FVGEngine()
  1599	    objects = sorted(fvg["active"] + fvg["history"], key=lambda obj: obj.created_at_idx)
  1600	    events.extend(fvg_emitter._to_evidence(obj, symbol, timeframe, fvg_emitter._window_quality(window)) for obj in objects)
  1601	    fvg_by_idx = {}
  1602	    for obj in objects:
  1603	        fvg_by_idx.setdefault(obj.created_at_idx, []).append(asdict(obj))
  1604	    volume_by_idx = {}
  1605	    for evidence in frame["volume"].emitted:
  1606	        source_index = evidence.pit_meta["history_len"]
  1607	        source_time = frame["volume"].history_bars[source_index]["ts"]
  1608	        volume_by_idx[by_time[source_time]] = dict(vars(evidence))
  1609	    volatility_by_idx = {by_time[state.as_of]: {"atr_n": state.atr14_wilder,
  1610	        "tr_method": "WILDER", "as_of": state.as_of, "snapshot_id": state.snapshot_id}
  1611	        for state in frame["volatility"]["states"] if state.as_of in by_time}
  1612	    order.append("E06")
  1613	    joint = sorted(set(volume_by_idx) & set(volatility_by_idx))
  1614	    if not joint or joint != list(range(joint[0], len(window))):
  1615	        raise BridgeError("E06_DEPENDENCY_UNAVAILABLE", "no contiguous mature volume/volatility suffix")
  1616	    first = joint[0]
  1617	    ob_context = {"window": window[first:],
  1618	        "volume_evidence": [volume_by_idx[i] for i in joint],
  1619	        "volatility_evidence": [volatility_by_idx[i] for i in joint],
  1620	        "struct_events_by_idx": {i-first: [{**e, "valid_at_idx": i-first} for e in es] for i, es in struct.items() if i >= first},
  1621	        "fvg_by_idx": {i-first: es for i, es in fvg_by_idx.items() if i >= first}}
  1622	    events.extend(E06.E06OrderBlockEngine().compute(symbol, timeframe, end, ob_context))
  1623	    order.append("E11")
  1624	    candle = E11.observation_to_candle(window[-1], dict(item["ic"]))
  1625	    candle.update(prev_close=float(window[-2].close), atr_prev=frame["atr14"][-2],
  1626	        timeframe_seconds=(close_time_ms(_iso_to_ms(original["raw_window"][-1].timestamp), timeframe)
  1627	                           - _iso_to_ms(original["raw_window"][-1].timestamp)) // 1000)
  1628	    regime_context = {"candles": [candle], "W": artifact["W"], "b": artifact["b"],
  1629	        "classifier_artifact_sha256": artifact["artifact_sha256"], "history": item["history"],
  1630	        "mu0": item["mu"], "Sigma0": item["Sigma"], "prev_mom": item["prev_mom"]}
  1631	    regime_engine = E11.E11RegimeEngine()
  1632	    events.extend(regime_engine.compute(symbol, timeframe, end, regime_context))
  1633	    result = regime_engine._last_result
  1634	    state = result["regime_state"]
  1635	    if "snapshot_id" not in state:
  1636	        raise BridgeError("E11_CONTEXT_UNAVAILABLE", str(state.get("reason", state.get("error", "invalid state"))))
  1637	    order.append("E07")
  1638	    direction = "UP" if frame["trend"]["bias"] >= 0 else "DOWN"
  1639	    confirmations = []
  1640	    def confirm(cid, stamp):
  1641	        if stamp not in by_time:
  1642	            raise BridgeError("E07_CONTEXT_UNAVAILABLE", "confirmation outside retained window")
  1643	        confirmations.append({"cid": cid, "t_confirm_ms": stamp,
  1644	                              "p_confirm": float(window[by_time[stamp]].close)})
  1645	    for i, sources in struct.items():
  1646	        for source in sources:
  1647	            if source["direction"] == direction:
  1648	                confirm(source["kind"].lower(), _iso_to_ms(window[i].timestamp))
  1649	    for source in frame["liquidity"].events:
  1650	        prerequisites = source.get("payload", {}).get("prereq", {})
  1651	        if (source.get("event_type") in CONFIRMED_SWEEP_EVENT_TYPES
  1652	                and SWEEP_PREREQUISITES.issubset(prerequisites)
  1653	                and all(prerequisites[key] is True for key in SWEEP_PREREQUISITES)):
  1654	            i = source["at_bar"]
  1655	            if 0 <= i < len(window):
  1656	                confirm("sweep", _iso_to_ms(window[i].timestamp))
  1657	    for obj in objects:
  1658	        if obj.direction == direction:
  1659	            confirm("fvg", obj.created_at_ts)
  1660	    for i, evidence in volume_by_idx.items():
  1661	        if any(str(code).startswith("EV_VOL_001") for code in evidence["events"]):
  1662	            confirm("vol_confirm", _iso_to_ms(window[i].timestamp))
  1663	    quality_contributors = []
  1664	    if derive_quality:
  1665	        used = set()
  1666	        for confirmation in confirmations:
  1667	            cid, stamp = confirmation["cid"], confirmation["t_confirm_ms"]
  1668	            engine = {"bos": "E01", "choch": "E01", "sweep": "E02",
  1669	                      "vol_confirm": "E03", "fvg": "E05"}[cid]
  1670	            matched = [ev for ev in events if ev.engine_id == engine
  1671	                       and _iso_to_ms(ev.event_time) == stamp
  1672	                       and (cid not in ("bos", "choch") or str(ev.condition_state).startswith(
  1673	                            ("EV_STR_007", "EV_STR_008") if cid == "bos" else ("EV_STR_009", "EV_STR_010")))
  1674	                       and (cid != "sweep" or ev.condition_state in CONFIRMED_SWEEP_EVENT_TYPES)]
  1675	            if not matched:
  1676	                raise BridgeError("E07_CONFIRMATION_QUALITY_UNAVAILABLE", f"{engine}:{cid}:{stamp}")
  1677	            for ev in matched:
  1678	                if ev.evidence_id not in used:
  1679	                    used.add(ev.evidence_id)
  1680	                    quality_contributors.append({"engine_id": engine, "evidence_id": ev.evidence_id,
  1681	                        "snapshot_id": ev.snapshot_id, "confirmation_ms": stamp, "quality": ev.quality})
  1682	        avg_quality = confirmation_quality(quality_contributors)
  1683	    else:
  1684	        avg_quality = rtm_context["avg_quality"]
  1685	    events.extend(E07.E07RTMEngine().compute(symbol, timeframe, end, {
  1686	        "window": window, "events": confirmations, "direction": direction,
  1687	        "avg_quality": avg_quality, "mtf_align": rtm_context["mtf_align"],
  1688	        "as_of_ms": _iso_to_ms(end), "temporal_provider": E12.E12TemporalProvider()}))
  1689	    order.append("E08")
  1690	    events.extend(E08.E08WyckoffEngine().compute(symbol, timeframe, end, {"window": window,
  1691	        "atr_by_idx": atr_by_idx,
  1692	        "vol_ratio_by_idx": {i: ev["volume_ratio"] for i, ev in volume_by_idx.items()},
  1693	        "evr_by_idx": {i: ev["evr"] for i, ev in volume_by_idx.items()},
  1694	        "structure_by_idx": {i: ("BULL" if es[-1]["direction"] == "UP" else "BEAR") for i, es in struct.items()},
  1695	        "bos_by_idx": {i: {"confirmed_at_idx": i, "direction": es[-1]["direction"]} for i, es in struct.items()}}))
  1696	    for event in events:
  1697	        try:
  1698	            event.validate_24_fields()
  1699	        except ValueError as exc:
  1700	            raise BridgeError("EVIDENCE_CONTEXT_INVALID",
  1701	                              f"{event.engine_id} resolution_class={event.resolution_class}: {exc}") from exc
  1702	        if _iso_to_ms(event.availability_time) > _iso_to_ms(end):
  1703	            raise BridgeError("BRIDGE_PIT_VIOLATION", event.engine_id)
  1704	    return {**frame, "feature_vector": item["vector"], "rtm_confirmations": confirmations,
  1705	        "rtm_avg_quality": avg_quality, "rtm_quality_contributors": quality_contributors, "regime_state": state, "e11_result": result,
  1706	        "e11_context": {"ic_inputs": dict(item["ic"]), "history_windows": item["history"],
  1707	                        "classifier_W": artifact["W"], "classifier_b": artifact["b"],
  1708	                        "classifier_artifact_sha256": artifact["artifact_sha256"], "regime_state": state},
  1709	        "fvg_objects": objects, "struct_by_idx": struct,
  1710	        "volume_by_idx": volume_by_idx, "volatility_by_idx": volatility_by_idx}

===== apex/ops/engine_context.py:1798-1860 (baseline) =====
  1798	    async def prepare(self, symbol: str, timeframe: str, as_of: str) -> None:
  1799	        """Outside-budget source preparation; a failed refresh clears success."""
  1800	        key = (symbol,timeframe,as_of)
  1801	        self._ready.pop(key,None)
  1802	        self._failed.pop(key,None)
  1803	        try:
  1804	            if self.environment != "PAPER":
  1805	                raise BridgeError("PAPER_ONLY_EXECUTION",self.environment)
  1806	            from apex.data_catalog.contracts import TIMEFRAMES_14
  1807	            if symbol not in CORE10_SYMBOLS or timeframe not in TIMEFRAMES_14:
  1808	                raise BridgeError("CELL_OUT_OF_UNIVERSE",f"{symbol}:{timeframe}")
  1809	            parse_utc_ms(as_of)
  1810	            fingerprint = await self._input_fingerprint(symbol,timeframe,as_of)
  1811	            saved = await read_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,exact=True)
  1812	            if saved and saved["input_fingerprint"] == fingerprint:
  1813	                context = saved["context"]
  1814	                context["events"] = await read_complete_evidence(self.store,context["events"])
  1815	            else:
  1816	                context = await self._compose_bridge_context(symbol,timeframe,as_of)
  1817	                await append_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,
  1818	                    {"input_fingerprint":fingerprint,"context":{**context,"events":[e.evidence_id for e in context["events"]]}})
  1819	            validate_produced_context(context)
