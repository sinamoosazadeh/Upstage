   140	class TestE05FeedsE06:
   141	    def test_fvg_same_dir_supplies_context_or_term(self):
   142	        bars = _chain_scenario_bars()
   143	        atr = 2.0
   144	        vol = [{"snapshot_id": f"v{i}", "as_of_ts": bars[i]["ts"],
   145	                "availability_time_ms": bars[i]["ts"], "volume_sma": 1000.0,
   146	                "volume_ratio": 2.0 if i == 6 else 1.0}
   147	               for i in range(len(bars))]
   148	        vola = [{"snapshot_id": f"a{i}", "as_of": bars[i]["ts"],
   149	                 "atr_n": atr, "tr_method": "E04"} for i in range(len(bars))]
   150	        struct = {5: [{"kind": "BOS", "direction": "UP",
   151	                       "valid_at_idx": 6}]}
   152	        # Disp_multi = 3.2/2 = 1.6 < 1.8 ⇒ the Context OR-term can only
   153	        # be satisfied through an FVG
   154	        no_fvg = run_e06(bars, struct_events_by_idx=struct, fvg_by_idx={},
   155	                         volume_evidence=vol, volatility_evidence=vola)
   156	        q_no_fvg = [e for e in no_fvg["events"]
   157	                    if e["code"] == "EV_OBK_001"][0]["quality"]
   158	        assert q_no_fvg != "Q3"
   159	        # a live E05-style FVG next to the origin supplies the OR-term
   160	        fvg = {6: [{"present": True, "direction": "UP",
   161	                    "lower": 98.8, "upper": 99.5,
   162	                    "type": "CONVENTIONAL"}]}
   163	        with_fvg = run_e06(bars, struct_events_by_idx=struct,
   164	                           fvg_by_idx=fvg, volume_evidence=vol,
   165	                           volatility_evidence=vola)
   166	        q_fvg = [e for e in with_fvg["events"]
   167	                 if e["code"] == "EV_OBK_001"][0]["quality"]
   168	        assert q_fvg == "Q3"
   169
   170	    def test_live_e05_zones_roundtrip_into_e06_shape(self):
   171	        # E05 run on the shared window; every active zone maps cleanly
   172	        # into the I_FVG_v4 consumption shape used by E06
   173	        bars = lcg_window(90)
   174	        _, atr_series = e04_atr_series(bars)
   175	        r = run_e05(bars, tick_size=0.01, symbol="BTCUSDT",
   176	                    atr_by_idx={i: atr_series[i] for i in range(len(bars))})
   177	        shapes = [{"present": True, "direction": z.direction,
   178	                   "lower": z.lower, "upper": z.upper, "type": z.ftype}
   179	                  for z in r["active"]]
   180	        for s in shapes:
   181	            assert s["direction"] in ("UP", "DOWN")
   182	            assert s["lower"] < s["upper"]
