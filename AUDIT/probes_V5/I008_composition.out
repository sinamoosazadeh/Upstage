  1408	def upstream_frame(raw_window: list[Any], symbol: str, timeframe: str,
  1409	                   *, emit: bool = False,
  1410	                   atr14_history: list[float] | None = None,
  1411	                   structure_result: dict | None = None,
  1412	                   volatility_stream: dict | None = None,
  1413	                   temporal_profile: dict | None = None,
  1414	                   engine_profile: dict | None = None) -> dict[str, Any]:
  1415	    """P1's first seven engines, in order, with explicit producer projections.
  1416
  1417	    A 300-bar engine window is the existing paper runtime window. The E11
  1418	    normalization history is assembled separately, over all prior frames.
  1419	    """
  1420	    if not raw_window:
  1421	        raise BridgeError("NO_MARKET_DATA", "empty engine window")
  1422	    window = closed_engine_window(raw_window, timeframe)
  1423	    end = window[-1].timestamp
  1424	    duration = (close_time_ms(_iso_to_ms(raw_window[-1].timestamp), timeframe)
  1425	                - _iso_to_ms(raw_window[-1].timestamp)) // 1000
  1426	    base = {"window": window}
  1427	    events = []
  1428	    order = []
  1429	    def collect(code, cls, context):
  1430	        order.append(code)
  1431	        if emit:
  1432	            events.extend(cls().compute(symbol, timeframe, end, context))
  1433
  1434	    params = E01.get_params()
  1435	    params["tick_size"] = E01.resolve_tick_size(symbol)
  1436	    collect("E01", E01.E01StructureEngine, base)
  1437	    # D35(e) P0: the E01 candle conversion (timestamp parse + content hash
  1438	    # per bar) is pure in its inputs and is discarded whenever the caller
  1439	    # threads a structure_result (the training timeline always does), so
  1440	    # build it lazily only for the uncached reference path. Values are
  1441	    # bitwise-identical either way; this removes one repeated re-parse.
  1442	    if structure_result is None:
  1443	        candles = [E01.observation_to_candle(o, timeframe, duration) for o in window]
  1444	        structure = _time_engine(
  1445	            engine_profile, "E01", E01.run_pipeline, candles, params)
  1446	    else:
  1447	        structure = structure_result
  1448	    bos_events = [ev for ev in structure["events"] if ev["event_type"].startswith(
  1449	        ("EV_STR_007", "EV_STR_008"))]
  1450	    structural_events = [ev for ev in structure["events"] if ev["event_type"].startswith(
  1451	        ("EV_STR_007", "EV_STR_008", "EV_STR_009", "EV_STR_010"))]
  1452	    bos = bos_events[-1] if bos_events else None
  1453	    collect("E02", E02.E02LiquidityEngine, base)
  1454	    liquidity = _time_engine(engine_profile, "E02", E02.run_engine,
  1455	                              [E02.observation_to_candle(o) for o in window])
  1456	    collect("E12", E12.E12TemporalEngine, {**base, "profile": temporal_profile})
  1457	    temporal = _time_engine(engine_profile, "E12", E12.run_engine,
  1458	                            [E12.observation_to_candle(o) for o in window],
  1459	                            profile=temporal_profile)["temporal_state"]
  1460	    order.append("E04")
  1461	    bars = [E04.observation_to_bar(o, timeframe) for o in window]
  1462	    if volatility_stream is None:
  1463	        volatility = _time_engine(engine_profile, "E04", E04.run_engine, bars, timeframe=timeframe)
  1464	    else:
  1465	        # Native chronological E04, never a partial/reimplemented indicator.
  1466	        # Drain only observations already reached by this feature timeline.
  1467	        drain_start = time.monotonic() if engine_profile is not None else 0.0
  1468	        for bar in volatility_stream["pending"]:
  1469	            evidence = volatility_stream["engine"].ingest_bar(bar)
  1470	            if evidence is not None:
  1471	                volatility_stream["evidence"].append(evidence)
  1472	        volatility_stream["pending"].clear()
  1473	        if engine_profile is not None:
  1474	            engine_profile["E04"] += time.monotonic() - drain_start
  1475	        retained = _retained_e04_evidence(volatility_stream["evidence"], bars[0]["ts"], bars[-1]["ts"])
  1476	        volatility = {"engine": volatility_stream["engine"], "states": [e.state for e in retained],
  1477	                      "events": [event for e in retained for event in e.events], "atr_series": [e.atr_scalar for e in retained]}
  1478	    if emit:
  1479	        emitter = E04.E04VolatilityEngine()
  1480	        quality = emitter._window_quality(window)
  1481	        events.extend(emitter._to_evidence(state, symbol, timeframe, quality) for state in volatility["states"] if state.snapshot_id)
  1482	    # D26-A supersedes the provisional ATR20 addition. Consume the actual
  1483	    # published E04 schema and align by as_of, not emitted-list position.
  1484	    atr_by_close = {state.as_of: state.atr14_wilder for state in volatility["states"]}
  1485	    atr14 = [atr_by_close.get(_iso_to_ms(o.timestamp)) for o in window]
  1486	    atr_prev = [None] + atr14[:-1]
  1487	    volume_context = {**base, "atr_prev": atr_prev,
  1488	                      "atr_availability_time_ms": [_iso_to_ms(o.timestamp) for o in window]}
  1489	    collect("E03", E03.E03VolumeEngine, volume_context)
  1490	    volume_bars = [E03.observation_to_bar(o, timeframe, atr_prev[i], None, _iso_to_ms(o.timestamp))
  1491	                   for i, o in enumerate(window)]
  1492	    volume = _time_engine(engine_profile, "E03", E03.run_engine, volume_bars)
  1493	    if not volume.emitted or not volatility["states"]:
  1494	        raise BridgeError("INSUFFICIENT_HISTORY", "E03/E04 warmup")
  1495	    vol = volume.emitted[-1]
  1496	    if volume.history_bars[-1]["ts"] != _iso_to_ms(end):
  1497	        raise BridgeError("ENGINE_CONTEXT_UNAVAILABLE", "E03 latest candle unavailable")
  1498	    vlt = volatility["states"][-1]
  1499	    # E10's Candle contract distinguishes open/close. Its generic wrapper
  1500	    # adds an interval to timestamp; feeding our close-stamped view would
  1501	    # therefore postdate every event. Supply both boundaries explicitly,
  1502	    # including calendar-month closes, to the unchanged native driver.
  1503	    order.append("E10")
  1504	    momentum_bars = [{**E10.observation_to_bar(raw, timeframe), "is_closed": True,
  1505	                      "close_time": _iso_to_ms(closed.timestamp)}
  1506	                     for raw, closed in zip(raw_window, window)]
  1507	    momentum_result = _time_engine(engine_profile, "E10", E10.run_engine, momentum_bars,
  1508	                                    symbol=symbol, interval=timeframe,
  1509	                                    volatility_context=vars(vlt))
  1510	    momentum = momentum_result["state"]
  1511	    if emit and "snapshot_id" in momentum:
  1512	        emitter = E10.E10MomentumEngine()
  1513	        emitter._last_n_bars = int(momentum_result["n_bars"])
  1514	        quality = emitter._window_quality(window)
  1515	        events.extend(emitter._to_evidence(event, symbol, timeframe, quality, momentum)
  1516	                      for event in momentum_result["events"])
  1517	    swings = _trend_swings(structure, window)
  1518	    trend_context = {**base, "swings": swings, "atr": vlt.atr14_wilder,
  1519	                     "tf_seconds": duration, "bos_event": bos, "oi_state": vol.oi_state}
  1520	    collect("E09", E09.E09TrendEngine, trend_context)
  1521	    trend = _time_engine(engine_profile, "E09", E09.run_engine, bars, swings=swings,
  1522	                          atr=vlt.atr14_wilder, tf_seconds=duration, bos_event=bos,
  1523	                          oi_state=vol.oi_state)
  1524	    # ISSUE-CP14-011 projections are resolved by owner D26-A/B.
  1525	    # An explicit empty history is unavailable, never replaced by a fallback.
  1526	    prior = ([state.atr14_wilder for state in volatility["states"]
  1527	              if state.as_of < _iso_to_ms(end)]
  1528	             if atr14_history is None else atr14_history)
  1529	    projection_refusals = []
  1530	    try:
  1531	        atr_z = atr_z_input(vlt, prior)
  1532	    except ValueError as exc:
  1533	        if not str(exc).startswith("INVALID_E11_HISTORY:"):
  1534	            raise
  1535	        atr_z = None
  1536	        projection_refusals.append("INVALID_E11_HISTORY")
  1537	    part = participation_input(vol.volume_z, vol.oi_z, vol.oi_state)
  1538	    macro = trend["stack"]["MACRO"]
  1539	    raw_trend = sum(weight * (trend["stack"][scale] * macro > 0)
  1540	                    for scale, weight in E09.W_STACK_CORRECTED.items())
  1541	    is_bos = bool(bos and bos["candle_index"] == len(window) - 1)
  1542	    ic = {"trendiness_raw": raw_trend, "vol_ratio": vlt.vol_ratio,
  1543	          "expansion_raw": vlt.vol_ratio * is_bos, **liquidity_inputs(liquidity),
  1544	          "structure_score": float(bos["strength"]["S"]) if bos else 0.0,
  1545	          "momentum_state_raw": E10.momentum_state_projection(momentum)["momentum_state_raw"],
  1546	          "atr_z": atr_z, **part}
  1547	    return {"window": window, "raw_window": raw_window, "bars": bars, "ic": ic,
  1548	            "structure": structure, "structural_events": structural_events,
  1549	            "confirmation": any(e["candle_index"] == len(window) - 1 for e in structural_events),
  1550	            "liquidity": liquidity, "volume": volume, "volume_bars": volume_bars,
  1551	            "volatility": volatility, "vlt": vlt, "atr14": atr14,
  1552	            "momentum": momentum, "trend": trend, "temporal": temporal,
  1553	            "events": events, "engine_order": order,
  1554	            "projection_refusals": projection_refusals}

