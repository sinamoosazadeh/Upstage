   185	# ---------------------------------------------------------------------------
   186	# §8.6 cross-engine redundancy guard (E05 zone vs E06 zone)
   187	# ---------------------------------------------------------------------------
   188	class TestCrossEngineRedundancy:
   189	    def test_iou_and_midpoint_gate_flags_redundant_pair(self):
   190	        atr = 2.0
   191	        fvg_lo, fvg_hi = 100.0, 102.0           # E05 zone
   192	        ob_lo, ob_hi = 100.2, 102.2             # E06 zone
   193	        iou = iou_zones(fvg_lo, fvg_hi, ob_lo, ob_hi)
   194	        mid_dist = abs((fvg_lo + fvg_hi) / 2 - (ob_lo + ob_hi) / 2)
   195	        assert iou > 0.6 and mid_dist < 0.2 * atr   # redundant pair
   196	        # a distant pair is not redundant
   197	        iou2 = iou_zones(fvg_lo, fvg_hi, 110.0, 112.0)
   198	        assert iou2 == 0.0
