   258	# ---------------------------------------------------------------------------
   259	# T-DR-001 across all three CP-3 engines (one shared window)
   260	# ---------------------------------------------------------------------------
   261	class TestTDR001CP3:
   262	    def test_double_run_byte_identical_all_engines(self):
   263	        bars = lcg_window(100)
   264
   265	        def run_all():
   266	            e04, atr_series = e04_atr_series(bars)
   267	            r05 = run_e05(bars, tick_size=0.01, symbol="BTCUSDT",
   268	                          atr_by_idx={i: atr_series[i]
   269	                                      for i in range(len(bars))})
   270	            vol = [{"snapshot_id": f"v{i}", "as_of_ts": bars[i]["ts"],
   271	                    "availability_time_ms": bars[i]["ts"],
   272	                    "volume_sma": 1000.0,
   273	                    "volume_ratio": 2.0 if i == 6 else 1.0}
   274	                   for i in range(len(bars))]
   275	            vola = [{"snapshot_id": f"a{i}", "as_of": bars[i]["ts"],
   276	                     "atr_n": atr_series[i], "tr_method": "E04"}
   277	                    for i in range(len(bars))]
   278	            r06 = run_e06(bars, struct_events_by_idx={
   279	                5: [{"kind": "BOS", "direction": "UP", "valid_at_idx": 6}]},
   280	                fvg_by_idx={}, volume_evidence=vol,
   281	                volatility_evidence=vola)
   282	            return e04, r05, r06
   283
   284	        e04_a, r05_a, r06_a = run_all()
   285	        e04_b, r05_b, r06_b = run_all()
   286	        # E04: canonical state series identical
   287	        ids_a = [s.snapshot_id for s in e04_a["states"]]
   288	        ids_b = [s.snapshot_id for s in e04_b["states"]]
   289	        assert ids_a == ids_b and ids_a
   290	        # E05: fid + snapshot identical
   291	        f05_a = sorted((o.fid, o.snapshot_id)
   292	                       for o in r05_a["active"] + r05_a["history"])
   293	        f05_b = sorted((o.fid, o.snapshot_id)
   294	                       for o in r05_b["active"] + r05_b["history"])
   295	        assert f05_a == f05_b
   296	        # E06: canonical OB list identical
   297	        c06_a = sorted(o.snapshot_id for o in r06_a["obs"])
   298	        c06_b = sorted(o.snapshot_id for o in r06_b["obs"])
   299	        assert c06_a == c06_b
   300
   301	    def test_e06_fail_closed_without_upstream_evidence(self):
   302	        bars = lcg_window(40)
   303	        with pytest.raises(ValueError, match="MISSING_EVIDENCE_QX"):
