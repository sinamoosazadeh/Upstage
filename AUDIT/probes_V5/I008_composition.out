  1798	    async def prepare(self, symbol: str, timeframe: str, as_of: str) -> None:
  1799	        """Outside-budget source preparation; a failed refresh clears success."""
  1800	        key = (symbol,timeframe,as_of)
  1801	        self._ready.pop(key,None)
  1802	        self._failed.pop(key,None)
  1803	        try:
  1804	            if self.environment != "PAPER":
  1805	                raise BridgeError("PAPER_ONLY_EXECUTION",self.environment)
  1806	            from apex.data_catalog.contracts import TIMEFRAMES_14
  1807	            if symbol not in CORE10_SYMBOLS or timeframe not in TIMEFRAMES_14:
  1808	                raise BridgeError("CELL_OUT_OF_UNIVERSE",f"{symbol}:{timeframe}")
  1809	            parse_utc_ms(as_of)
  1810	            fingerprint = await self._input_fingerprint(symbol,timeframe,as_of)
  1811	            saved = await read_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,exact=True)
  1812	            if saved and saved["input_fingerprint"] == fingerprint:
  1813	                context = saved["context"]
  1814	                context["events"] = await read_complete_evidence(self.store,context["events"])
  1815	            else:
  1816	                context = await self._compose_bridge_context(symbol,timeframe,as_of)
  1817	                await append_context_fact(self.store,"BRIDGE_CONTEXT",symbol,timeframe,as_of,
  1818	                    {"input_fingerprint":fingerprint,"context":{**context,"events":[e.evidence_id for e in context["events"]]}})
  1819	            validate_produced_context(context)
  1820	            self._ready[key] = context
  1821	        except BridgeError as exc:
  1822	            self._failed[key] = exc
  1823	            raise
  1824	        except (ValueError,KeyError,TypeError,ArithmeticError) as exc:
  1825	            refusal = BridgeError("ENGINE_CONTEXT_INVALID",f"{type(exc).__name__}: {exc}")
  1826	            self._failed[key] = refusal
  1827	            raise refusal from exc
  1828
  1829	    async def get_bridge_context(self, symbol: str, timeframe: str, as_of: str) -> dict:
  1830	        """Exactly 38 context fields / 23 risk fields; no fixture fallback.
  1831
  1832	        PAPER serve binds prepare separately so this accessor is a cheap copy
  1833	        inside the scheduler budget. A standalone caller may prepare lazily.
  1834	        """
  1835	        import copy
  1836	        key = (symbol,timeframe,as_of)
  1837	        if key in self._failed:
  1838	            raise self._failed[key]
  1839	        if key not in self._ready:
  1840	            await self.prepare(symbol,timeframe,as_of)
  1841	        return copy.deepcopy(self._ready[key])
  1842
