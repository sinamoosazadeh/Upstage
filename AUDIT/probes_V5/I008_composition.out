    87	class TestE04FeedsDownstream:
    88	    def test_e04_atr_series_drives_e05_gate_d(self):
    89	        bars = lcg_window(80)
    90	        _, atr_series = e04_atr_series(bars)
    91	        assert len(atr_series) == len(bars)
    92	        assert all(a > 0 for a in atr_series)
    93	        # E05 consumes the E04 ATR pathway (atr_by_idx) — zones whose
    94	        # width clears 0.2·ATR(E04) are created; none below it
    95	        r = run_e05(bars, tick_size=0.01, symbol="BTCUSDT",
    96	                    atr_by_idx={i: atr_series[i] for i in range(len(bars))})
    97	        zones = r["active"] + r["history"]
    98	        for z in zones:
    99	            i = z.created_at_idx
   100	            assert z.width >= 0.2 * atr_series[i] - 1e-9
   101
   102	    def test_e04_atr_as_e06_volatility_evidence(self):
   103	        bars = lcg_window(60)
   104	        _, atr_series = e04_atr_series(bars)
   105	        vol_evidence = [{"snapshot_id": f"e04_{i}", "as_of": bars[i]["ts"],
   106	                         "atr_n": atr_series[i],
   107	                         "tr_method": "E04_I_Volatility_v4"}
   108	                        for i in range(len(bars))]
   109	        vol_volume = [{"snapshot_id": f"e03_{i}", "as_of_ts": bars[i]["ts"],
   110	                       "availability_time_ms": bars[i]["ts"],
   111	                       "volume_sma": 1500.0,
   112	                       "volume_ratio": bars[i]["v"] / 1500.0}
   113	                      for i in range(len(bars))]
   114	        res = run_e06(bars, volume_evidence=vol_volume,
   115	                      volatility_evidence=vol_evidence)
   116	        # E06 ran to completion on E04-supplied ATR (no internal
   117	        # recomputation path exists — see unit consumption lint)
   118	        assert res["engine"].atr == pytest.approx(atr_series)
