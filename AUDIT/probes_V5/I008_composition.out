   204	class TestEmissionsInsertIntoStore:
   205	    def test_e04_e05_e06_events_insert(self):
   206	        bars = lcg_window(120)
   207	        window = obs_window(bars)
   208	        _, atr_series = e04_atr_series(bars)
   209	        vol = [{"snapshot_id": f"v{i}", "as_of_ts": bars[i]["ts"],
   210	                "availability_time_ms": bars[i]["ts"], "volume_sma": 1000.0,
   211	                "volume_ratio": 2.0 if i == 6 else 1.0}
   212	               for i in range(len(bars))]
   213	        vola = [{"snapshot_id": f"a{i}", "as_of": bars[i]["ts"],
   214	                 "atr_n": atr_series[i], "tr_method": "E04"}
   215	                for i in range(len(bars))]
   216	        evs = []
   217	        evs += E04VolatilityEngine().compute(
   218	            "BTCUSDT", "1h", "2026-01-06T00:00:00Z", {"window": window})
   219	        evs += E05FVGEngine().compute(
   220	            "BTCUSDT", "1h", "2026-01-06T00:00:00Z",
   221	            {"window": window, "tick_size": 0.01,
   222	             "atr_series": atr_series})
   223	        evs += E06OrderBlockEngine().compute(
   224	            "BTCUSDT", "1h", "2026-01-06T00:00:00Z",
   225	            {"window": window, "volume_evidence": vol,
   226	             "volatility_evidence": vola,
   227	             "struct_events_by_idx": {5: [{"kind": "BOS",
   228	                                           "direction": "UP",
   229	                                           "valid_at_idx": 6}]}})
   230	        assert evs
   231	        engine_ids = {ev.engine_id for ev in evs}
   232	        assert {"E04", "E05", "E06"} <= engine_ids
   233	        for ev in evs:
   234	            ev.validate_24_fields()
   235
   236	        async def scenario():
   237	            store = SQLiteStore(path=":memory:")
   238	            await store.open()
   239	            try:
   240	                for ev in evs[:30]:
   241	                    await store.insert_evidence(ev)
   242	                cur = await store.db.execute(
   243	                    "SELECT COUNT(*) FROM evidence_event")
   244	                count = (await cur.fetchone())[0]
   245	                cur = await store.db.execute(
   246	                    "SELECT DISTINCT engine_id FROM evidence_event "
   247	                    "ORDER BY engine_id")
   248	                engines = [r[0] for r in await cur.fetchall()]
   249	                return count, engines
   250	            finally:
   251	                await store.close()
   252
   253	        count, engines = asyncio.run(scenario())
   254	        assert count == min(30, len(evs))
   255	        assert set(engines) <= {"E04", "E05", "E06"} and engines
