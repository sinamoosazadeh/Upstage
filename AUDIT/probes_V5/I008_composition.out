   121	# ---------------------------------------------------------------------------
   122	# E05 → E06 chain: FVG evidence lifts the OB Context term
   123	# ---------------------------------------------------------------------------
   124	def _chain_scenario_bars():
   125	    bars = []
   126	    for i in range(5):
   127	        bars.append({"o": 100.0, "h": 100.2, "l": 99.8, "c": 100.1,
   128	                     "v": 1000, "ts": i * 3600000})
   129	    bars.append({"o": 100.5, "h": 101.0, "l": 98.5, "c": 98.8, "v": 1500,
   130	                 "ts": 5 * 3600000})                     # bearish origin
   131	    bars.append({"o": 98.8, "h": 101.9, "l": 98.7, "c": 101.6, "v": 3000,
   132	                 "ts": 6 * 3600000})                     # displacement UP
   133	    for j in range(12):
   134	        bars.append({"o": 101.6 + 0.1 * j, "h": 102.2 + 0.1 * j,
   135	                     "l": 101.4 + 0.1 * j, "c": 101.9 + 0.1 * j,
   136	                     "v": 1200, "ts": (7 + j) * 3600000})
   137	    return bars
   138
