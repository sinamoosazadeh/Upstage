   512	class PaperPlanBridge:
   513	    """A deterministic PAPER-only provider for the frozen runtime seam."""
   514
   515	    def __init__(self, *, store: Any, environment: str = "PAPER",
   516	                 context_source: Optional[ContextSource] = None,
   517	                 context_preparer: Optional[ContextSource] = None,
   518	                 max_bars: int = 300) -> None:
   519	        self.store = store
   520	        self.environment = str(environment)
   521	        self.context_source = context_source
   522	        self.context_preparer = context_preparer
   523	        self.max_bars = int(max_bars)
   524	        if self.max_bars <= 0:
   525	            raise ValueError("max_bars must be positive")
   526	        self.refusals: Dict[str, Dict[str, str]] = {}
   527	        self.traces: Dict[str, Dict[str, Any]] = {}
   528	        self.plans: Dict[str, Dict[str, Any]] = {}
   529
   530	    async def prepare(self, symbol: str, timeframe: str, as_of: str) -> None:
   531	        """Outside-budget preparation, explicitly bound at composition time.
   532
   533	        Never call the plan builder here: preparation may publish/read
   534	        evidence but cannot materialize a decision or consume a trade slot.
   535	        """
   536	        if self.context_preparer is not None:
   537	            if self.environment != "PAPER":
   538	                raise BridgeError("PAPER_ONLY_EXECUTION", self.environment)
   539	            await _maybe_await(self.context_preparer(symbol, timeframe, as_of))
   540
   541	    async def __call__(self, symbol: str, timeframe: str, as_of: str
   542	                       ) -> Optional[Mapping[str, Any]]:
   543	        key = f"{symbol}:{timeframe}"
   544	        try:
   545	            if self.environment != "PAPER":
   546	                raise BridgeError("PAPER_ONLY_EXECUTION", self.environment)
   547	            if symbol not in CORE10_SYMBOLS or timeframe not in TIMEFRAMES_14:
   548	                raise BridgeError("CELL_OUT_OF_UNIVERSE", key)
   549	            source = await self._source_context(symbol, timeframe, as_of)
   550	            if source is None:
   551	                raise BridgeError(
   552	                    "ENGINE_CONTEXT_UNAVAILABLE",
   553	                    "no governed engine context or complete persisted evidence reader",
   554	                )
   555	            plan = await self._build(source, symbol=symbol, timeframe=timeframe,
   556	                                     as_of=as_of)
   557	            self.refusals.pop(key, None)
   558	            self.plans[key] = dict(plan)
   559	            return plan
   560	        except BridgeError as exc:
   561	            self.refusals[key] = {"reason": exc.reason, "detail": exc.detail}
   562	            return None
   563	        except FamilyError as exc:
   564	            self.refusals[key] = {"reason": exc.reason, "detail": exc.detail}
   565	            return None

