   766	        _say("APEX_GEN5 — 24/7 runtime (reconcile-first boot → the 140-cell "
   767	             "scheduler → the SL-5 → SL-6 trade_plan queue → execution FSM)")
   768	        drift = await C.measure_drift(
   769	            _venue_server_time if adapter is not None else _no_venue_time, clock)
   770	        boot = await driver.boot(drift_seconds=drift.get("drift_seconds"))
