   772	            EC.load_classifier()
   773	            artifact_name = "E11_ARTIFACT"
   774	        except EC.BridgeError as exc:
   775	            artifact_name = exc.reason
   776	        _say(f"  boot_state={boot['boot_state']} "
   777	             f"new_trades_allowed={boot['new_trades_allowed']} "
   778	             f"drift={drift['state']} ({drift.get('reason') or 'measured'}) "
   779	             f"artifact={artifact_name}")
   780	        if driver.plan_provider is None:
   781	            _say("  plan seam: NO PLANS WIRED — every cell halts with the named "
