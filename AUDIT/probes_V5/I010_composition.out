   787	             f"max_trades_per_cycle={driver.max_trades_per_cycle} · "
   788	             f"telegram={'WIRED' if gateway is not None else 'DISABLED (no token)'}")
   789	        _say("  (Ctrl-C stops the loop; the ledger chain and the durable "
   790	             "cursors stay consistent)")
   791	        outcome = await driver.run(cycles=cycles, interval=interval)
   792	        for cycle in driver.cycles[-3:]:
   793	            _say(f"  cycle {cycle['cycle']}: cells={cycle['cells_due']} "
   794	                 f"complete={cycle['cells_complete']} "
   795	                 f"halted={cycle['cells_halted']} blocked={cycle['cells_blocked']} "
   796	                 f"trades={len(cycle['trades'])} open={len(cycle['open_intents'])}")
   797	            if cycle.get("halt_reasons"):
   798	                _say(f"    named refusals: "
   799	                     f"{json.dumps(cycle['halt_reasons'], sort_keys=True)}")
   800	        _say(f"  cycles={outcome['cycles']} trades={outcome['trades']} "
   801	             f"open={outcome['open_intents']} refusals={outcome['refusals']} "
   802	             f"ledger_chain_intact={outcome['ledger_chain_intact']}")
   803	        if as_json:
   804	            _say(json.dumps({"boot": boot, "outcome": outcome,
   805	                             "cycles": driver.cycles}, default=str, indent=2,
   806	                            sort_keys=True))
   807	        return EXIT_READY if boot["boot_state"] == "READY" else EXIT_DEGRADED
   808	    finally:
   809	        if gateway is not None:
   810	            await gateway.aclose()
   811	        await service.close()
   812	        await runtime.stop()
