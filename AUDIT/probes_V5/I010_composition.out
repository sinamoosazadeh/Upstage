   731	                     "EMERGENCY_CANCEL_ALL", "EMERGENCY_CLOSE_ALL",
   732	                     "EMERGENCY_SAFE_MODE", "EXPORT", "BACKTEST_RUN"):
   733	            control.register(name, _noop_handler(name))
   734	        if cfg.telegram_bot_token:
