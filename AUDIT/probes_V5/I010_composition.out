   559	    async def insert_snapshot(self, snapshot: Dict[str, Any]) -> None:
   560	        from apex.identity.canonical_json import canonical_json
   561	        qs = snapshot.get("quality_state", {})
   562	        await self.db.execute(
   563	            "INSERT INTO snapshot_pit (snapshot_id, as_of, symbol_scope, "
   564	            " timeframe_scope, source_state, manifest_hash, "
   565	            " parameter_package_id, code_version, vector_quality_state, "
   566	            " min_quality, weighted_quality, created_at) "
   567	            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
   568	            (snapshot["snapshot_id"], snapshot.get("as_of"),
   569	             ",".join(snapshot.get("symbol_scope", [])),
   570	             ",".join(snapshot.get("timeframe_scope", [])),
   571	             snapshot.get("source_state", "VALID"),
   572	             snapshot.get("manifest_hash"), snapshot.get("parameter_package_id"),
   573	             snapshot.get("code_version"), canonical_json(qs),
   574	             qs.get("min_q"), qs.get("weighted_q"), _utc_now_ms_iso()))
   575	        await self.db.commit()
   576
   577	    async def insert_evidence(self, event: EvidenceEvent) -> None:
   578	        """Validate the 24-field contract, then insert the Data-Plane row
   579	        (contract→DDL mapping at APEX_GEN5.md L18185)."""
   580	        event.validate_24_fields()
   581	        row = event.to_ddl_row()
   582	        # DDL columns beyond the 24-field contract (price_level/epsilon/atr/
   583	        # volume/oi/regime/utc_activity_window_id/authority/authority_scope/
   584	        # payload_hash/source_hash/until) are implementation extensions
   585	        # governed by SL-12 — no DDL column is removed (L18185). Engine
   586	        # stages populate them; CP-1 fills TEXT-typed columns with ''.
   587	        await self.db.execute(
   588	            "INSERT INTO evidence_event (evidence_id, timestamp_utc, symbol, "
   589	            " timeframe, engine_id, event_type, price_level, strength, "
   590	            " confidence, quality, validity, snapshot_id, parent_ids, "
   591	            " payload_hash, source_hash, epsilon, atr, volume, oi, regime, "
   592	            " utc_activity_window_id, lineage, until, raw, authority, "
   593	            " authority_scope) "
   594	            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
   595	            (row["evidence_id"], row["timestamp_utc"], row["symbol"],
   596	             row["timeframe"], row["engine_id"], row["event_type"], "",
   597	             row["strength"], row["confidence"], str(row["quality"]),
   598	             row["validity"], row["snapshot_id"], row["parent_ids"],
   599	             None, None, "", "", "", "", "", "",
   600	             row["lineage"], "", row["raw"], "", ""))
   601	        await self.db.commit()

