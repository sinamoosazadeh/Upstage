  1884	            data_trust=q["data_trust"],raw_observation_ids=bundle["raw_observation_ids"])

===== apex/ops/engine_context.py:3484-3498 (baseline) =====
  3484	async def persist_complete_evidence(store: Any, events: list[Any]) -> list[Any]:
  3485	    """Use the canonical public insert, then verify full readback equality."""
  3486	    for event in events:
  3487	        row = await (await store.db.execute(
  3488	            "SELECT raw FROM evidence_event WHERE evidence_id=?",
  3489	            (event.evidence_id,))).fetchone()
  3490	        if row is not None:
  3491	            if canonical_json(evidence_from_raw(row[0])) != canonical_json(event):
  3492	                raise BridgeError("EVIDENCE_CONTEXT_INVALID", "evidence identity collision")
  3493	        else:
  3494	            await store.insert_evidence(evidence_storage_copy(event))
  3495	    result = await read_complete_evidence(store, [e.evidence_id for e in events])
  3496	    if canonical_json(result) != canonical_json(events):
  3497	        raise BridgeError("EVIDENCE_CONTEXT_INVALID", "complete-event round trip mismatch")
  3498	    return result

===== apex/ops/engine_context.py:3544-3580 (baseline) =====
  3544	async def append_context_fact(store: Any, kind: str, symbol: str, timeframe: str,
  3545	                              as_of: str, data: Mapping) -> str:
  3546	    """Append an identity-bound producer input/result via public snapshot API.
  3547
  3548	    No UPDATE/DELETE, schema change or replacement of raw availability. The
  3549	    input owner supplies measurement time, not the candle's convenient time.
  3550	    """
  3551	    as_of = _ms_to_iso(_iso_to_ms(as_of))
  3552	    body = {"kind": kind, "symbol": symbol, "timeframe": timeframe,
  3553	            "as_of": as_of, "data": dict(data)}
  3554	    identity = hashlib.sha256(canonical_json(body).encode()).hexdigest()
  3555	    found = await (await store.db.execute("SELECT snapshot_id FROM snapshot_pit WHERE snapshot_id=?", (identity,))).fetchone()
  3556	    if not found:
  3557	        await store.insert_snapshot({"snapshot_id": identity, "as_of": as_of,
  3558	            "symbol_scope": [symbol], "timeframe_scope": [timeframe],
  3559	            "source_state": "CP14_"+kind, "parameter_package_id": "CP14_PRODUCER_V1",
  3560	            "code_version": "CP14_PRODUCER_V1", "quality_state": body})
  3561	    return identity
  3562
  3563
  3564	async def read_context_fact(store: Any, kind: str, symbol: str, timeframe: str,
  3565	                            as_of: str, *, exact: bool = False) -> dict | None:
  3566	    import json
  3567	    rows = await (await store.db.execute(
  3568	        "SELECT snapshot_id,vector_quality_state,as_of FROM snapshot_pit "
  3569	        "WHERE source_state=? AND symbol_scope=? AND timeframe_scope=? AND as_of"+
  3570	        ("=?" if exact else "<=?")+" ORDER BY as_of DESC,rowid DESC LIMIT 1",
  3571	        ("CP14_"+kind, symbol, timeframe, as_of))).fetchall()
  3572	    if not rows:
  3573	        return None
  3574	    try:
  3575	        identity, raw, stamp = rows[0]
  3576	        body = json.loads(raw)
  3577	        if (hashlib.sha256(canonical_json(body).encode()).hexdigest() != identity
  3578	                or (body["kind"], body["symbol"], body["timeframe"], body["as_of"]) != (kind,symbol,timeframe,stamp)):
  3579	            raise ValueError("fact identity mismatch")
  3580	        return {**body["data"], "fact_snapshot_id": identity, "fact_as_of": stamp}

