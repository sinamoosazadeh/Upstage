  1174	async def persist_public_venue_facts(store: Any, symbol: str, *, environment: str,
  1175	                                    client: Any = None,
  1176	                                    now: Callable[[], float] = time.time) -> dict:
  1177	    package = paper_package_binding(environment=environment)
  1178	    if package is None:
  1179	        raise BridgeError("LIVE_GOVERNANCE_UNAVAILABLE", "PAPER publisher is not a LIVE package source")
  1180	    refusal = None
  1181	    try:
  1182	        facts = await collect_public_venue_facts(symbol, client=client, now=now)
  1183	        payload, observed_at = {"venue_facts": facts}, facts["observed_at"]
  1184	    except BridgeError as exc:
  1185	        # Append failure too: a later missing fact must not resurrect an old
  1186	        # successful measurement. This never affects another symbol's row.
  1187	        refusal = exc
  1188	        observed_at = _ms_to_iso(int(now() * 1000))
  1189	        payload = {"venue_fact_refusal": {"symbol": symbol, "observed_at": observed_at,
  1190	                                          "reason": exc.reason}}
  1191	    bound = {"source_state": "PUBLIC_VENUE_FACTS", **payload,
  1192	             "parameter_package_id": package["parameter_package_id"]}
  1193	    identity = hashlib.sha256(canonical_json(bound).encode("utf-8")).hexdigest()
  1194	    exists = await (await store.db.execute("SELECT snapshot_id FROM snapshot_pit WHERE snapshot_id=?", (identity,))).fetchone()
  1195	    if exists is None:
  1196	        await store.insert_snapshot({"snapshot_id": identity, "as_of": observed_at,
  1197	            "symbol_scope": [symbol], "source_state": "PUBLIC_VENUE_FACTS",
  1198	            "parameter_package_id": package["parameter_package_id"], "code_version": "CP14-D28-v1",
  1199	            "quality_state": payload})
  1200	    if refusal is not None:
  1201	        raise refusal
  1202	    return facts
  1203

