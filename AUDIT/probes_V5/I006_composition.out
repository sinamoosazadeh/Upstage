   789	def observation_to_bar(obs: MarketObservation) -> Dict[str, Any]:
   790	    ts = obs.timestamp
   791	    try:
   792	        import datetime
   793	        dt = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
