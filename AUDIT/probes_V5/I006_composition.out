   748	def observation_to_bar(obs: MarketObservation) -> Dict[str, Any]:
   749	    ts = obs.timestamp
   750	    try:
   751	        import datetime
   752	        dt = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
   753	        ts_ms = int(dt.timestamp() * 1000)
   754	    except (ValueError, AttributeError):
   755	        ts_ms = 0
   756	    return {"o": float(obs.open), "h": float(obs.high),
   757	            "l": float(obs.low), "c": float(obs.close),
   758	            "v": float(obs.volume), "ts_close": ts_ms,
   759	            "symbol": obs.symbol}
   760	
   761	
   762	class E05FVGEngine(EngineBase):
   763	    """E05_FVG on the frozen EngineBase contract (v4.0.0).
   764	
   765	    compute(symbol, timeframe, as_of, context): window via
   766	    context['window'] or a sync WindowProvider. Consumed context keys:
   767	    window, provider, bars, e05_params, tick_size,
   768	    htf_fvgs (List[FVGObject] — MTF_FVG_HTF@^4.0.0 input contract §1.3),
   769	    trend_htf (UP/DOWN from E09-governed context),
   770	    bos_events (E01_STRUCTURE_BOS@^3.2.0 governed input),
   771	    atr_series (E04_ATR@^2.3.0 governed input — consumed, never
   772	    recomputed for normative decisions). Produces FVG_ZONE@^4.0.0
   773	    evidence on topics evidence.E05.* ."""
   774	
   775	    engine_id = "E05"
   776	    analyst_version = ANALYST_VERSION
   777	    code_revision = "0" * 40
   778	
   779	    def compute(self, symbol: str, timeframe: str, as_of: str,
   780	                context: Optional[Dict[str, Any]] = None
   781	                ) -> List[EvidenceEvent]:
   782	        context = context or {}
   783	        window_obs = self._resolve_window(symbol, timeframe, as_of, context)
   784	        if not window_obs:
   785	            return []
   786	        bars = [observation_to_bar(o) for o in window_obs]
   787	        params = get_params(context.get("e05_params"))
   788	        atr_series = context.get("atr_series")
   789	        atr_by_idx = ({i: float(v) for i, v in enumerate(atr_series)}
   790	                      if atr_series is not None else None)
   791	        result = run_engine(
   792	            bars, params,
   793	            tick_size=float(context.get("tick_size", 0.01)),
   794	            symbol=symbol,
   795	            htf_fvgs_by_idx=context.get("htf_fvgs_by_idx"),
   796	            trend_htf_by_idx=context.get("trend_htf_by_idx"),
   797	            bos_by_idx=context.get("bos_by_idx"),
   798	            atr_by_idx=atr_by_idx)
   799	        quality = self._window_quality(window_obs)
   800	        out: List[EvidenceEvent] = []
   801	        for fvg in result["active"] + result["history"]:
   802	            out.append(self._to_evidence(fvg, symbol, timeframe, quality))
   803	        return out
   804	
   805	    def _resolve_window(self, symbol: str, timeframe: str, as_of: str,
   806	                        context: Dict[str, Any]) -> List[MarketObservation]:
   807	        window = context.get("window")
   808	        if window is not None:
   809	            return list(window)
   810	        provider = context.get("provider")

