   185	def validate_market_observation(
   186	    obs: MarketObservation,
   187	    prev_sequence: Optional[int] = None,
   188	) -> None:
   189	    """AI.4 validation order (sequential, fail-fast; T-DC-002).
   190	
   191	    Steps 1–8 are structural; step 9 (availability vs as_of) is enforced by
   192	    the PIT module; step 10 (source health) is reported via the quality
   193	    vector. Raises ValidationError with the first failing Ch.7 code.
   194	    """
   195	    # 1. schema conformance (T-DC-001: all 10 fields present, typed)
   196	    for name in ("symbol", "timeframe", "timestamp", "status"):
   197	        if not isinstance(getattr(obs, name), str) or not getattr(obs, name):
   198	            raise ValidationError("E-Q-001", f"missing/blank field {name}")
   199	    for name in ("open", "high", "low", "close", "volume"):
   200	        if not isinstance(getattr(obs, name), Decimal):
   201	            raise ValidationError("E-Q-001", f"field {name} not Decimal")
   202	    if not isinstance(obs.sequence, int):
   203	        raise ValidationError("E-Q-001", "sequence not int")
   204	    # 2. finite numerics (NaN/Inf forbidden — never silently dropped)
   205	    for name in ("open", "high", "low", "close", "volume"):
   206	        v = getattr(obs, name)
   207	        if not v.is_finite():
   208	            code = "E-NUM-001" if v.is_nan() else "E-NUM-002"
   209	            raise ValidationError(code, f"{name} non-finite")
   210	    if obs.oi is not None and not obs.oi.is_finite():
   211	        code = "E-NUM-001" if obs.oi.is_nan() else "E-NUM-002"
   212	        raise ValidationError(code, "oi non-finite")
   213	    # 3. OHLC bounds: H >= max(O,C), L <= min(O,C), H >= L, no swaps
   214	    if obs.open < 0 or obs.high < 0 or obs.low < 0 or obs.close < 0:
   215	        raise ValidationError("E-Q-001", "negative OHLC price")
   216	    if obs.high < max(obs.open, obs.close) or obs.low > min(obs.open, obs.close):
   217	        raise ValidationError("QX_INVALID", "OHLC bounds violated (H<max(O,C) or L>min(O,C))")
   218	    if obs.high < obs.low:
   219	        raise ValidationError("QX_INVALID", "High < Low — physically impossible; reject, never swap")
   220	    # 4. volume and OI non-negative; zero volume permitted only for OPEN

===== apex/ops/bootstrap_service.py:156-180 (baseline) =====
   156	def _ohlc_violation(row: Any) -> Optional[str]:
   157	    """The frozen OHLC law over one venue row; ``None`` when the row is sane.
   158	
   159	    Only OHLC is judged — volume/quote-volume/trade-count fields are NEVER a
   160	    drop reason (the frozen client keeps parsing them tolerantly). A row that
   161	    is geometrically impossible is returned with the named reason so the
   162	    caller can drop it with evidence instead of reaching the DDL CHECK.
   163	    """
   164	    fields = _kline_ohlc_fields(row)
   165	    if fields is None:
   166	        return None
   167	    parsed = [_decimal_or_none(value) for value in fields]
   168	    for name, value in zip(_OHLC_NAMES, parsed):
   169	        if value is None:
   170	            return f"{REASON_OHLC_NOT_PARSEABLE}:{name}"
   171	    open_, high, low, close = parsed
   172	    if high < max(open_, close):
   173	        return REASON_HIGH_BELOW_MAX_OPEN_CLOSE
   174	    if low > min(open_, close):
   175	        return REASON_LOW_ABOVE_MIN_OPEN_CLOSE
   176	    if high < low:
   177	        return REASON_HIGH_BELOW_LOW
   178	    return None
   179	
   180	

===== apex/ops/bootstrap_service.py:647-705 (baseline) =====
   647	    def _walk_backward(self, symbol: str, timeframe: str,
   648	                       end_ms: int) -> List[Any]:
   649	        """Collect the venue's full available history for one cell, ascending.
   650	
   651	        Walks ``endTime`` backward from ``end_ms``. Dedup-guarded: an empty
   652	        page or a page whose first row repeats the previous page's first row
   653	        ends the walk. Rate-limit errors retry with bounded exponential
   654	        backoff inside the walk; any other venue error fails closed.
   655	
   656	        CP-12: the walk ends at the append boundary below — every row that is
   657	        about to become part of the per-cell history passes the frozen OHLC
   658	        law, and a row that fails it is dropped with evidence (never served,
   659	        never stored, never silently skipped). Dropping never ends the walk:
   660	        the stop conditions stay the venue's own (empty page / no new row /
   661	        no backward progress), so a fully poisoned page cannot complete a cell.
   662	        """
   663	        collected: Dict[int, Any] = {}
   664	        # Every open time the venue has returned for this cell, valid or not:
   665	        # the walk's "no new row" stop is about the VENUE repeating itself, so
   666	        # a dropped row still counts as seen (and cannot stop the walk).
   667	        seen_ms: Set[int] = set()
   668	        key = (str(symbol), str(timeframe))
   669	        walk_end = int(end_ms)
   670	        prev_first_ms: Optional[int] = None
   671	        # startTime is ignored by the tail-aligned venue; pass DEEP_START so a
   672	        # head-aligned double (tests) still has a lawful lower bound.
   673	        floor = getattr(self, "_catch_up_floor", {}).get(key)
   674	        walk_start = int(DEEP_START_MS if floor is None else floor)
   675	
   676	        while walk_end >= walk_start:
   677	            page = self._get_klines_with_walk_backoff(
   678	                symbol, timeframe, walk_start, walk_end, PAGE_LIMIT)
   679	            self.walk_pages += 1
   680	            if not page:
   681	                break
   682	            first_ms = _iso_to_ms(page[0].timestamp)
   683	            # Dedup-stop: venue re-returned the same window (own first row).
   684	            if prev_first_ms is not None and first_ms == prev_first_ms:
   685	                break
   686	            prev_first_ms = first_ms
   687	            new_any = False
   688	            oldest_ms = first_ms
   689	            for obs in page:
   690	                open_ms = _iso_to_ms(obs.timestamp)
   691	                if open_ms < oldest_ms:
   692	                    oldest_ms = open_ms
   693	                if open_ms not in seen_ms:
   694	                    seen_ms.add(open_ms)
   695	                    new_any = True
   696	                # -- CP-12 hygiene gate: THE single boundary into the history --
   697	                reason = _ohlc_violation(obs)
   698	                if reason is not None:
   699	                    self._record_invalid_bar(key, open_ms, obs, reason)
   700	                    continue
   701	                if open_ms not in collected:
   702	                    collected[open_ms] = obs
   703	            if not new_any:
   704	                break
   705	            # Step endTime to just before the oldest bar of this page.

