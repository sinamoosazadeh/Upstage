===== apex/engines/e05_fvg/engine.py:274-324 (baseline) =====
   274	def detect_fvg_at(bars: Sequence[Dict[str, Any]], i: int,
   275	                  theta_min_w: float, min_abs_ticks: int, tick_size: float,
   276	                  atr_override: Optional[float] = None) -> Optional[Dict[str, Any]]:
   277	    """Three-candle detection at closed candle i (§3.1 Gates A–D).
   278	
   279	    Gate_A candle validity; Gate_B imbalance; Gate_C safety net;
   280	    Gate_D minimum width (θ_minW·ATR ∧ min_abs_ticks·tick_size).
   281	    atr_override is the E04-evidence/fixture pathway; production computes
   282	    the §4 PIT-safe fallback only when no ATR evidence is supplied.
   283	    """
   284	    if i < 2:
   285	        return None
   286	    b2, b1, b0 = bars[i - 2], bars[i - 1], bars[i]
   287	    # Gate_A — invalid candle
   288	    for b in (b2, b1, b0):
   289	        if b["h"] < b["l"] - EPS or not math.isfinite(b["h"]):
   290	            return {"invalid_reason": "INVALID_CANDLE"}
   291	    # Gate_B — imbalance
   292	    bullish_cond = b2["h"] < b0["l"]
   293	    bearish_cond = b2["l"] > b0["h"]
   294	    if not (bullish_cond or bearish_cond):
   295	        return None
   296	    atr_now = atr_override if atr_override is not None else atr_calc(
   297	        bars, 14, i)
   298	    if bullish_cond:
   299	        # ICT-correct zone [H_{t−2}, L_t] — the middle candle does NOT
   300	        # shrink the zone (§0/§2/§7 Ch.1-11; fixture-canonical).
   301	        lower = b2["h"]
   302	        upper = b0["l"]
   303	        direction = "UP"
   304	    else:
   305	        # Bearish ICT zone [H_t, L_{t−2}] (§2 table main implementation).
   306	        lower = b0["h"]
   307	        upper = b2["l"]
   308	        direction = "DOWN"
   309	    # Gate_C — numerical safety net (structurally guaranteed by Gate_B;
   310	    # the abandoned max/min formula is deliberately NOT used here).
   311	    if lower > upper + EPS:
   312	        return {"invalid_reason": "NEGATIVE_WIDTH", "lower": lower,
   313	                "upper": upper, "direction": direction}
   314	    width = upper - lower
   315	    # Gate_D — minimum width
   316	    min_w_atr = theta_min_w * atr_now
   317	    min_w_abs = min_abs_ticks * tick_size
   318	    if width < min_w_atr - EPS or width < min_w_abs - EPS:
   319	        return {"invalid_reason": "INSUFFICIENT_WIDTH", "width": width,
   320	                "thr_atr": min_w_atr}
   321	    return {
   322	        "direction": direction, "lower": lower, "upper": upper,
   323	        "width": width, "atr": atr_now, "at_idx": i,
   324	        "at_ts": b0.get("ts_close", b0.get("ts", 0)),

