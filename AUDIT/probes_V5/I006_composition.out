   411	        bars.append({"o": c - 0.4, "h": c + 0.3, "l": c - 0.6, "c": c,
   412	                     "v": 1200, "ts": (8 + j) * 3600000})
   413	    # 12: retest from above (shallow)
   414	    bars.append({"o": 107.0, "h": 100.5, "l": 98.9, "c": 100.2, "v": 1500,
   415	                 "ts": 12 * 3600000})
   416	    # 13: deep penetration → mitigated
   417	    bars.append({"o": 100.2, "h": 100.8, "l": 98.3, "c": 98.6, "v": 1400,
   418	                 "ts": 13 * 3600000})
   419	    # 14: close below zone_lo − 0.2·ATR → invalidated
   420	    bars.append({"o": 98.6, "h": 100.0, "l": 97.3, "c": 97.5, "v": 1300,
   421	                 "ts": 14 * 3600000})
   422	    # 15: reclaim through the far edge → breaker
   423	    bars.append({"o": 97.5, "h": 100.2, "l": 99.0, "c": 99.9, "v": 2500,
   424	                 "ts": 15 * 3600000})
   425	    # 16..21 flat inside breaker-safe band (no touch, no invalidation)
   426	    for j in range(6):
   427	        bars.append({"o": 99.3, "h": 99.5, "l": 99.2, "c": 99.4,
