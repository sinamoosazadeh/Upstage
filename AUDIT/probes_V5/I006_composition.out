   400	    # 5: bearish origin (BR 0.68)
   401	    bars.append({"o": 100.5, "h": 101.0, "l": 98.5, "c": 98.8, "v": 1500,
   402	                 "ts": 5 * 3600000})
   403	    # 6: displacement UP
   404	    bars.append({"o": 98.8, "h": 103.5, "l": 98.7, "c": 103.2, "v": 3000,
   405	                 "ts": 6 * 3600000})
   406	    # 7: continuation
   407	    bars.append({"o": 103.2, "h": 104.6, "l": 103.0, "c": 104.4, "v": 2000,
   408	                 "ts": 7 * 3600000})
   409	    # 8..11 drift up (no zone touch)
