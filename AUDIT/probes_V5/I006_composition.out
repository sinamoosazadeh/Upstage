   802	class E06OrderBlockEngine(EngineBase):
   803	    """E06_OrderBlock on the frozen EngineBase contract (v4.0.0).
   804	
   805	    compute(symbol, timeframe, as_of, context): window via
   806	    context['window'] or a sync WindowProvider. Consumed context keys
   807	    (versioned interfaces §1.4 — evidence ONLY, never recomputed):
   808	      structure_events — I_Structure_v4 [{kind, direction, level, ts,
   809	        valid_at_idx, strength?}] (E01; version <4.0 → structural_event
   810	        None + Q2 cap per §1.4 compatibility)
   811	      fvg_zones — I_FVG_v4 [{present, direction, lower, upper, type}]
   812	        keyed by origin idx via fvg_by_idx
   813	      volume_evidence — I_Volume_v4 per-bar [{volume_sma, volume_ratio,
   814	        snapshot_id, as_of_ts}] (E03)
   815	      volatility_evidence — I_Volatility_v4 per-bar [{atr_n, tr_method,
   816	        snapshot_id, as_of}] (E04)
   817	    Missing/misaligned evidence → QX fail-closed (no fallback, §1.4)."""
   818	
   819	    engine_id = "E06"
   820	    analyst_version = ANALYST_VERSION
   821	    code_revision = "0" * 40
   822	
   823	    def compute(self, symbol: str, timeframe: str, as_of: str,
   824	                context: Optional[Dict[str, Any]] = None
   825	                ) -> List[EvidenceEvent]:
   826	        context = context or {}
   827	        window_obs = self._resolve_window(symbol, timeframe, as_of, context)
   828	        if not window_obs:
   829	            return []
   830	        bars = [observation_to_bar(o) for o in window_obs]
   831	        params = get_params(context.get("e06_params"))
   832	        volume_evidence = context.get("volume_evidence")
   833	        volatility_evidence = context.get("volatility_evidence")
   834	        if volume_evidence is None or volatility_evidence is None:
   835	            raise ValueError("MISSING_EVIDENCE_QX: E06 requires I_Volume_v4 "
   836	                             "and I_Volatility_v4 evidence (§1.4)")
   837	        result = run_engine(
   838	            bars,
   839	            struct_events_by_idx=context.get("struct_events_by_idx"),
   840	            fvg_by_idx=context.get("fvg_by_idx"),
   841	            volume_evidence=volume_evidence,
   842	            volatility_evidence=volatility_evidence,
   843	            params=params)
   844	        quality = self._window_quality(window_obs)
   845	        return [self._to_evidence(ob, symbol, timeframe, quality)
   846	                for ob in result["obs"]]
   847	
   848	    def _resolve_window(self, symbol: str, timeframe: str, as_of: str,
   849	                        context: Dict[str, Any]) -> List[MarketObservation]:
   850	        window = context.get("window")

