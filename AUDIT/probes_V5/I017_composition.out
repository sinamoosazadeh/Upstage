    59	def apply_scenario(responder, scenario):
    60	    from fake_toobit_responder import FakeToobitResponder
    61	    assert isinstance(responder, FakeToobitResponder)
    62	    if "fill_mode" in scenario:
    63	        responder.set_fill_mode(scenario["fill_mode"],
    64	                                price=scenario.get("fill_price"))
    65	    if scenario.get("timeouts"):
    66	        responder.lose_next_ack(scenario["timeouts"],
    67	                                record=scenario.get("record_before_timeout",
    68	                                                   True))
    69	    if scenario.get("fail_with") is not None:
    70	        responder.fail_next(scenario["fail_with"], scenario.get("fail_times", 1))
    71	    for order in scenario.get("seed_orders", []):
    72	        responder.seed_order(**order)
    73	    if scenario.get("seed_position"):
    74	        responder.seed_position(**scenario["seed_position"])
    75
    76
    77	OPERATION_CALLS = {
    78	    "submit_order": lambda adapter, call: adapter.submit_order(**call),
    79	    "cancel_order": lambda adapter, call: adapter.cancel_order(**call),
    80	    "query_order_state": lambda adapter, call: adapter.query_order_state(**call),
    81	    "query_open_positions": lambda adapter, call:
    82	        adapter.query_open_positions(**call),
    83	    "query_account_margin_health": lambda adapter, call:
    84	        adapter.query_account_margin_health(**call),
    85	}
    86
