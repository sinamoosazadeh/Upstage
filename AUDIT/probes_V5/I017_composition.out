    40	def make_adapter(monkeypatch, responder, *, allow_signed=True, key=TEST_KEY,
    41	                 secret=TEST_SECRET, clock=None):
    42	    monkeypatch.setenv("APEX_ENV", "PAPER")
    43	    monkeypatch.setenv("APEX_ALLOW_SIGNED", "1" if allow_signed else "0")
    44	    if key:
    45	        monkeypatch.setenv("TOOBIT_API_KEY", key)
    46	    else:
    47	        monkeypatch.delenv("TOOBIT_API_KEY", raising=False)
    48	    if secret:
    49	        monkeypatch.setenv("TOOBIT_API_SECRET", secret)
    50	    else:
    51	        monkeypatch.delenv("TOOBIT_API_SECRET", raising=False)
    52	    from apex.config import Config
    53	    from fake_toobit_responder import FakeToobitResponder
    54	    assert isinstance(responder, FakeToobitResponder)
    55	    return A.ToobitAdapter(config=Config(), transport=responder, utc_now=UTC,
    56	                           clock=clock if clock is not None else (lambda: 1000.0))
