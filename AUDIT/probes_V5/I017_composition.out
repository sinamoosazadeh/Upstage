   364	        for call in responder.calls:
   365	            assert call.params.get("recvWindow") == str(M.RECV_WINDOW_MS)
   366	            assert call.headers[M.HEADER_API_KEY] == TEST_KEY
   367	            assert len(call.params["signature"]) == 64
