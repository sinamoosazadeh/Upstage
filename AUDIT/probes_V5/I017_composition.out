   341	                                          timeframe="1h", direction="LONG",
   342	                                          quantity="0.1", price="100"))
   343	        for blob in (json.dumps(result.to_dict(), default=str),
   344	                     str(adapter.audit_trail()), str(adapter.state)):
   345	            assert TEST_SECRET not in blob
   346	            assert TEST_KEY not in blob
   347	        closed = make_adapter(monkeypatch, responder, allow_signed=False)
   348	        with pytest.raises(A.AdapterError) as exc:
