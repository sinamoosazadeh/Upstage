    92	class TestConformanceFixture:
    93	    def test_fixture_is_hash_sealed(self):
    94	        """The golden file is tamper-evident: its ``cases`` array must hash to
    95	        the recorded SHA-256 (Ch.4/Ch.16 hash-chain law applied to fixtures)."""
    96	        payload = load_fixture()
    97	        digest = hashlib.sha256(
    98	            canonical_json(payload["cases"]).encode("utf-8")).hexdigest()
    99	        assert digest == payload["_meta"]["cases_sha256"]
   100	        assert payload["_meta"]["case_count"] == len(payload["cases"])
   101
   102	    def test_fixture_covers_every_operation(self):
   103	        operations = {c["operation"] for c in load_fixture()["cases"]}
   104	        assert operations == set(M.FIVE_OPERATIONS)
   105
   106	    @pytest.mark.parametrize("case", load_fixture()["cases"],
   107	                             ids=[c["id"] for c in load_fixture()["cases"]])
   108	    def test_case(self, case, monkeypatch):
   109	        from fake_toobit_responder import FakeToobitResponder
   110	        responder = FakeToobitResponder(api_key=TEST_KEY, api_secret=TEST_SECRET)
   111	        adapter = make_adapter(monkeypatch, responder)
   112	        apply_scenario(responder, case.get("scenario", {}))
   113	        calls = case.get("calls") or [case["call"]]
   114	        posts_before = len(responder.calls_to("/api/v1/futures/order", "POST"))
   115	        result = None
   116	        for call in calls:
   117	            result = run(OPERATION_CALLS[case["operation"]](adapter, call))
   118	        observed = result.to_dict()
   119	        for key, expected in case["expect"].items():
   120	            if key == "attempts":
   121	                assert len(result.attempts) == expected, case["id"]
   122	            elif key == "attempt_sources":
   123	                assert [a.result_source for a in result.attempts] == expected, \
   124	                    case["id"]
   125	            elif key == "unique_idempotency_keys":
   126	                keys = [a.idempotency_key for a in result.attempts]
   127	                assert expected is (len(set(keys)) == len(keys)), case["id"]
   128	            elif key == "interval_disabled":
   129	                assert dict(result.interval_disabled or {}) == expected, case["id"]
   130	            else:
   131	                assert observed[key] == expected, f"{case['id']}.{key}"
   132	        venue = case.get("expect_venue")
   133	        if venue:
   134	            if "posts_to_order_endpoint" in venue:
   135	                assert len(responder.calls_to("/api/v1/futures/order", "POST")) \
   136	                    - posts_before == venue["posts_to_order_endpoint"], case["id"]
   137	            if "signature_violations" in venue:
   138	                assert len(responder.signature_violations()) == \
   139	                    venue["signature_violations"], case["id"]
   140	            if "request_params" in venue:
   141	                sent = responder.calls_to("/api/v1/futures/order", "POST")[-1].params
   142	                for key, value in venue["request_params"].items():
   143	                    assert sent.get(key) == value, f"{case['id']}.{key}"
   144	            if "venue_recorded_client_order_id" in venue:
   145	                assert venue["venue_recorded_client_order_id"] in responder.orders
   146	            if "leverage_sent_for_BTCUSDT" in venue:
   147	                assert responder.leverage["BTC-SWAP-USDT"] == \
   148	                    venue["leverage_sent_for_BTCUSDT"], case["id"]
   149	        state = case.get("expect_state")
   150	        if state and "disabled_intervals" in state:
   151	            assert {k: list(v) for k, v in
   152	                    adapter.disabled_intervals().items()} == \
   153	                state["disabled_intervals"], case["id"]
