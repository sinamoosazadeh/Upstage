=== Baseline fake responder complete auth/transport implementation ===
     1	"""Fake Toobit responder — a TEST DOUBLE only (G9: mocks/fakes are lawful only
     2	behind test code; they never ship in ``apex/**``).
     3
     4	It implements the adapter's transport seam
     5	``Transport(method, url, query, headers) -> {"http_status": int, "body": dict}``
     6	and keeps a tiny in-memory venue state (orders, fills, positions, balances) so
     7	the CP-7 tests can exercise:
     8
     9	* ``T_ADAPTER_SUBMIT``   — a signed submit that the venue acknowledges;
    10	* ``T_ADAPTER_DUPLICATE``— the same ``clientOrderId`` twice;
    11	* ``T_ADAPTER_LOST_ACK`` — the venue RECORDS the order but the response is lost
    12	  (timeout) ⇒ UNKNOWN + reconcile-required + NO resubmit;
    13	* ``−1003`` backoff-and-retry, ``−1022`` abort, ``−1120`` interval unsupported,
    14	  and the unmapped ``−1021`` / ``−2026`` fail-closed paths;
    15	* the reconciliation queries (``positions``, ``openOrders``, ``userTrades``,
    16	  ``balance``) with an injectable divergence.
    17
    18	It also VERIFIES every signed request (HMAC-SHA256 over the query string,
    19	``X-BB-APIKEY`` header, ``recvWindow``) so a signing regression fails loudly.
    20	No network is ever touched.
    21	"""
    22
    23	from __future__ import annotations
    24
    25	import hashlib
    26	import hmac
    27	import json
    28	import re
    29	from dataclasses import dataclass, field
    30	from typing import Any, Callable, Dict, List, Optional, Sequence, Tuple
    31	from urllib.parse import parse_qsl, urlsplit
    32
    33	from apex.execution.toobit_adapter import AdapterTimeout
    34	from apex.execution.toobit_map import (BASE_URL, HEADER_API_KEY,
    35	                                       RECV_WINDOW_MS, sign_query)
    36
    37	TEST_API_KEY = "TEST_KEY_CP7"
    38	TEST_API_SECRET = "TEST_SECRET_CP7"
    39
    40
    41	@dataclass
    42	class RecordedCall:
    43	    seq: int
    44	    method: str
    45	    path: str
    46	    params: Dict[str, str]
    47	    headers: Dict[str, str]
    48	    signature_ok: bool
    49	    recv_window_ok: bool
    50	    api_key_present: bool
    51	    responded: bool
    52	    note: str = ""
    53
    54
    55	class FakeToobitResponder:
    56	    """Deterministic in-memory Toobit futures responder."""
    57
    58	    def __init__(self, *, api_key: str = TEST_API_KEY,
    59	                 api_secret: str = TEST_API_SECRET,
    60	                 server_time_ms: int = 1767225600000,
    61	                 balance: str = "10000.00000000",
    62	                 clock: Optional[Callable[[], int]] = None) -> None:
    63	        self.api_key = api_key
    64	        self.api_secret = api_secret
    65	        self.server_time_ms = int(server_time_ms)
    66	        self._clock = clock if clock is not None else (lambda: self.server_time_ms)
    67	        self.calls: List[RecordedCall] = []
    68	        self.orders: Dict[str, Dict[str, Any]] = {}     # by clientOrderId
    69	        self.orders_by_id: Dict[str, Dict[str, Any]] = {}
    70	        self.fills: List[Dict[str, Any]] = []
    71	        self.positions: Dict[str, Dict[str, Any]] = {}
    72	        self.balance = balance
    73	        self.margin_type: Dict[str, str] = {}
    74	        self.leverage: Dict[str, str] = {}
    75	        self.commission_rate: Dict[str, str] = {
    76	            "symbol": "BTCUSDT", "makerCommissionRate": "0.0002",
    77	            "takerCommissionRate": "0.0005"}
    78	        # scenario knobs
    79	        self.timeouts_remaining = 0          # lost-ack / transport fault
    80	        self.record_before_timeout = True    # lost ack ⇒ the order IS recorded
    81	        self.fail_with: Optional[int] = None  # business code to return
    82	        self.fail_times = 0
    83	        self.fill_mode: str = "none"          # none | immediate | partial
    84	        self.fill_price: Optional[str] = None
    85	        self.divergence: Optional[str] = None  # inject a reconcile divergence
    86	        self._seq = 0
    87	        self._order_seq = 0
    88	        self._fill_seq = 0
    89
    90	    # -- scenario helpers ---------------------------------------------------
    91	    def lose_next_ack(self, count: int = 1, *, record: bool = True) -> None:
    92	        self.timeouts_remaining = int(count)
    93	        self.record_before_timeout = bool(record)
    94
    95	    def fail_next(self, business_code: int, times: int = 1) -> None:
    96	        self.fail_with = int(business_code)
    97	        self.fail_times = int(times)
    98
    99	    def set_fill_mode(self, mode: str, *, price: Optional[str] = None) -> None:
   100	        if mode not in ("none", "immediate", "partial"):
   101	            raise ValueError(mode)
   102	        self.fill_mode = mode
   103	        self.fill_price = price
   104
   105	    def seed_order(self, *, intent_id: str, symbol: str, timeframe: str,
   106	                   direction: str, quantity: str, price: str) -> Dict[str, Any]:
   107	        """Place a working order directly in venue state (no adapter call)."""
   108	        from apex.execution.toobit_map import side_for, to_wire_symbol
   109	        return self._accept_order({
   110	            "clientOrderId": intent_id, "symbol": to_wire_symbol(symbol),
   111	            "side": side_for(direction, "entry"), "positionSide": "BOTH",
   112	            "type": "LIMIT", "timeInForce": "IOC", "price": price,
   113	            "quantity": quantity, "reduceOnly": "false"})
   114
   115	    def seed_position(self, symbol: str, side: str, quantity: str,
   116	                      entry_price: str = "100.0") -> None:
   117	        self.positions[symbol] = {"symbol": symbol, "positionSide": side.upper(),
   118	                                  "positionAmt": quantity,
   119	                                  "entryPrice": entry_price,
   120	                                  "unRealizedProfit": "0.00000000",
   121	                                  "leverage": self.leverage.get(symbol, "5")}
   122
   123	    # -- transport seam -----------------------------------------------------
   124	    async def __call__(self, method: str, url: str, query: str,
   125	                       headers: Dict[str, str]) -> Dict[str, Any]:
   126	        self._seq += 1
   127	        split = urlsplit(url)
   128	        path = split.path
   129	        if not url.startswith(BASE_URL):
   130	            return self._record_and_return(method, path, {}, headers, False,
   131	                                           {"http_status": 404,
   132	                                            "body": {"code": -1003,
   133	                                                     "msg": "unknown host"}})
   134	        params = dict(parse_qsl(query, keep_blank_values=True))
   135	        signature_ok = self._verify_signature(params, query)
   136	        recv_ok = params.get("recvWindow") in (None, str(RECV_WINDOW_MS))
   137	        api_key_present = bool(headers.get(HEADER_API_KEY))
   138	        call = RecordedCall(seq=self._seq, method=method.upper(), path=path,
   139	                            params=params, headers=dict(headers),
   140	                            signature_ok=signature_ok, recv_window_ok=recv_ok,
   141	                            api_key_present=api_key_present, responded=False)
   142	        self.calls.append(call)
   143	        self.server_time_ms = int(self._clock())
   144	        if self.timeouts_remaining > 0:
   145	            self.timeouts_remaining -= 1
   146	            if self.record_before_timeout and path == "/api/v1/futures/order" \
   147	                    and method.upper() == "POST":
   148	                # The venue accepted the order; only the RESPONSE was lost.
   149	                self._accept_order(params, note="ACK_LOST")
   150	            call.responded = False
   151	            call.note = "TIMEOUT_INJECTED"
   152	            raise AdapterTimeout(f"{method} {path}")
   153	        if self.fail_with is not None and self.fail_times > 0:
   154	            self.fail_times -= 1
   155	            code = self.fail_with
   156	            if self.fail_times == 0:
   157	                self.fail_with = None
   158	            call.responded = True
   159	            call.note = f"BUSINESS_CODE_{code}"
   160	            return {"http_status": 400 if code < 0 else 200,
   161	                    "body": {"code": code, "msg": f"injected {code}"}}
   162	        return self._route(call, method.upper(), path, params)
   163
   164	    def _record_and_return(self, method: str, path: str, params: Dict[str, str],
   165	                           headers: Dict[str, str], signature_ok: bool,
   166	                           response: Dict[str, Any]) -> Dict[str, Any]:
   167	        self.calls.append(RecordedCall(self._seq, method.upper(), path, params,
   168	                                       headers, signature_ok, True,
   169	                                       bool(headers.get(HEADER_API_KEY)), True))
   170	        return response
   171
   172	    def _verify_signature(self, params: Dict[str, str],
   173	                          raw_query: str = "") -> bool:
   174	        """Recompute the HMAC over the query EXACTLY as it was sent.
   175
   176	        A real venue signs the raw query string; re-encoding the parsed values
   177	        would silently change any percent-encoded character (a ``:`` in a
   178	        clientOrderId, for instance) and report a false signature violation.
   179	        """
   180	        signature = params.get("signature")
   181	        if signature is None:
   182	            return True            # public (unsigned) path
   183	        if raw_query:
   184	            parts = [p for p in raw_query.split("&")
   185	                     if p and not p.startswith("signature=")]
   186	            query = "&".join(parts)
   187	        else:
   188	            body = {k: v for k, v in params.items() if k != "signature"}
   189	            query = "&".join(f"{k}={v}" for k, v in body.items())
   190	        expected = sign_query(self.api_secret, query)
   191	        return hmac.compare_digest(expected, signature)
   192
   193	    # -- routes -------------------------------------------------------------
   194	    def _route(self, call: RecordedCall, method: str, path: str,
   195	               params: Dict[str, str]) -> Dict[str, Any]:
   196	        call.responded = True
   197	        if path == "/api/v1/time" and method == "GET":
   198	            return {"http_status": 200, "body": {"code": 0, "msg": "success",
   199	                                                 "data": {"serverTime":
   200	                                                          self.server_time_ms}}}
   201	        if path == "/api/v1/futures/order" and method == "POST":
   202	            order = self._accept_order(params)
   203	            return {"http_status": 200, "body": {"code": 0, "msg": "success",
   204	                                                 "data": order}}
   205	        if path == "/api/v1/futures/order" and method == "GET":
   206	            key = params.get("clientOrderId") or params.get("orderId")
   207	            order = (self.orders.get(key) or self.orders_by_id.get(key))
   208	            if order is None:
   209	                return {"http_status": 400,
   210	                        "body": {"code": -2013, "msg": "Order does not exist"}}
   373	    # -- assertions helpers -------------------------------------------------
   374	    def calls_to(self, path: str, method: Optional[str] = None
   375	                 ) -> List[RecordedCall]:
   376	        return [c for c in self.calls if c.path == path
   377	                and (method is None or c.method == method.upper())]
   378
   379	    def signature_violations(self) -> List[RecordedCall]:
   380	        return [c for c in self.calls if not c.signature_ok
   381	                or not c.recv_window_ok or not c.api_key_present]
   382
   383	    def open_order_count(self) -> int:
   384	        return len([o for o in self.orders.values()
   385	                    if o["status"] in ("NEW", "PARTIALLY_FILLED")])
   386
=== Baseline wire-map signing implementation ===
   510	# ---------------------------------------------------------------------------
   511	# Signing + idempotency (Ch.16 L16873, L16786–16798; AI.8 L18753)
   512	# ---------------------------------------------------------------------------
   513
   514	def sign_query(secret: str, query_string: str) -> str:
   515	    """HMAC-SHA256 over the query string (Ch.16 L16873). The secret never
   516	    leaves this function's scope and is never logged (G16/§9.5-13)."""
   517	    if not secret:
   518	        raise ToobitMapError("SIGNING_SECRET_MISSING",
   519	                             "TOOBIT_API_SECRET is empty (env only, §9.5-12)")
   520	    return hmac.new(secret.encode("utf-8"), query_string.encode("utf-8"),
   521	                    hashlib.sha256).hexdigest()
   522
   523
   524	def build_signed_query(params: Mapping[str, Any], *, timestamp_ms: int,
   525	                       recv_window: int = RECV_WINDOW_MS) -> str:
   526	    """Deterministic query string: the caller's parameters plus ``timestamp``
   527	    and ``recvWindow`` (5000), URL-encoded in insertion order."""
   528	    items: List[Tuple[str, Any]] = [(k, v) for k, v in params.items()]
   529	    items.append(("timestamp", int(timestamp_ms)))
   530	    items.append(("recvWindow", int(recv_window)))
   531	    return urlencode(items)
   532
   533
   534	def signed_request(method: str, path: str, params: Mapping[str, Any], *,
   535	                   api_key: str, api_secret: str,
   536	                   timestamp_ms: int) -> Dict[str, Any]:
   537	    """Build one signed request descriptor (no I/O here).
   538
   539	    Header ``X-BB-APIKEY``; ``recvWindow`` 5000; HMAC-SHA256 over the query
   540	    string, appended as ``signature`` (Ch.16 L16873). The descriptor never
   541	    contains the secret (G16: secrets never in exception strings or logs).
   542	    """
   543	    assert_path_permitted(method, path)
   544	    query = build_signed_query(params, timestamp_ms=timestamp_ms)
   545	    signature = sign_query(api_secret, query)
   546	    return {
   547	        "method": method.upper(),
   548	        "url": f"{BASE_URL}{path}",
   549	        "query": f"{query}&signature={signature}",
   550	        "headers": {HEADER_API_KEY: api_key, "Content-Type":
   551	                    "application/x-www-form-urlencoded"},
   552	        "signature": signature,
   553	        "recv_window_ms": RECV_WINDOW_MS,
   554	        "auth_scheme": AUTH_SCHEME,
   555	    }
=== Baseline SUT signed gate and transport path ===
   316	class ToobitAdapter:
   317	    """Exactly five operations; no silent retries; duplicate/lost-ack
   318	    semantics per AI.3/AI.8; adapter-owned state immutable to callers."""
   319
   320	    OPERATIONS: Tuple[str, ...] = FIVE_OPERATIONS
   321
   322	    def __init__(self, *, config: Optional[Config] = None,
   323	                 transport: Optional[Transport] = None,
   324	                 session: Any = None,
   325	                 clock: Optional[Callable[[], float]] = None,
   326	                 utc_now: Optional[Callable[[], str]] = None,
   327	                 actor: str = "EXECUTION_ADAPTER") -> None:
   328	        object.__setattr__(self, "_initialized", False)
   329	        self._config = config if config is not None else Config()
   330	        self._clock = clock if clock is not None else time.time
   331	        self._utc_now = utc_now if utc_now is not None else system_utc_ms
   332	        self._actor = actor
   333	        if transport is not None:
   334	            self._transport: Transport = transport
   335	        else:
   336	            self._transport = aiohttp_transport(session)
   337	        self._buckets: Dict[str, _TokenBucket] = {}
   338	        self._audit: List[AttemptRecord] = []
   339	        self._duplicates: Dict[str, AdapterResult] = {}
   340	        self._disabled: Dict[str, List[str]] = {}
   341	        object.__setattr__(self, "_initialized", True)
   342
   343	    # -- state protection ---------------------------------------------------
   344	    def __setattr__(self, name: str, value: Any) -> None:
   345	        if getattr(self, "_initialized", False) and name in _STATE_ATTRS:
   346	            raise AdapterStateMutationError(
   347	                "ADAPTER_STATE_IMMUTABLE",
   348	                f"{name} is adapter-owned state — callers may read it through "
   349	                "the frozen views, never mutate it (Ch.16 L16846: the execution "
   350	                "state machine is the only path to Toobit)")
   351	        object.__setattr__(self, name, value)
   352
   353	    @property
   354	    def state(self) -> AdapterState:
   355	        return AdapterState(
   356	            buckets={k: b.snapshot() for k, b in self._buckets.items()},
   357	            disabled_intervals={k: tuple(v) for k, v in self._disabled.items()},
   358	            known_client_order_ids=tuple(self._duplicates),
   359	            audit_entries=len(self._audit),
   360	            signed_allowed=bool(self._config.allow_signed),
   361	            environment=self._config.apex_env,
   362	        )
   363
   364	    def audit_trail(self) -> Tuple[AttemptRecord, ...]:
   365	        """Immutable audit trail (AI.8 L18806–18810)."""
   366	        return tuple(self._audit)
   367
   368	    def disabled_intervals(self) -> Mapping[str, Tuple[str, ...]]:
   369	        return MappingProxyType({k: tuple(v) for k, v in self._disabled.items()})
   370
   371	    def is_interval_disabled(self, symbol: str, timeframe: str) -> bool:
   372	        """Ch.16 L16877: −1120 disables that TF for that symbol ONLY."""
   373	        return timeframe in tuple(self._disabled.get(symbol, ()))
   374
   375	    def rate_bucket_state(self, endpoint: str) -> TokenBucketState:
   376	        return self._bucket(endpoint).snapshot()
   377
   378	    # -- rate limiting ------------------------------------------------------
   379	    def _bucket(self, endpoint: str) -> _TokenBucket:
   380	        if endpoint not in self._buckets:
   381	            self._buckets[endpoint] = _TokenBucket(
   382	                endpoint, TOOBIT_BUCKET_CAPACITY,
   383	                TOOBIT_BUCKET_REFILL_PER_SECOND, self._clock)
   384	        return self._buckets[endpoint]
   385
   386	    # -- signed gating ------------------------------------------------------
   387	    def _credentials(self) -> Tuple[str, str]:
   388	        key = self._config.toobit_api_key
   389	        secret = self._config.toobit_api_secret
   390	        if not self._config.allow_signed:
   391	            raise AdapterError(
   392	                "SIGNED_NOT_ALLOWED",
   393	                "APEX_ALLOW_SIGNED=0 — signed endpoints are refused fail-closed "
   394	                "(§9.5-12); never silently downgraded")
   395	        if not key or not secret:
   396	            raise AdapterError(
   397	                "TOOBIT_CREDENTIALS_MISSING",
   398	                "TOOBIT_API_KEY / TOOBIT_API_SECRET are env-only (§9.5-12/13)")
   399	        return key, secret
   400
