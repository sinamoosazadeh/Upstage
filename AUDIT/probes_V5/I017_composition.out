   313	class TestSignedGating:
   314	    def test_allow_signed_off_refuses_every_signed_call(self, monkeypatch):
   315	        from fake_toobit_responder import FakeToobitResponder
   316	        responder = FakeToobitResponder(api_key=TEST_KEY, api_secret=TEST_SECRET)
   317	        adapter = make_adapter(monkeypatch, responder, allow_signed=False)
   318	        with pytest.raises(A.AdapterError) as exc:
   319	            run(adapter.submit_order(intent_id="i-1", symbol="BTCUSDT",
   320	                                     timeframe="1h", direction="LONG",
   321	                                     quantity="0.1", price="100"))
   322	        assert exc.value.reason == "SIGNED_NOT_ALLOWED"
   323	        assert responder.calls == []          # nothing left the process
