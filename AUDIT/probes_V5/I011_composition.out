   347	class TestCP4EmissionsInsertIntoStore:
   348	    def _events(self):
   349	        bars = lcg_window(30)
   350	        window = obs_window(bars)
   351	        evs = []
   352	        evs += E07RTMEngine().compute(
   353	            "BTCUSDT", "1h", AS_OF,
   354	            {"window": window, "events": po3_confirmations(),
   355	             "direction": "UP"})
   356	        evs += E08WyckoffEngine().compute(
   357	            "BTCUSDT", "1h", AS_OF,
   358	            {"window": window, "atr_by_idx": {i: ATR for i in range(len(bars))},
   359	             "vol_ratio_by_idx": {i: 1.0 for i in range(len(bars))},
   360	             "evr_by_idx": {i: 0.5 for i in range(len(bars))}})
   361	        evs += E09TrendEngine().compute(
   362	            "BTCUSDT", "1h", AS_OF, {"window": window, "atr": ATR})
   363	        return evs
   364
   365	    def test_all_three_engines_insert(self):
   366	        evs = self._events()
   367	        assert {ev.engine_id for ev in evs} == {"E07", "E08", "E09"}
   368	        for ev in evs:
   369	            ev.validate_24_fields()
   370
   371	        async def scenario():
   372	            store = SQLiteStore(path=":memory:")
   373	            await store.open()
   374	            try:
   375	                for ev in evs[:40]:
   376	                    await store.insert_evidence(ev)
   377	                cur = await store.db.execute(
   378	                    "SELECT COUNT(*) FROM evidence_event")
   379	                count = (await cur.fetchone())[0]
   380	                cur = await store.db.execute(
   381	                    "SELECT DISTINCT engine_id FROM evidence_event "
   382	                    "ORDER BY engine_id")
   383	                return count, [r[0] for r in await cur.fetchall()]
   384	            finally:
   385	                await store.close()
   386
   387	        count, engines = asyncio.run(scenario())
   388	        assert count == min(40, len(evs))
   389	        assert set(engines) <= {"E07", "E08", "E09"} and engines

