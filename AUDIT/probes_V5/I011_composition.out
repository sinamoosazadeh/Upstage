===== apex/ops/engine_context.py:1557-1710 (baseline) =====
  1557	def complete_engine_bundle(item: Mapping[str, Any], symbol: str, timeframe: str,
  1558	                           artifact: Mapping[str, Any], *, rtm_context: Mapping[str, Any]) -> dict:
  1559	    """Native twelve-engine assembly from the shared PIT feature timeline.
  1560
  1561	    No fixture defaults, replacement indicator or incomplete EvidenceEvent.
  1562	    Native warmup is represented by missing optional evidence, not invented
  1563	    volume/ATR scalars. E06 starts at the actual joint dependency frontier.
  1564	    """
  1565	    from dataclasses import asdict
  1566	    artifact = validate_classifier(artifact)
  1567	    derive_quality = rtm_context.get("derive_avg_quality") is True
  1568	    for key in ("avg_quality", "mtf_align"):
  1569	        if key == "avg_quality" and derive_quality:
  1570	            continue
  1571	        value = rtm_context.get(key)
  1572	        if not isinstance(value, (int, float)) or isinstance(value, bool) or not math.isfinite(value) or not 0 <= value <= 1:
  1573	            raise BridgeError("E07_CONTEXT_UNAVAILABLE", key)
  1574	    if "vector" not in item:
  1575	        raise BridgeError("E11_CONTEXT_UNAVAILABLE", str(item.get("reason", "missing vector")))
  1576	    original = item["frame"]
  1577	    prior_atr = [state.atr14_wilder for state in original["volatility"]["states"][:-1]]
  1578	    frame = upstream_frame(original["raw_window"], symbol, timeframe, emit=True,
  1579	        atr14_history=prior_atr, structure_result=original["structure"],
  1580	        volatility_stream=item["volatility_stream"], temporal_profile=item.get("temporal_profile"))
  1581	    # The timeline's IC/history is authoritative, including the full prior
  1582	    # ATR reference; emission preparation must not replace it with a slice.
  1583	    frame["ic"] = dict(item["ic"])
  1584	    events, order = frame["events"], frame["engine_order"]
  1585	    window, end = frame["window"], item["as_of"]
  1586	    atr_by_idx = {i: value for i, value in enumerate(frame["atr14"]) if value is not None}
  1587	    by_time = {_iso_to_ms(obs.timestamp): i for i, obs in enumerate(window)}
  1588	    struct = {}
  1589	    for event in frame["structural_events"]:
  1590	        i = event["candle_index"]
  1591	        direction = "UP" if "BULLISH" in event["event_type"] else "DOWN"
  1592	        struct.setdefault(i, []).append({"idx": i, "dir": direction, "direction": direction,
  1593	            "kind": "BOS" if event["event_type"].startswith(("EV_STR_007", "EV_STR_008")) else "CHoCH",
  1594	            "valid_at_idx": i, "confirmed_at_idx": i, "source": event})
  1595	    order.append("E05")
  1596	    fvg = E05.run_engine([E05.observation_to_bar(o) for o in window], symbol=symbol,
  1597	        tick_size=E01.resolve_tick_size(symbol), atr_by_idx=atr_by_idx, bos_by_idx=struct)
  1598	    fvg_emitter = E05.E05FVGEngine()
  1599	    objects = sorted(fvg["active"] + fvg["history"], key=lambda obj: obj.created_at_idx)
  1600	    events.extend(fvg_emitter._to_evidence(obj, symbol, timeframe, fvg_emitter._window_quality(window)) for obj in objects)
  1601	    fvg_by_idx = {}
  1602	    for obj in objects:
  1603	        fvg_by_idx.setdefault(obj.created_at_idx, []).append(asdict(obj))
  1604	    volume_by_idx = {}
  1605	    for evidence in frame["volume"].emitted:
  1606	        source_index = evidence.pit_meta["history_len"]
  1607	        source_time = frame["volume"].history_bars[source_index]["ts"]
  1608	        volume_by_idx[by_time[source_time]] = dict(vars(evidence))
  1609	    volatility_by_idx = {by_time[state.as_of]: {"atr_n": state.atr14_wilder,
  1610	        "tr_method": "WILDER", "as_of": state.as_of, "snapshot_id": state.snapshot_id}
  1611	        for state in frame["volatility"]["states"] if state.as_of in by_time}
  1612	    order.append("E06")
  1613	    joint = sorted(set(volume_by_idx) & set(volatility_by_idx))
  1614	    if not joint or joint != list(range(joint[0], len(window))):
