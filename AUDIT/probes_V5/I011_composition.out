   695	async def _serve(cfg: Config, *, as_json: bool, cycles: Optional[int] = None,
   696	                 interval: float = 60.0, report_every: int = 1) -> int:
   697	    if cfg.apex_env == "LIVE" and not cfg.economic_gate_signed:
   698	        code = "LIVE_CAPITAL_LOCKED"
   699	        _say(f"REFUSED: {code} — APEX_ENV=LIVE is not a capital switch; LIVE "
   700	             "capital stays locked until APEX_ECONOMIC_GATE_SIGNED=1 (Y.1 "
   701	             "L17093) and the owner's written approval. Run PAPER first.")
   702	        return EXIT_DEGRADED
   703	    if not cfg.allow_signed:
   704	        _say("REFUSED: SIGNED_NOT_ALLOWED — PAPER orders require "
   705	             "APEX_ALLOW_SIGNED=1 (Y.1 L17093). Re-run exactly:")
   706	        _say("  APEX_ENV=PAPER APEX_ALLOW_SIGNED=1 TOOBIT_API_KEY=... "
   707	             "TOOBIT_API_SECRET=... TELEGRAM_BOT_TOKEN=... "
   708	             "TELEGRAM_OWNER_CHAT_ID=... python scripts/run_apex.py serve")
   709	        return EXIT_DEGRADED
   710
   711	    runtime = await Runtime(cfg).start()
   712	    service = BS.BootstrapService(config=cfg, store=runtime.store)  # one raw writer
   713	    await service.open()
   714	    gateway = None
   715	    try:
   716	        ledger, bus = runtime.ledger, runtime.bus
   717	        clock = C.SystemClock()
   718	        adapter = runtime.adapter()
