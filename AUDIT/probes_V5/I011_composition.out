   193	        om_a = build_order_map(exp, conf)
   194	        evaluate_order_ok(exp, order, om_a)      # same pipeline as bundle_from
   195	        integrity, coverage, _missing = sequence_integrity_v4(exp, order, om_a)
   196	        assert a.integrity == pytest.approx(integrity)
   197	        assert b.integrity == pytest.approx(integrity)
   198	        assert a.weight_coverage == pytest.approx(coverage)
   199	        # Only the provenance differs between the two branches.
   200	        assert a.degraded is True and b.degraded is False
   201	        assert a.temporal_authority != b.temporal_authority
   202	        assert b.temporal_authority == E12_CONTRACT
