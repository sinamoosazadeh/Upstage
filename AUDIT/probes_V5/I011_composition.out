   720	        signaling = (SG.SignalingPlane(config=cfg, ledger=ledger, bus=bus,
   721	                                       owner_chat_id=cfg.telegram_owner_chat_id
   722	                                       or None)
   723	                     if cfg.telegram_bot_token else None)
   724	        control = CP.ControlPlane(
   725	            signaling=signaling, config=cfg, clock=clock.monotonic,
   726	            utc_now=clock.utc_now, bus=bus, environment=cfg.apex_env,
   727	            paper_balance=(await EC.paper_balance(ledger)
   728	                           if cfg.apex_env == "PAPER" else "0"))
   729	        control.register("BOOTSTRAP_CONTROL", _bootstrap_handler(service))
   730	        for name in ("EMERGENCY_PAUSE", "EMERGENCY_DISABLE_NEW",
   731	                     "EMERGENCY_CANCEL_ALL", "EMERGENCY_CLOSE_ALL",
   732	                     "EMERGENCY_SAFE_MODE", "EXPORT", "BACKTEST_RUN"):
   733	            control.register(name, _noop_handler(name))
   734	        if cfg.telegram_bot_token:
   735	            gateway = GW.TelegramGateway(
   736	                control=control, source=GW.AiogramUpdateSource(config=cfg),
   737	                notifier=_telegram_reply(signaling),
   738	                bootstrap=service, clock=clock.monotonic,
   739	                utc_now=clock.utc_now, poll_timeout=5.0)
   740	        watchdog = WD.Watchdog(telegram_plane=signaling,
   741	                               recovery_log=WD.RecoveryLog(path=cfg.sqlite_path),
   742	                               now=time.time)
   743	        # CP-9 bridge: the provider is registered at the composition root, so
   744	        # every PAPER cell now asks the governed store/context → pattern/setup
   745	        # → gates → forecast → risk/decision chain for a real plan.  Missing
   746	        # persisted engine context remains a named fail-closed refusal; the
   747	        # provider never falls back to a hand-built plan.
   748	        producer = (EC.EngineContextProducer(runtime.store, ledger=ledger,
   749	                    environment="PAPER") if cfg.apex_env == "PAPER" else None)
   750	        plan_bridge = PB.PaperPlanBridge(
   751	            store=runtime.store, environment=cfg.apex_env,
   752	            context_source=producer.get_bridge_context if producer is not None else None,
   753	            context_preparer=producer.prepare if producer is not None else None)
   754	        async def catch_up(now_ms: int) -> Dict[str, Any]:
   755	            result = await service.catch_up(now_ms)
   756	            if cfg.apex_env == "PAPER":
   757	                control.paper_balance = CP.comma_format(await EC.paper_balance(ledger))
   758	            return result
   759
   760	        driver = PL.PaperRuntime(
   761	            config=cfg, store=runtime.store, ledger=ledger, bus=bus,
   762	            adapter=adapter, signaling=signaling, control=control,
   763	            gateway=gateway, watchdog=watchdog, clock=clock,
   764	            environment=cfg.apex_env, notifier=notifier,
   765	            plan_provider=plan_bridge, catch_up=catch_up)
   766	        _say("APEX_GEN5 — 24/7 runtime (reconcile-first boot → the 140-cell "
   767	             "scheduler → the SL-5 → SL-6 trade_plan queue → execution FSM)")
   768	        drift = await C.measure_drift(
   769	            _venue_server_time if adapter is not None else _no_venue_time, clock)
   770	        boot = await driver.boot(drift_seconds=drift.get("drift_seconds"))
   771	        try:
   772	            EC.load_classifier()
   773	            artifact_name = "E11_ARTIFACT"
   774	        except EC.BridgeError as exc:
   775	            artifact_name = exc.reason
   776	        _say(f"  boot_state={boot['boot_state']} "
   777	             f"new_trades_allowed={boot['new_trades_allowed']} "
   778	             f"drift={drift['state']} ({drift.get('reason') or 'measured'}) "
   779	             f"artifact={artifact_name}")
   780	        if driver.plan_provider is None:
   781	            _say("  plan seam: NO PLANS WIRED — every cell halts with the named "
   782	                 "refusal NO_PLAN_PROVIDER")
   783	        else:
   784	            _say("  plan seam: WIRED — governed PAPER store bridge "
   785	                 "(missing context refuses by name; no synthetic plan)")
   786	        _say(f"  signal_source={driver.signal_source} · cells=140 · "
   787	             f"max_trades_per_cycle={driver.max_trades_per_cycle} · "
   788	             f"telegram={'WIRED' if gateway is not None else 'DISABLED (no token)'}")
   789	        _say("  (Ctrl-C stops the loop; the ledger chain and the durable "
   790	             "cursors stay consistent)")
   791	        outcome = await driver.run(cycles=cycles, interval=interval)
   792	        for cycle in driver.cycles[-3:]:
   793	            _say(f"  cycle {cycle['cycle']}: cells={cycle['cells_due']} "
   794	                 f"complete={cycle['cells_complete']} "
   795	                 f"halted={cycle['cells_halted']} blocked={cycle['cells_blocked']} "
   796	                 f"trades={len(cycle['trades'])} open={len(cycle['open_intents'])}")
   797	            if cycle.get("halt_reasons"):
   798	                _say(f"    named refusals: "
   799	                     f"{json.dumps(cycle['halt_reasons'], sort_keys=True)}")
   800	        _say(f"  cycles={outcome['cycles']} trades={outcome['trades']} "
   801	             f"open={outcome['open_intents']} refusals={outcome['refusals']} "
   802	             f"ledger_chain_intact={outcome['ledger_chain_intact']}")
   803	        if as_json:
   804	            _say(json.dumps({"boot": boot, "outcome": outcome,
   805	                             "cycles": driver.cycles}, default=str, indent=2,
   806	                            sort_keys=True))
   807	        return EXIT_READY if boot["boot_state"] == "READY" else EXIT_DEGRADED
   808	    finally:
   809	        if gateway is not None:
   810	            await gateway.aclose()
   811	        await service.close()
   812	        await runtime.stop()
   813

