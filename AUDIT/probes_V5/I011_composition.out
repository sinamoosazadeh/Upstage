   171	    def test_degradation_caps_the_quality_class_at_q4(self):
   172	        """§3.7's Q5 gate needs the overlap flag; at CP-4 (E12 absent, a
   173	        non-overlap timestamp) the cascade is capped and Q5 is unreachable."""
   174	        conf = po3_confirmations(t0=1768485600000 + 9 * 3600000)   # 09:00Z
   175	        degraded_bundle = bundle_from(conf)
   176	        assert degraded_bundle is not None
   177	        assert degraded_bundle.resolution_class == "Q4"
   178	        # Same evidence, authoritative overlap window ⇒ Q5 is reachable.
   179	        overlap = bundle_from(conf, temporal_provider=StubE12(is_overlap=True))
   180	        assert overlap.resolution_class == "Q5"
   181	        assert Q_CLASSES.index(overlap.resolution_class) == \
   182	            Q_CLASSES.index("Q5")
