   195	    def test_both_modes_agree_on_registry_and_sequence_math(self):
   196	        """The degradation changes provenance and the Q gate, never the §3.5
   197	        window arithmetic (E07's local duplicate mirrors the E12 registry)
   198	        nor the §3.1 sequence integrity."""
   199	        prov = E12TemporalProvider()
   200	        for iso in ("2026-01-15T06:59:59Z", "2026-01-15T07:00:00Z",
   201	                    "2026-01-15T12:29:59Z", "2026-01-15T12:30:00Z",
   202	                    "2026-01-15T15:59:59Z", "2026-01-15T16:00:00Z",
   203	                    "2026-01-15T20:59:59Z", "2026-01-15T21:00:00Z"):
   204	            t = int(datetime.datetime.fromisoformat(
   205	                iso.replace("Z", "+00:00")).timestamp() * 1000)
   206	            a = utc_activity_window_check(t, temporal_provider=prov)
   207	            b = utc_activity_window_check(t)
   208	            assert a["degraded"] is False and b["degraded"] is True
   209	            assert a["is_overlap"] == b["is_overlap"]
   210	            assert a["utc_activity_window"] == b["utc_activity_window"]
   211	            assert set(a["which"]) == set(b["which"])
   212	        conf = po3_confirmations()
   213	        x = bundle_from(conf)
   214	        y = bundle_from(conf, temporal_provider=prov)
   215	        exp = expected_components("RTM.PO3.v1")
   216	        om = build_order_map(exp, conf)
   217	        order = [c["cid"] for c in conf]
   218	        evaluate_order_ok(exp, order, om)      # same pipeline as bundle_from
   219	        integrity, coverage, _ = sequence_integrity_v4(exp, order, om)
   220	        assert x.integrity == pytest.approx(integrity)
   221	        assert y.integrity == pytest.approx(integrity)
   222	        assert x.weight_coverage == pytest.approx(coverage)
   223	        assert x.degraded is True and y.degraded is False
