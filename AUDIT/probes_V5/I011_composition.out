  2283	    async def prepare_engine_bundle(self, symbol: str, timeframe: str, as_of: str,
  2284	                                    *, rtm_context: Mapping[str, Any] | None = None) -> dict:
  2285	        """Compute and persist a complete native bundle before plan admission.
  2286
  2287	        Final bridge/risk projection is separate; this method never presents
  2288	        an engine-only bundle as all REQUIRED_CONTEXT_KEYS/REQUIRED_RISK_KEYS.
  2289	        """
  2290	        from dataclasses import replace
  2291	        artifact = load_classifier(self.classifier_path)
  2292	        measured = mtf = None
  2293	        if rtm_context is None:
  2294	            measured = await self.quality_window(symbol, timeframe, as_of)
  2295	            mtf = await self.mtf_inputs(symbol, timeframe, as_of)
  2296	            rtm_context = {"derive_avg_quality": True, "mtf_align": mtf["mtf_align"]}
  2297	        rows = await (await self.store.db.execute(
  2298	            "SELECT COUNT(*) FROM market_observation WHERE symbol=? AND timeframe=? "
  2299	            "AND candle_status IN ('CLOSED','CORRECTED') AND open_time<=?",
  2300	            (symbol, timeframe, as_of))).fetchone()
  2301	        window = await self.window(symbol, timeframe, as_of, int(rows[0]))
  2302	        if not window:
  2303	            raise BridgeError("NO_MARKET_DATA", f"{symbol}:{timeframe}")
  2304	        last = None
  2305	        async for item in self.feature_timeline(symbol, timeframe, window, incremental=True):
  2306	            last = item
  2307	        if last is None or "vector" not in last:
  2308	            raise BridgeError("E11_CONTEXT_UNAVAILABLE", str((last or {}).get("reason", "empty timeline")))
  2309	        if measured is not None:
  2310	            expected = [(o.timestamp, o.content_hash()) for o in last["frame"]["raw_window"]]
  2311	            actual = [(o.timestamp, o.content_hash()) for o in measured["window"]]
  2312	            if actual != expected:
  2313	                raise BridgeError("QUALITY_PROVENANCE_UNAVAILABLE", "engine/quality window mismatch")
  2314	            last["frame"]["raw_window"] = measured["window"]
  2315	            history_candles = [E12.observation_to_candle(o) for o in closed_engine_window(window[:-1],timeframe)]
  2316	            last["temporal_profile"] = E12.compute_temporal_profile(
  2317	                E12.returns_by_tod_from_candles(history_candles),as_of=int(history_candles[-1]["ts"]))
  2318	        bundle = complete_engine_bundle(last, symbol, timeframe, artifact, rtm_context=rtm_context)
  2319	        bundle["volatility_history"] = [e.state for e in last["volatility_stream"]["evidence"]]
  2320	        if measured is not None:
  2321	            bundle["measured_quality"] = measured
  2322	            bundle["measured_mtf"] = {k: v for k, v in mtf.items() if k != "frames"}
  2323	        lineage = tuple(self._raw_lineage[(symbol, timeframe, obs.timestamp, obs.content_hash())]["observation_id"]
  2324	                        for obs in bundle["raw_window"])
  2325	        available = max([_iso_to_ms(bundle["window"][-1].timestamp)] + [_iso_to_ms(obs.availability_time) for obs in bundle["raw_window"]])
  2326	        events = [replace(event, lineage=tuple(dict.fromkeys((*event.lineage, *lineage))),
  2327	                          availability_time=_ms_to_iso(max(_iso_to_ms(event.availability_time), available)))
  2328	                  for event in bundle["events"]]
  2329	        bundle["events"] = await persist_complete_evidence(self.store, events)
  2330	        bundle["raw_observation_ids"] = lineage
  2331	        bundle["classifier_artifact_sha256"] = artifact["artifact_sha256"]
  2332	        self.diagnostics[f"{symbol}:{timeframe}"] = {"status": "ENGINE_BUNDLE_PREPARED",
  2333	            "engine_order": list(bundle["engine_order"]), "evidence_count": len(events),
  2334	            "as_of": last["as_of"], "classifier_artifact_sha256": artifact["artifact_sha256"]}
  2335	        return bundle

