   430	# --------------------------------------------------------------------------
   431
   432	VETO_FIELD_NAMES: Tuple[str, ...] = tuple(
   433	    veto_definition(n)["name"] for n in range(1, 15))
   434
   435	#: W.5 — fields no package may ever carry (owner-static, X.7).
   436	FORBIDDEN_FIELDS: Tuple[str, ...] = (
   437	    "veto_registry", "veto_thresholds", "veto_count",
   438	    "margin_warning", "margin_action", "margin_liquidation_approach",
   439	    "capital_hard_cap", "symbol_exposure_cap", "portfolio_exposure_cap",
   440	    "circuit_breaker", "circuit_breakers",
   441	    "leverage_cap_by_tf", "system_leverage_cap_by_tf", "max_leverage",
   442	    "max_loss_per_trade", "max_loss_per_day", "daily_loss_limit",
   443	    "weekly_loss_limit", "risk_ladder_multiplier", "crisis_factor",
   444	) + VETO_FIELD_NAMES
