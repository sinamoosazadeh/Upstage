    54
    55	VETO_REGISTRY: Tuple[Tuple[int, str, str, Optional[str]], ...] = (
    56	    (1, "VETO_INVALID_QUARANTINED_INPUT", "Q_raw < Q_min(tf), QX state, "
    57	        "failed setup gate", "QX_INVALID"),
    58	    (2, "VETO_PIT_VIOLATION", "availability_time > as_of", "E-PIT-001"),
    59	    (3, "VETO_CAPITAL_LIMIT", "portfolio_exposure + proposed > capital_hard_cap",
    60	     None),
    61	    (4, "VETO_CIRCUIT_BREAKER", "circuit_breaker_engaged; ratchet permits "
    62	        "upgrades only", "RSK-ERR-506"),
    63	    (5, "VETO_EXPOSURE_LIMIT", "per_symbol_exposure > symbol_cap or "
    64	        "portfolio_exposure > portfolio_cap", None),
    65	    (6, "VETO_HARD_CONFLICT", "conflict_state == HARD_CONFLICT (SL-2)", None),
    66	    (7, "VETO_FRESHNESS_SLA", "staleness beyond the freshness SLA",
    67	     "VETO_FRESHNESS_SLA"),
    68	    (8, "VETO_OI_LAG", "oi_lag > threshold(tf)", "VETO_OI_LAG"),
    69	    (9, "VETO_ANTI_MONOTONICITY", "request.is_risk_increase AND "
    70	        "uncertainty_is_rising", None),
    71	    # NOTE (ISSUE-CP6-004): the blueprint's registry column shows
    72	    # "CIRCUIT_OPEN (Alert Policy)" for vetoes 10–12. That identifier is an
    73	    # Alert-Policy label, not one of the frozen Ch.7 error codes, so it is not
    74	    # registered as an error code here (the Ch.7 registry owns that namespace —
    75	    # G6: codes are never invented).
    76	    (10, "VETO_DAILY_LOSS_LIMIT", "realized day loss (marked-to-market, ledger) "
    77	         "> governed threshold", None),
    78	    (11, "VETO_WEEKLY_LOSS_LIMIT", "realized week loss (marked-to-market, "
    79	         "ledger) > governed threshold", None),
    80	    (12, "VETO_CONSECUTIVE_LOSSES", "consecutive losing trades > governed "
    81	         "threshold", None),
    82	    (13, "VETO_CONTRACT_EXPIRY", "time-to-expiry of a quarterly contract < "
    83	         "governed rollover threshold", None),
    84	    (14, "VETO_MARGIN_HEALTH", "margin health below governed action threshold",
    85	     None),
    86	)
    87	VETO_NAMES: Tuple[str, ...] = tuple(v[1] for v in VETO_REGISTRY)
    88	VETO_COUNT = 14
