    94	DEFAULT_MARGIN_HEALTH_ACTION = 0.40
    95	DEFAULT_MARGIN_HEALTH_LIQUIDATION = 0.20
    96	DEFAULT_CVAR_CAP_FRACTION = 0.04
    97
    98	RISK_LADDER_STATES: Tuple[str, ...] = ("NoRisk", "LowRisk", "MediumRisk",
    99	                                      "HighRisk", "CriticalRisk")
   100	RISK_LADDER_MULTIPLIER: Dict[str, float] = {
   101	    "NoRisk": 1.0, "LowRisk": 1.0, "MediumRisk": 0.75, "HighRisk": 0.50,
   102	    "CriticalRisk": 0.0}
   103	# budget-state bands matching ladder_state_for exactly (D59 د۵).
   104	# (name, low, high, low_inclusive, high_inclusive). NoRisk is the 0.00 point.
   105	# LowRisk is the open interval (0.00, 0.25). Upper edges belong to the next band.
   106	RISK_LADDER_BANDS: Tuple[Tuple[str, float, float, bool, bool], ...] = (
   107	    ("NoRisk", 0.00, 0.00, True, True),
   108	    ("LowRisk", 0.00, 0.25, False, False),
   109	    ("MediumRisk", 0.25, 0.50, True, False),
   110	    ("HighRisk", 0.50, 0.75, True, False),
   160	        super().__init__(f"{reason}{('::' + detail) if detail else ''}")
   161	        self.reason = reason
   162	        self.detail = detail
