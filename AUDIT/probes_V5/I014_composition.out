=== Baseline promotion draft/refusal caller ===
   495
   496	@dataclass
   497	class PromotionCandidate:
   498	    """Everything the gate must see; a missing block fails the gate closed."""
   499
   500	    family_id: str
   501	    pool: FamilyPool
   502	    wfo: Mapping[str, Any]
   503	    pbo: Mapping[str, Any]
   504	    deflated_sharpe: Mapping[str, Any]
   505	    benchmark: Optional[Mapping[str, Any]] = None
   506	    breakeven: float = DEFAULT_BREAKEVEN
   507
   508	    def gates(self) -> Dict[str, Any]:
   509	        pool_gate = family_pool_gate(self.pool, p_breakeven=self.breakeven)
   510	        checks = {
   511	            "family_pool": pool_gate["eligible"],
   512	            "wfo": self.wfo.get("decision") == "PROMOTED",
   513	            "pbo": not self.pbo.get("flagged_high", True),
   514	            "deflated_sharpe": bool(self.deflated_sharpe.get("passes", False)),
   515	            "benchmark": bool(self.benchmark is not None
   516	                              and self.benchmark.get("outperforms", False)),
   517	        }
   518	        return {"family_id": self.family_id, "checks": checks,
   519	                "pool_gate": pool_gate,
   520	                "decision": "PROMOTE" if all(checks.values()) else "BLOCK",
   521	                "failed": [k for k, v in checks.items() if not v],
   522	                "contract_version": CONTRACT_VERSION}
   523
   524
   525	def evaluate_promotion(candidate: PromotionCandidate) -> Dict[str, Any]:
   526	    """W.5 validation gate → promotion decision (the pre-paper-trial stop)."""
   527	    verdict = candidate.gates()
   528	    verdict["paper_trial_required"] = verdict["decision"] == "PROMOTE"
   529	    verdict["note"] = ("pre-promotion gates (Z.9) + family-pool protocol "
   530	                       "(Z.3/Z.4) must ALL pass; the package still needs the "
   531	                       "RED LINE validation and the owner's approval (W.5)")
   532	    return verdict
   533
   534
   535	def draft_package(*, candidate: PromotionCandidate, values: Mapping[str, Any],
   536	                  version: str, code_revision: str, feature_version: str,
   537	                  model_version: str, seed: int, reason: str,
   538	                  proposals: Mapping[str, Mapping[str, Any]]
   539	                  ) -> Dict[str, Any]:
   540	    """Turn a TRULY promoted candidate into a parameter package.
   541
   542	    The package is refused unless the promotion gate passed, the RED LINE
   543	    validation is clean and every changed value carries its complete change
   544	    proposal (§17.1). Nothing here writes a file: injection is
   545	    ``apex.research.governance.InjectionLedger`` into
   546	    ``apex/research/params_suggestions/``.
   547	    """
   548	    verdict = evaluate_promotion(candidate)
   549	    if verdict["decision"] != "PROMOTE":
   550	        return {"decision": "REFUSED", "reason": "PROMOTION_GATE_BLOCKED",
   551	                "failed": verdict["failed"]}
   552	    package = ParameterPackage(
   553	        package_id=f"pkg-{candidate.family_id}-{version}",
   554	        version=version, values=dict(values), code_revision=code_revision,
   555	        feature_version=feature_version, model_version=model_version,
   556	        seed=int(seed), reason=reason, environment="RESEARCH")
   557	    validation = validate_package(package, proposals=proposals)
   558	    if validation["decision"] != "VALIDATED":
   559	        return {"decision": "REFUSED", "reason": "PACKAGE_VALIDATION_FAILED",
   560	                "validation": validation}
   561	    return {"decision": "DRAFTED", "package": package,
   562	            "validation": validation,
   563	            "next_step": "paper trial → owner approval → versioned injection"}
