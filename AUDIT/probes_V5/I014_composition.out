   423	    # -- suggestion output (never a live parameter file) ------------------
   424	    def write_suggestion(self, *, run_id: str, cell_id: str,
   425	                         optimizer: str, params: Mapping[str, Any],
   426	                         reason: str, package: Optional[ParameterPackage] = None
   427	                         ) -> Dict[str, Any]:
   428	        """Persist one suggestion. The write target is validated against the
   429	        RED LINE before anything touches the disk (W.5 / G6)."""
   430	        target_dir = self.suggestions_dir / run_id
   431	        guard = ParameterPackage(
   432	            package_id="suggestion-guard", version="0.0.0", values={},
   433	            code_revision="0" * 40, feature_version="v4.0.0",
   434	            model_version="v4.0.0", seed=0)
   435	        assert_live_params_untouched(guard, target_dir,
   436	                                     research_root=self.suggestions_dir)
   437	        target_dir.mkdir(parents=True, exist_ok=True)
   438	        payload: Dict[str, Any] = {
   439	            "run_id": run_id, "cell_id": cell_id, "optimizer": optimizer,
   440	            "params": dict(params), "reason": reason,
   441	            "note": "SUGGESTION ONLY — never a live parameter value; "
   442	                    "promotion requires W.5 validation + owner approval",
   443	            "contract_version": CONTRACT_VERSION,
   444	        }
   445	        if package is not None:
   446	            validation = validate_package(package)
   447	            payload["package"] = package.to_dict()
   448	            payload["validation"] = validation
   449	        path = target_dir / f"{cell_id}-{optimizer.lower()}.json"
   450	        assert_live_params_untouched(guard, path,
   451	                                     research_root=self.suggestions_dir)
   452	        path.write_text(json.dumps(payload, sort_keys=True, indent=2),
   453	                        encoding="utf-8")
   454	        try:
   455	            written = str(path.relative_to(REPO_ROOT))
   456	        except ValueError:                      # relocated research sandbox
   457	            written = str(path)
   458	        return {"written": written,
   459	                "suggestion_hash": sha256_hex(canonical_json(payload))}
