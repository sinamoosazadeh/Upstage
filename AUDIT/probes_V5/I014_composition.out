   165	def frozen_risk_params() -> Dict[str, Any]:
   166	    """The FROZEN_BOOTSTRAP risk literals, read from the params YAML (never
   167	    hardcoded here, §9.5-10)."""
   168	    r = load_params()["risk_defaults"]
   169	    return {k: r[k] for k in ("budget_per_trade", "k_attn", "daily_loss_cap",
   170	                             "weekly_loss_cap", "consecutive_loss_halt",
   171	                             "margin_mode", "position_mode", "cost_R_floor",
   172	                             "max_candidates", "correlation_cap",
   173	                             "system_leverage_cap_by_tf")}
