=== Baseline governance proposal validator and RED LINE ===
   302	PROPOSAL_REQUIRED_ITEMS: Tuple[str, ...] = (
   303	    "reason", "pit_backtest_180d", "forward_observation_30d",
   304	    "out_of_sample_evaluation", "parameter_board_approval")
   305
   306
   307	def validate_change_proposal(proposal: Mapping[str, Any]) -> Dict[str, Any]:
   308	    """The five mandatory items of a change proposal, checked item by item.
   309
   310	    A missing/empty item fails the proposal closed: it may not be promoted and
   311	    its dependents keep the current value.
   312	    """
   313	    missing: List[str] = []
   314	    for item in PROPOSAL_REQUIRED_ITEMS:
   315	        value = proposal.get(item)
   316	        if value is None or value == "" or value == {} or value == []:
   317	            missing.append(item)
   318	    if "pit_backtest_180d" in proposal and proposal.get("pit_backtest_180d"):
   319	        window = proposal["pit_backtest_180d"]
   320	        if isinstance(window, (int, float)) and float(window) < 180.0:
   321	            missing.append("pit_backtest_180d<180d")
   322	    if "forward_observation_30d" in proposal and \
   323	            proposal.get("forward_observation_30d"):
   324	        window = proposal["forward_observation_30d"]
   325	        if isinstance(window, (int, float)) and float(window) < 30.0:
   326	            missing.append("forward_observation_30d<30d")
   327	    decision = "APPROVED" if not missing else "REJECTED"
   328	    return {"decision": decision, "missing": missing,
   329	            "required": list(PROPOSAL_REQUIRED_ITEMS),
   330	            "conservative_value_kept": bool(missing)}
   331
