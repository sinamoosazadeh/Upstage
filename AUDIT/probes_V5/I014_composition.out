   127	class TestChangeProposal:
   128	    def test_complete_proposal_is_approved(self):
   129	        verdict = gov.validate_change_proposal(_complete_proposal())
   130	        assert verdict["decision"] == "APPROVED"
   131	        assert verdict["missing"] == []
   132
   133	    @pytest.mark.parametrize("missing", gov.PROPOSAL_REQUIRED_ITEMS)
   134	    def test_every_item_is_mandatory(self, missing):
   135	        proposal = _complete_proposal()
   136	        proposal.pop(missing)
   137	        verdict = gov.validate_change_proposal(proposal)
   138	        assert verdict["decision"] == "REJECTED"
   139	        assert missing in verdict["missing"]
   140	        assert verdict["conservative_value_kept"] is True
   141
   142	    def test_short_backtest_window_is_rejected(self):
   143	        proposal = _complete_proposal()
   144	        proposal["pit_backtest_180d"] = 179
   145	        assert "pit_backtest_180d<180d" in gov.validate_change_proposal(
   146	            proposal)["missing"]
   147
   148	    def test_short_forward_observation_is_rejected(self):
   149	        proposal = _complete_proposal()
   150	        proposal["forward_observation_30d"] = 29
   151	        assert "forward_observation_30d<30d" in gov.validate_change_proposal(
   152	            proposal)["missing"]
