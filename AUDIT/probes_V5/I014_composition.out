   446	_VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?$")
   447
   448
   449	@dataclass
   450	class ParameterPackage:
   451	    """A versioned, immutable candidate parameter package (SL-12)."""
   452
   453	    package_id: str
   454	    version: str
   455	    values: Mapping[str, Any]
   456	    code_revision: str           # git40 (§18.1 CodeRevision)
   457	    feature_version: str
   458	    model_version: str
   459	    seed: int
   460	    created_at: str = ""
   461	    reason: str = ""
   462	    environment: str = "RESEARCH"
   463
   464	    def __post_init__(self) -> None:
   465	        if not _VERSION_RE.match(self.version):
   466	            raise GovernanceError("VERSION_FORMAT_QX", self.version)
   467	        if len(self.code_revision) != 40 or not re.match(r"^[0-9a-f]{40}$",
   468	                                                        self.code_revision):
   469	            raise GovernanceError("CODE_REVISION_QX", self.code_revision)
   470	        if self.environment not in ("RESEARCH", "BACKTEST", "PAPER"):
   471	            raise GovernanceError("PACKAGE_ENVIRONMENT_QX", self.environment)
   472	        if not self.created_at:
   473	            self.created_at = datetime.now(timezone.utc).strftime(
   474	                "%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
   475
   476	    def content_hash(self) -> str:
   477	        return sha256_hex(canonical_json({
   478	            "package_id": self.package_id, "version": self.version,
   479	            "values": dict(self.values), "code_revision": self.code_revision,
   480	            "feature_version": self.feature_version,
   481	            "model_version": self.model_version, "seed": int(self.seed)}))
   482
   483	    def to_dict(self) -> Dict[str, Any]:
   484	        return {"package_id": self.package_id, "version": self.version,
   485	                "values": dict(self.values), "code_revision": self.code_revision,
   486	                "feature_version": self.feature_version,
   487	                "model_version": self.model_version, "seed": int(self.seed),
   488	                "created_at": self.created_at, "reason": self.reason,
   489	                "environment": self.environment,
   490	                "content_hash": self.content_hash(),
   491	                "contract_version": CONTRACT_VERSION}
   492
   493
   494	def validate_package(package: ParameterPackage, *,
   495	                     proposals: Optional[Mapping[str, Mapping[str, Any]]] = None
   496	                     ) -> Dict[str, Any]:
   497	    """W.5 RED LINE + §17.1 bounds + EC/closure check, before paper trial."""
   498	    violations: List[Dict[str, Any]] = []
   499	    for key, value in package.values.items():
   500	        if key in FORBIDDEN_FIELDS:
   501	            violations.append({"kind": "RED_LINE_FIELD", "field": key,
   502	                               "value": value,
   503	                               "rule": "W.5 — vetoes / margin thresholds / "
   504	                                       "capital caps / circuit breakers / "
   505	                                       "owner ceilings are immutable"})
   506	            continue
   507	        if key in _PARAM_BY_NAME:
   508	            row = _PARAM_BY_NAME[key]
   509	            if row.low is None or row.high is None:
   510	                continue
   511	            if not (row.low <= float(value) <= row.high):
   512	                violations.append({"kind": "OUT_OF_BOUNDS", "field": key,
   513	                                   "value": value,
   514	                                   "bounds": [row.low, row.high]})
   515	            if row.param_class == "static/owner":
   516	                violations.append({"kind": "OWNER_STATIC_FIELD", "field": key,
   517	                                   "rule": "static/owner — owner-only change"})
   518	    if proposals is not None:
   519	        for name in package.values:
   520	            proposal = proposals.get(name)
   521	            if proposal is None:
   522	                violations.append({"kind": "PROPOSAL_ABSENT", "field": name})
   523	                continue
   524	            verdict = validate_change_proposal(proposal)
   525	            if verdict["decision"] != "APPROVED":
   526	                violations.append({"kind": "PROPOSAL_INCOMPLETE",
   527	                                   "field": name, "missing": verdict["missing"]})
   528	    return {"package_id": package.package_id, "decision":
   529	            "REJECTED" if violations else "VALIDATED",
   530	            "violations": violations, "values_checked": len(package.values),
   531	            "red_line_clean": not any(v["kind"] in (
   532	                "RED_LINE_FIELD", "OWNER_STATIC_FIELD") for v in violations)}
   533
   534
   535	def assert_live_params_untouched(package: ParameterPackage, target: Path,
   536	                                 *, research_root: Optional[Path] = None) -> None:
   537	    """The write target must live under ``apex/research/params_suggestions/``.
   538
   539	    Any attempt to write a live ``params/*.yaml`` raises
   540	    :class:`ResearchRedLineError` — the Wave-Out item "optimizer writing live
   541	    yaml" made executable (G6). ``research_root`` only relocates the *allowed*
   542	    research directory (tests, alternate sandboxes); the live-params refusal is
   543	    absolute and can never be relocated.
   544	    """
   545	    resolved = Path(target).resolve()
   546	    allowed = Path(research_root).resolve() if research_root is not None \
   547	        else SUGGESTIONS_DIR.resolve()
   548	    live = LIVE_PARAMS_DIR.resolve()
   549	    if live == resolved or live in resolved.parents:
   550	        raise ResearchRedLineError(
   551	            "LIVE_PARAMS_WRITE_FORBIDDEN",
   552	            f"{resolved} is inside {live} — research may never write live "
   553	            f"parameters (W.5 RED LINE / G6)")
   554	    if allowed != resolved and allowed not in resolved.parents:
   555	        raise ResearchRedLineError(
   556	            "SUGGESTION_TARGET_OUTSIDE_RESEARCH",
   557	            f"{resolved} is outside {allowed}")
   558
