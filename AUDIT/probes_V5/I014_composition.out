   176	def veto_definition(number: int) -> Dict[str, Any]:
   177	    for n, name, carrier, code in VETO_REGISTRY:
   178	        if n == number:
   179	            return {"number": n, "name": name, "carrier": carrier,
   180	                    "error_code": code,
   181	                    "registry": None if code is None
   182	                    else str(get_error_code(code))}
   183	    raise RiskError("VETO_NUMBER_QX", f"{number} (exactly {VETO_COUNT} exist)")
