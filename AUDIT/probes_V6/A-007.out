null first key + more      | 'a:\\nb: 2'      -> "ValueError: params YAML line 2: trailing content 'b: 2'"
null mid key               | 'a: 1\\nb:\\nc: 3' -> {'a': 1, 'b': None, 'c': 3}
null last key (control)    | 'a: 1\\nb:'      -> {'a': 1, 'b': None}
single null key            | 'a:'             -> {'a': None}
nested null then value     | 'outer:\\n  a:\\n  b: 2' -> "ValueError: params YAML line 3: bad indentation '  b: 2'"

real YAML semantics expect: a: None, b: 2 for case 1

