quoted URL item        | 'endpoints:\\n  - "https://example.invalid"' -> {'endpoints': [{'"https': '//example.invalid"'}]}
plain URL item         | 'endpoints:\\n  - https://example.invalid' -> {'endpoints': [{'https': '//example.invalid'}]}
quoted item, no :      | 'endpoints:\\n  - "plain"'               -> {'endpoints': ['plain']}
quoted host:port       | 'endpoints:\\n  - "example.com:8443"'    -> {'endpoints': [{'"example.com': '8443"'}]}
inline k:v quoted      | 'endpoints:\\n  - "GET /path"'           -> {'endpoints': ['GET /path']}

