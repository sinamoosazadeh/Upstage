single-quote escape            | "x: 'it''s'"           -> {'x': "it''s"}
double-quote \n                | 'x: "a\\nb"'           -> {'x': 'a\\nb'}
double-quote backslash         | 'x: "a\\\\b"'          -> {'x': 'a\\\\b'}
double-quote escaped quote     | 'x: "a\\"b"'           -> {'x': 'a\\"b'}
single-quote plain             | "x: 'abc'"             -> {'x': 'abc'}

real YAML semantics: 'it''s' -> "it's" ; "a\nb" -> 'a<newline>b' ; "a\\b" -> 'a\b' ; "a\"b" -> 'a"b'

== escapes in real params files? ==
