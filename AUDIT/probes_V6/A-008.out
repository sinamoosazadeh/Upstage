flow map w/ nested seq     | 'x: {a: [1, 2], b: 3}'     -> "ValueError: flow map entry without ':' ' 2]'"
flow seq of seqs           | 'x: [[1, 2], [3, 4]]'      -> {'x': ['[1', '2]', '[3', '4]']}
flow seq w/ nested map     | 'x: [{a: 1}, {b: 2}]'      -> {'x': ['{a: 1}', '{b: 2}']}
flat flow map (control)    | 'x: {a: 1, b: 3}'          -> {'x': {'a': 1, 'b': 3}}
flat flow seq (control)    | 'x: [1, 2, 3, 4]'          -> {'x': [1, 2, 3, 4]}
unterminated flow map      | 'x: {a: 1'                 -> "ValueError: unterminated flow map: '{a: 1'"
unterminated flow seq      | 'x: [1, 2'                 -> "ValueError: unterminated flow sequence: '[1, 2'"

== nesting usage in real params files (flow value containing '[' or '{' inside)? ==
