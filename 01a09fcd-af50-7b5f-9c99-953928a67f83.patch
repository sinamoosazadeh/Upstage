++    async def _report(self, cycle: Mapping[str, Any]) -> None:
++        text = (f"cycle {cycle['cycle']}: cells={cycle['cells_due']} "
++                f"complete={cycle['cells_complete']} "
++                f"halted={cycle['cells_halted']} "
