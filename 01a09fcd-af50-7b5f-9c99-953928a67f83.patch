++class UpdateSource:
++    """The transport seam: ``get_updates(offset, timeout) -> [update, ...]``."""
++
++    async def get_updates(self, *, offset: Optional[int] = None,
++                          timeout: float = 25.0, limit: int = 100
++                          ) -> List[Mapping[str, Any]]:   # pragma: no cover
