++                               "executedQty": "0.1",
++                               "tradeId": f"t-{client_order_id}"}})
++        return adapter_result(operation="query_order_state", outcome="FILLED",
++                              data={"data": []})
++
++    async def query_open_positions(self, *, symbol: Optional[str] = None,
