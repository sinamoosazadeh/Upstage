+# --------------------------------------------------------------------------
+
+class TestGrids:
+    def test_full_cartesian_product(self):
+        assert _grid().size == 5 * 3
+        assert len(_grid().enumerate()) == 15
+
+    def test_step_count_is_inclusive(self):
