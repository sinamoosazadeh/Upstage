+async def shutdown(harn: "Harness") -> None:
+    """One deterministic teardown: bus → ledger → store (writer task first)."""
+    await harn.bus.stop()
+    if not harn.ledger.closed:
+        await harn.ledger.stop()
+    await harn.store.close()
