+        file_part, _, key = row.yaml_ref.partition("#")
+        name = file_part.split("/")[1].replace("_v1.yaml", "").replace("_v4.yaml", "")
+        data = params.get(name) or {}
+        if key in data:
+            flat[row.name] = data[key]
+    return flat
